{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".nvmrc",
    ".pnpmfile.cjs",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build:lib",
        "build:lib"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        ".react-email/.next/**",
        "!.react-email/.next/cache/**"
      ]
    },
    "build:lib": {
      "dependsOn": [
        "^build:lib"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "type-check": {
      "dependsOn": [
        "^build:lib"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build:lib"
      ]
    },
    "test": {
      "dependsOn": [
        "^build:lib"
      ],
      "passThroughEnv": [
        "VITEST_MAX_WORKERS"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
