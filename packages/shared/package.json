{
  "name": "@wondermoney/shared",
  "version": "9.0.0",
  "private": true,
  "license": "MIT",
  "author": "The WonderMoney contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/wondermoney/shared.git"
  },
  "bugs": {
    "url": "https://github.com/wondermoney/shared/issues"
  },
  "homepage": "https://github.com/wondermoney/shared#readme",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./decimal": "./lib/decimal/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "build:lib": "tsup index.ts --format cjs,esm && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "big.js": "^7.0.1",
    "csv-parse": "^7.0.3",
    "eodhd": "^1.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/big.js": "^7.0.0",
    "@types/node": "^26.6.6",
    "@vitest/ui": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
