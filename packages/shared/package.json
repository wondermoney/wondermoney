{
  "name": "@wondermoney/shared",
  "version": "9.0.0",
  "private": true,
  "license": "MIT",
  "author": "The WonderMoney contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/wondermoney/shared.git"
  },
  "bugs": {
    "url": "https://github.com/wondermoney/shared/issues"
  },
  "homepage": "https://github.com/wondermoney/shared#readme",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "build:lib": "tsup index.ts --format cjs,esm && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "big.js": "^6.2.1",
    "csv-parse": "^7.0.3",
    "eodhd": "^1.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/big.js": "^6.2.2",
    "@types/node": "^26.6.6",
    "@vitest/ui": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^2.8.3",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
