{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "react", "react-dom"],
    "noEmit": true
  },
  "include": ["emails/**/*.tsx", "emails/**/*.ts", "scripts/**/*.ts", "src/**/*.tsx", "src/**/*.ts"]
}
