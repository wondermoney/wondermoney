# WonderMoney self-hosting configuration. ./generate-env.sh copies this to .env and fills in
# every secret marked GENERATED. Restart with `docker compose up -d` after editing.

# ─── Required ──────────────────────────────────────────────────────────────────
# Where people reach the web app and the API. Behind HTTPS, use your real addresses, e.g.
# https://money.example.com and https://api.money.example.com (see README.md).
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

POSTGRES_PASSWORD=GENERATED
BETTER_AUTH_SECRET=GENERATED
# Encrypts each user's bank (Enable Banking) credentials. Never change it once in use.
CREDENTIAL_ENCRYPTION_KEY_V1=GENERATED
EMAIL_OPT_OUT_SIGNING_SECRET=GENERATED
ADMIN_API_KEY=GENERATED
INTERNAL_SERVICE_API_KEY=GENERATED

# ─── Your instance ─────────────────────────────────────────────────────────────
INSTANCE_NAME=WonderMoney
# open: anyone can sign up · invite: only people invited to a household · closed: nobody.
# The first account on a new instance can always sign up.
SIGNUP_MODE=open
# Team inbox for the contact form and account alerts. Leave empty to turn those off.
SUPPORT_EMAIL=
# Optional legal pages, shown on the sign-up page when both are set.
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
# Linked from email footers; {lang} becomes en/pt. Defaults to the app's privacy settings.
PRIVACY_POLICY_URL=
# When the app and API are on subdomains of one domain (money.example.com and
# api.money.example.com), set both to that domain with a leading dot: .example.com
AUTH_COOKIE_DOMAIN=
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# ─── Email (optional) ──────────────────────────────────────────────────────────
# Without a provider, emails (password resets, invites) are written to the API log:
#   docker compose logs api | grep "Email not sent"
EMAIL_FROM=
EMAIL_FROM_NAME=WonderMoney
# SMTP. With `--profile mail`, use SMTP_HOST=mailpit, SMTP_PORT=1025 to read mail in Mailpit.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Or Resend:
RESEND_API_KEY=

# ─── File storage (optional) ───────────────────────────────────────────────────
# Needed for CSV imports and keeping receipt copies. With `--profile storage` (MinIO):
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY become MinIO's root user (choose them),
#   S3_ENDPOINT=http://minio:9000, S3_PUBLIC_ENDPOINT=http://localhost:9000 (what browsers
#   reach), S3_BUCKET=wondermoney. Any S3-compatible service (R2, B2, AWS) works too.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_BUCKET=
S3_REGION=

# ─── AI (optional) ─────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint: OpenAI, OpenRouter, Ollama (http://host.docker.internal:11434/v1),
# LM Studio, vLLM. Powers receipt scanning, CSV column mapping, transaction categorisation,
# the monthly story and the assistant. Each AI_MODEL_<FEATURE> overrides AI_MODEL; receipt
# scanning needs a vision model.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MODEL_OCR=
AI_MODEL_ASSISTANT=

# ─── Market data (optional) ────────────────────────────────────────────────────
# EODHD key for ticker search, live prices and the Financial Markets module.
EODHD_API_KEY=

# ─── Contact form captcha (optional) ───────────────────────────────────────────
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ─── Image version ─────────────────────────────────────────────────────────────
WM_VERSION=latest
