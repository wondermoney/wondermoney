# WonderMoney self-hosting configuration. ./generate-env.sh copies this to .env and fills in
# every secret marked GENERATED. Restart with `docker compose up -d` after editing.

# ─── Required ──────────────────────────────────────────────────────────────────
# Where people reach the web app and the API. One hostname is enough: set both to the same
# address and add `proxy` to COMPOSE_PROFILES below, and the bundled proxy serves the web app
# and the API there (README.md, "HTTPS"). Without it, the local defaults below are two ports.
# Passkeys belong to APP_URL's hostname, so it needs HTTPS (or localhost) and a hostname, not
# an IP address. Moving the web app to another hostname means users add their passkeys again.
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
# Empty publishes the ports (web, API, and the optional storage and Mailpit) on every network
# interface. Behind a reverse proxy on this machine, set 127.0.0.1 so the plain-HTTP ports are
# reachable only through the proxy (README.md).
BIND_ADDRESS=
# Optional services to run with every `docker compose` command: proxy, storage, mail, backup,
# backup-offsite, or a combination (proxy,storage,backup). See "HTTPS" and "Back up" in README.md
# and the email, file storage and backup sections below.
COMPOSE_PROFILES=
# How many proxies sit in front of the API, so it can tell visitors apart for its sign-in limits:
# empty when browsers reach the API port directly (anything else lets them fake their address),
# 1 behind one reverse proxy (the bundled proxy profile, Caddy, nginx, Traefik, a Cloudflare
# Tunnel), 2 with Cloudflare's proxy in front of yours. Or a comma-separated list of the proxies'
# addresses or CIDR ranges.
TRUST_PROXY=

POSTGRES_PASSWORD=GENERATED
BETTER_AUTH_SECRET=GENERATED
# Encrypts each user's bank credentials (Enable Banking keys, SimpleFIN access). Never change it
# once in use.
CREDENTIAL_ENCRYPTION_KEY_V1=GENERATED
EMAIL_OPT_OUT_SIGNING_SECRET=GENERATED
ADMIN_API_KEY=GENERATED
INTERNAL_SERVICE_API_KEY=GENERATED

# ─── Your instance ─────────────────────────────────────────────────────────────
# Shown in the web app (tab titles, sign-in and sign-up pages, in place of the logo), in every
# email's subject, copy, sign-off and sender name, and as the label in authenticator apps.
# The web app reads it from the API.
INSTANCE_NAME=WonderMoney
# open: anyone can sign up · invite: only people invited to a household · closed: nobody.
# The first account on a new instance can always sign up.
SIGNUP_MODE=open
# The most people in one household, owner included; a pending invite holds a seat. Empty means 6.
HOUSEHOLD_MAX_MEMBERS=
# Team inbox for the contact form, account alerts and in-app feedback, also shown in the app as
# the support address. Leave empty to turn those off and hide the support links. In-app
# feedback also needs email (SMTP or Resend) configured; without it the feedback form is hidden.
SUPPORT_EMAIL=
# Optional page where your users can chip in towards running the instance; the web app's FAQ
# links to it.
SPONSOR_URL=
# true: a public read-only demo. The sign-in page gets a "Try the demo" button that signs anyone
# in, without a password, to one shared demo account for two hours; every change is refused.
# Create the account first:
#   docker compose exec api node dist/database/scripts/seed-demo-household.js
# Off (empty) by default. The docs' "Public demo" section lists the settings a demo
# instance should use.
DEMO_SIGN_IN_ENABLED=
# Optional legal pages, shown on the sign-up page when both are set.
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
# Linked from email footers; {lang} becomes en, pt or es, e.g. https://example.com/{lang}/privacy.
# Defaults to the app's privacy settings.
PRIVACY_POLICY_URL=
# Only for two hostnames (money.example.com and api.money.example.com): set both to that domain
# with a leading dot, .example.com, so the web app can read the session cookie the API sets.
# Leave both empty when the web app and the API share one hostname: the cookie belongs to that
# hostname and needs no domain.
AUTH_COOKIE_DOMAIN=
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
# How far apart the two halves of a transfer between accounts in different currencies may be once
# the amount that left is converted at that day's exchange rate, as a fraction of the amount that
# arrived. Empty means 0.02 (2 percent); at most 0.25.
TRANSFER_MATCH_FX_TOLERANCE=

# ─── Google sign-in (optional) ─────────────────────────────────────────────────
# An OAuth client from Google Cloud, with <API_URL>/api/auth/callback/google as its authorised
# redirect URI. With both set, the login and sign-up pages offer "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Single sign-on (optional) ─────────────────────────────────────────────────
# Your own OpenID Connect provider (Authentik, Keycloak, Authelia, Zitadel, ...). Register
# <API_URL>/api/auth/callback/oidc as the client's redirect URI. The issuer, client id and secret
# turn it on together; any other OIDC_ variable without them stops the API from starting.
# Guide: https://docs.wonder.money/en/docs/self-hosting/single-sign-on
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# The button reads "Sign in with <name>". Empty means SSO.
OIDC_DISPLAY_NAME=
# Space-separated, must include openid. Empty means: openid email profile
OIDC_SCOPES=
# The claim that lists the person's groups. Empty means groups.
OIDC_GROUPS_CLAIM=
# Comma-separated. When set, only members of these groups (or of the admin groups) may sign in.
OIDC_ALLOWED_GROUPS=
# Comma-separated. Members are instance admins, granted and revoked at every sign-in.
OIDC_ADMIN_GROUPS=
# true: create accounts on first sign-in through the provider, even with SIGNUP_MODE=invite or
# closed. Password sign-up still follows SIGNUP_MODE.
OIDC_AUTO_SIGNUP=
# true: turn off password sign-in, sign-up and reset. Passkeys keep working.
OIDC_ONLY=
# true: skip the WonderMoney authenticator code after signing in through the provider. Only when
# the provider itself requires a second factor.
OIDC_TRUST_IDP_MFA=
# true: accept an email address the provider has not verified. Such an account is never linked
# to an existing one.
OIDC_ALLOW_UNVERIFIED_EMAIL=

# ─── Email (optional) ──────────────────────────────────────────────────────────
# Without a provider, emails (password resets, invites) are written to the API log:
#   docker compose logs api | grep "Email not sent"
EMAIL_FROM=
# The sender's name; empty uses INSTANCE_NAME.
EMAIL_FROM_NAME=
# SMTP. To read mail in the bundled Mailpit instead (http://localhost:8025), add `mail` to
# COMPOSE_PROFILES and use SMTP_HOST=mailpit, SMTP_PORT=1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Or Resend:
RESEND_API_KEY=

# ─── File storage (optional) ───────────────────────────────────────────────────
# Needed for CSV imports and keeping receipt copies. For the bundled store, add `storage` to
# COMPOSE_PROFILES and set:
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: choose them; they become the store's credentials
#   S3_ENDPOINT=http://storage:8333
#   S3_PUBLIC_ENDPOINT=http://localhost:9000   (what browsers upload to)
#   S3_BUCKET=wondermoney
# Any S3-compatible service (R2, B2, AWS) works too.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_BUCKET=
S3_REGION=

# ─── AI (optional) ─────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint: OpenAI, OpenRouter, Ollama (http://host.docker.internal:11434/v1),
# LM Studio, vLLM. Powers receipt scanning, CSV column mapping, transaction categorisation,
# the monthly story and the assistant. Each AI_MODEL_<FEATURE> overrides AI_MODEL; receipt
# scanning needs a vision model.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MODEL_OCR=
AI_MODEL_ASSISTANT=
# PDF bank statement import sends each page as an image, so it needs a model that reads images.
# On an OpenAI-compatible endpoint it stays off until a model is named here (AI_MODEL is not used
# for it); on Anthropic, AI_MODEL is used when this is empty.
AI_MODEL_STATEMENT_IMPORT=
# Anthropic with your own API key: set AI_PROVIDER=anthropic. AI_MODEL (or AI_MODEL_<FEATURE>)
# is required, there is no default model. Anthropic wins over AI_BASE_URL.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# true: email/password accounts must verify their address (the link is emailed at sign-up)
# before using the assistant, receipt scanning or AI column mapping. Worth it with open sign-up
# and a paid model. Google and Apple accounts count as verified.
AI_REQUIRES_VERIFIED_EMAIL=
# Daily limits per household (members share them; they reset at midnight UTC). Empty means
# unlimited. Each assistant message, receipt scan, AI column mapping or PDF statement counts as one.
AI_DAILY_LIMIT_ASSISTANT=
AI_DAILY_LIMIT_OCR=
AI_DAILY_LIMIT_CSV_MAPPING=
AI_DAILY_LIMIT_STATEMENT_IMPORT=
# The largest PDF statement an import reads: bytes (10485760, 10 MB, by default) and pages (20 by
# default). Every page is one model request.
STATEMENT_IMPORT_MAX_BYTES=
STATEMENT_IMPORT_MAX_PAGES=

# ─── Market data (optional) ────────────────────────────────────────────────────
# EODHD key for ticker search, live prices and the Financial Markets module.
EODHD_API_KEY=
# The market-data providers to ask, in order, comma-separated: eodhd, stooq, coingecko. Empty
# means eodhd alone. Stooq (stock and index closes) and CoinGecko (crypto) are free and keyless,
# and stay off until you list them: read their terms of use first, they are yours to follow.
# A provider that fails or has nothing for a security hands over to the next one.
MARKET_DATA_PROVIDERS=

# ─── Bank sync (optional) ──────────────────────────────────────────────────────
# Empty: each person adds their own Enable Banking application key in Settings. To let your
# household link banks without one, register your own application with Enable Banking and set
# its application id and the path of its private key (.pem) on this machine, such as
# ./enable-banking.pem. The API and the worker read the key as a Docker secret; the user they run
# as (uid 1000) must be able to read it, so `chmod 644` it or `chown 1000` it. Someone's own key
# still wins. In Enable Banking's Restricted Production mode an application links only its
# owner's accounts, so it serves one household: the only one on the server, or the first to link
# a bank with it. Set ENABLE_BANKING_PRODUCTION_CONTRACT=true only once Enable Banking has given
# you a full production contract, to let every household use it.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_FILE=
ENABLE_BANKING_PRODUCTION_CONTRACT=

# ─── Crypto wallets (optional, off by default) ─────────────────────────────────
# The block explorer each chain's wallet balances are read from, as an https address. Bitcoin: a
# mempool.space or Esplora API root, such as https://mempool.example.org/api. Ethereum: a
# Blockscout root, such as https://blockscout.example.org. The explorer sees every address it is
# asked about and your server's IP, and can link a household's addresses together, so prefer your
# own node with mempool, Esplora or Blockscout. Public ones (https://mempool.space/api,
# https://eth.blockscout.com) are your choice, on their terms. Empty: no explorer is called and
# wallets are hidden. Wallets are priced through MARKET_DATA_PROVIDERS (eodhd or coingecko).
CRYPTO_BTC_EXPLORER_URL=
CRYPTO_ETH_EXPLORER_URL=

# The bank providers to offer, comma-separated: enable_banking, simplefin. Empty means
# enable_banking alone; none turns bank sync off. SimpleFIN (US and Canadian banks, through the
# paid SimpleFIN Bridge each user subscribes to) is off until listed, as in
# BANK_PROVIDERS=enable_banking,simplefin.
BANK_PROVIDERS=
# The hosts the server may call for SimpleFIN, comma-separated. Empty means the SimpleFIN Bridge
# (bridge.simplefin.org, beta-bridge.simplefin.org); set it only for another SimpleFIN server.
SIMPLEFIN_BRIDGE_HOSTS=

# ─── Merchant logos (optional, off by default) ─────────────────────────────────
# A logo service's https address with {domain} where the merchant's website domain goes, such as
# https://logos.example.com/{domain}.png. The API fetches each logo itself and serves it to the
# apps, so the service sees your server and the merchant's domain, never your users. Empty: no
# merchant data leaves the server, and the apps show each merchant's initial.
MERCHANT_LOGO_URL_TEMPLATE=

# ─── Mobile push notifications (optional, off by default) ──────────────────────
# true: the mobile app can register phones and the API and worker send notifications through the
# Expo push service (budget alerts, card payment reminders, bank connection alerts, a test
# notification). The text never holds an amount or a merchant. Empty: off, nothing is sent.
# The published app's push tokens belong to its Expo project, so your server can reach them only
# while that project accepts pushes without an access token; see the docs' "Mobile app" page.
PUSH_ENABLED=
# An Expo access token, for an Expo project that requires one on push requests ("enhanced
# security for push notifications"). Empty: none is sent.
EXPO_ACCESS_TOKEN=

# ─── Mobile app passkeys (optional, only for an app you build yourself) ─────────
# A passkey belongs to the web app's hostname, and the phone offers it to an app only when that
# hostname vouches for the app. The published WonderMoney app lists only wonder.money, so leave
# these empty unless you build the app from source with your own domain (see the docs' "Mobile
# app" page). Empty: /.well-known/apple-app-site-association and /.well-known/assetlinks.json
# answer 404 and passkeys work on the web app only.
# iOS: your Apple Developer team ID and the app's bundle ID.
IOS_APP_TEAM_ID=
IOS_APP_BUNDLE_ID=
# Android: the app's package name and the SHA-256 fingerprints of its signing certificates,
# comma-separated (AB:CD:...). The API reads the fingerprints too, to accept Android's passkeys.
ANDROID_APP_PACKAGE=
ANDROID_APP_CERT_SHA256=

# ─── Contact form captcha (optional) ───────────────────────────────────────────
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ─── Error tracking (optional) ─────────────────────────────────────────────────
# Sentry DSNs from your own Sentry project: the API and worker, and the web app. Empty sends
# no error reports.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── Analytics (optional, off by default) ──────────────────────────────────────
# Unset, your instance loads no tag manager or analytics script and records no usage events.
# Each setting turns on one tracker for your own account with that service:
#   NEXT_PUBLIC_GTM_ID       a Google Tag Manager container (GTM-XXXXXXX), loaded by the web app
#   NEXT_PUBLIC_POSTHOG_KEY  a PostHog project key: the web app sends page views and usage events
#                            and records sessions
#   ANALYTICS_OUTBOX_MODE=live with POSTHOG_API_KEY: the API and worker send sign-up, login and
#                            bank sync events to PostHog
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_POSTHOG_KEY=
ANALYTICS_OUTBOX_MODE=
POSTHOG_API_KEY=

# ─── Monitoring (optional) ─────────────────────────────────────────────────────
# GET /v1/health/ready reports the job queue as backed up once a job has waited this many
# minutes to start. Empty means 60.
HEALTH_MAX_JOB_AGE_MINUTES=

# ─── Backups (optional) ────────────────────────────────────────────────────────
# Add `backup` to COMPOSE_PROFILES for a daily copy of the database and of the bundled store's
# files in BACKUP_DIR/<timestamp>/; `docker compose run --rm backup now` takes one at once
# (README.md, "Back up"). Keep this .env somewhere else too: a restored database needs the same
# CREDENTIAL_ENCRYPTION_KEY_V1, and the backups never include it.
# Where the backups go on this machine. Empty means ./backups beside this file.
BACKUP_DIR=
# When, as a cron expression (minute hour day month weekday). Empty means 0 2 * * *, 02:00 daily.
BACKUP_SCHEDULE=
# How many days of backups to keep in BACKUP_DIR. Empty means 7; 0 keeps every one.
BACKUP_KEEP_DAYS=
# The time zone of both schedules, e.g. Europe/Lisbon. Empty means UTC. Folder names are UTC.
BACKUP_TZ=
# Off-site copies: add `backup-offsite` to COMPOSE_PROFILES, set up a remote with
# `docker compose run --rm backup-offsite config` (any rclone remote: S3, B2, SFTP, Google Drive,
# ...; saved in ./rclone/rclone.conf) and set BACKUP_DESTINATION to it and a path, e.g.
# b2:my-bucket/wondermoney. Only finished backup folders are copied.
BACKUP_DESTINATION=
# When to copy. Empty means 30 2 * * *, half an hour after the default backup time.
BACKUP_OFFSITE_SCHEDULE=
# How many days of copies to keep at BACKUP_DESTINATION. Empty means 30; 0 keeps every one.
BACKUP_OFFSITE_KEEP_DAYS=

# ─── Image version ─────────────────────────────────────────────────────────────
WM_VERSION=latest
