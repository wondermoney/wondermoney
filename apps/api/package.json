{
  "name": "@wondermoney/api",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": "./dist/server.js",
  "author": "The WonderMoney contributors",
  "scripts": {
    "build": "rimraf ./dist && pnpm run ts && pnpm run ts:migrations && tsc-alias -p tsconfig.json -f && pnpm run migrate:bundle:check && pnpm run sentry:inject",
    "debug": "NODE_ENV=development tsx watch --inspect src/server.ts",
    "demo:refresh": "NODE_ENV=production node dist/database/scripts/refresh-demo-data.js",
    "demo:refresh:dev": "NODE_ENV=development tsx src/database/scripts/refresh-demo-data.ts",
    "demo:reset": "NODE_ENV=production node dist/database/scripts/reset-demo-data.js",
    "demo:reset:dev": "NODE_ENV=development tsx src/database/scripts/reset-demo-data.ts",
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "devi": "infisical run -- pnpm dev",
    "devs": "infisical run --env=staging -- pnpm dev",
    "knip": "knip",
    "lint": "eslint .",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "migrate:bundle:check": "node scripts/verify-migration-bundle.mjs",
    "migrate:dev": "node scripts/assert-local-db.mjs migrate:dev --opt-in && NODE_ENV=development NODE_OPTIONS='--import=tsx' npx mikro-orm migration:up",
    "migrate:dev:check": "NODE_ENV=development NODE_OPTIONS='--import=tsx' npx mikro-orm migration:check",
    "migrate:dev:create": "NODE_ENV=development NODE_OPTIONS='--import=tsx' npx mikro-orm migration:create",
    "migrate:dev:fresh": "node scripts/assert-local-db.mjs migrate:dev:fresh && NODE_ENV=development NODE_OPTIONS='--import=tsx' npx mikro-orm migration:fresh --seed",
    "migrate:manual": "APPLY_MANUAL_MIGRATIONS=true NODE_ENV=development NODE_OPTIONS=\"--import=tsx\" npx mikro-orm migration:up",
    "migrate:manual:prd": "APPLY_MANUAL_MIGRATIONS=true NODE_ENV=production node dist/migrate.js",
    "migrate:prd": "NODE_ENV=production NODE_OPTIONS='--import=tsx' npx mikro-orm migration:up",
    "migrate:prd:check": "NODE_ENV=production NODE_OPTIONS='--import=tsx' npx mikro-orm migration:check",
    "migrate:prd:create": "NODE_ENV=production NODE_OPTIONS='--import=tsx' npx mikro-orm migration:create",
    "migrate:prd:fresh": "node scripts/assert-local-db.mjs migrate:prd:fresh && NODE_ENV=production NODE_OPTIONS='--import=tsx' npx mikro-orm migration:fresh --seed",
    "migrate:prd:list": "NODE_ENV=production NODE_OPTIONS='--import=tsx' npx mikro-orm migration:list",
    "migrate:prd:pending": "NODE_ENV=production NODE_OPTIONS='--import=tsx' npx mikro-orm migration:pending",
    "operations:recover": "NODE_ENV=production node dist/jobs/recover-background-operations.js",
    "operations:recover:dev": "NODE_ENV=development tsx src/jobs/recover-background-operations.ts",
    "seed:dev": "node scripts/assert-local-db.mjs seed:dev --opt-in && NODE_ENV=development NODE_OPTIONS='--import=tsx' npx mikro-orm seeder:run",
    "seed:prd": "NODE_ENV=production npx mikro-orm seeder:run",
    "sentry:inject": "sentry-cli sourcemaps inject --org wonder-money --project api ./dist",
    "sentry:sourcemaps": "pnpm run sentry:inject && sentry-cli sourcemaps upload --org wonder-money --project api ./dist",
    "bootstrap": "node scripts/bootstrap.mjs",
    "setup:test": "NODE_ENV=development NODE_OPTIONS='--import=tsx' node src/database/scripts/setup-test-user.ts",
    "start": "NODE_ENV=production node dist/server.js",
    "swagger": "tsx scripts/swagger.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:worker-deployment": "tsx scripts/worker-deployment-regression-checks.ts",
    "ts": "tsc --project tsconfig.json",
    "ts:migrations": "tsc --project tsconfig.migrations.json",
    "worker": "NODE_ENV=production node dist/worker.js",
    "worker:dev": "tsx watch --clear-screen=false src/worker.ts",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/azure": "^3.0.68",
    "@ai-sdk/openai": "3.0.67",
    "@aws-sdk/client-s3": "^3.1004.0",
    "@aws-sdk/s3-request-presigner": "^3.1004.0",
    "@better-auth/core": "1.7.7",
    "@better-auth/expo": "1.7.7",
    "@better-auth/utils": "0.5.0",
    "@better-fetch/fetch": "1.3.2",
    "@bossbench/express": "^2.0.1",
    "@mikro-orm/core": "^6.6.10",
    "@mikro-orm/migrations": "^6.6.10",
    "@mikro-orm/postgresql": "^6.6.10",
    "@mikro-orm/reflection": "^6.6.10",
    "@mikro-orm/seeder": "^6.6.10",
    "@mikro-orm/sql-highlighter": "^1.0.1",
    "@sentry/node": "10.42.0",
    "@wondermoney/react-email": "workspace:*",
    "@wondermoney/shared": "workspace:*",
    "ai": "^6.0.193",
    "apicache": "^1.6.3",
    "axios": "^1.18.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.7.7",
    "better-call": "1.4.2",
    "big.js": "^7.0.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jose": "6.2.12",
    "jsvat-next": "^3.0.4",
    "lodash-es": "^4.17.23",
    "multer": "^2.1.1",
    "nodemailer": "10.0.16",
    "openai": "^6.27.0",
    "pdf-to-img": "^7.0.1",
    "pdfjs-dist": "~5.4.0",
    "pg": "8.23.1",
    "pg-boss": "12.18.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "posthog-node": "^5.28.0",
    "resend": "^6.18.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "zod": "^3.24.1",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@eslint/js": "9.39.2",
    "@mikro-orm/cli": "^6.6.10",
    "@sentry/cli": "^3.3.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/apicache": "^1.6.8",
    "@types/big.js": "^6.2.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/lodash-es": "^4.17.12",
    "@types/multer": "^2.1.0",
    "@types/node": "25.3.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/eslint-plugin": "^1.6.9",
    "eslint": "9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.6.0",
    "eslint-plugin-regexp": "^3.3.1",
    "knex": "3.2.10",
    "knip": "^5.86.0",
    "node-mocks-http": "^1.18.1",
    "prettier": "3.8.1",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "swagger-autogen": "^2.23.7",
    "tsc-alias": "^1.8.16",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "^4.1.0",
    "vitest-mock-extended": "^5.1.1"
  },
  "mikro-orm": {
    "alwaysAllowTs": true,
    "useTsNode": false,
    "configPaths": [
      "./src/mikro-orm.config.ts",
      "./dist/mikro-orm.config.js"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "lint-staged": {
    "*.ts": "eslint --cache --fix"
  }
}
