APP_ENV=development
NODE_ENV=development
PORT=3001
# Worker health server port. Defaults to 3002 locally; production/staging use PORT unless overridden.
WORKER_HEALTH_PORT=3002

# better-auth (embedded auth provider, mounted at /api/auth). Its tables live in a
# dedicated `better_auth` Postgres schema on the same DB (see mikro-orm migrations).
# BETTER_AUTH_SECRET: 32+ char high-entropy secret used to sign sessions/tokens.
# BETTER_AUTH_URL: this API's public base URL (http://localhost:3001 in dev).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Google OAuth client — reused by better-auth's Google social provider.
# Add `${BETTER_AUTH_URL}/api/auth/callback/google` as an authorized redirect URI
# in the Google Cloud console (e.g. http://localhost:3001/api/auth/callback/google
# locally, https://api.wonder.money/api/auth/callback/google in production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth client — used by better-auth's built-in Apple social provider (mobile
# Sign in with Apple). APPLE_CLIENT_SECRET is the pre-generated "Sign in with Apple"
# client-secret JWT (better-auth does not mint it; generate it from your Apple .p8 key).
# Add `${BETTER_AUTH_URL}/api/auth/callback/apple` as a Return URL in the Apple Developer
# portal (e.g. http://localhost:3001/api/auth/callback/apple locally,
# https://api.wonder.money/api/auth/callback/apple in production).
APPLE_CLIENT_ID=
# Optional additional Apple native app audience (bundle identifier). This is an explicit
# allowlist entry; it is not inferred from the token's aud claim.
APPLE_NATIVE_AUDIENCE=
APPLE_CLIENT_SECRET=

# App base URL — needed for absolute links (email templates, OAuth callbacks).
BASE_URL=

# ---------------------------------------------------------------------------
# Database — LOCAL ONLY.
#
# These defaults match the `postgres` service in docker-compose.yml (published on
# host port 5434). `pnpm bootstrap` writes this file for you already filled in.
#
# Rules, because every `migrate:*` / `seed:*` script connects to whatever these
# five variables say, regardless of the `dev`/`prd` in the script name:
#
#   1. Exactly ONE DB_* block per file. dotenv takes the LAST assignment, so a
#      second block further down silently wins and line ordering decides which
#      database a destructive command drops.
#   2. Never put a remote host here. Keep staging/production
#      connection details in a separate, clearly named file — e.g.
#      `.env.staging.local` — and load it explicitly only for approved ops:
#        env $(grep -v '^#' .env.staging.local | xargs) pnpm migrate:prd:pending
#   3. `pnpm migrate:dev:fresh` / `migrate:prd:fresh` DROP the whole database.
#      They are guarded by scripts/assert-local-db.mjs and will refuse to run
#      against anything that is not localhost/127.0.0.1/::1/postgres.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=wmuser
DB_PASSWORD=wmpass
DB_DATABASE=wmdb

# pg-boss background worker settings.
#
# pg-boss is the sole runtime for manual bank sync and the intended runtime for
# the remaining background-job migrations.
#
# Keep PGBOSS_SCHEMA as-is. This is the dedicated schema pg-boss uses in Postgres.
PGBOSS_SCHEMA=pgboss

# Keep false for normal API/runtime processes while old Lambdas remain active.
# When you are ready to initialize/update pg-boss tables, run ONE controlled
# worker process with PGBOSS_MIGRATE=true, then switch it back to false.
# Do not run PGBOSS_MIGRATE=true on multiple scaled workers.
PGBOSS_MIGRATE=false

# Safe to leave true on workers. It lets pg-boss supervise/recover queue state.
PGBOSS_SUPERVISE=true

# Set true on exactly ONE worker instance only when you want pg-boss schedules
# to own account auto-sync, asset-price refresh, portfolio snapshot auto, and
# background recovery. Leave unset or set to false/0/no/off to disable.
PGBOSS_SCHEDULE=false

# Financial email schedules and per-user consumers (independently default-on).
# The deploy-gate regression test asserts =true for these.
ENABLE_BUDGET_EMAIL_SCHEDULE=true
ENABLE_BUDGET_EMAIL_CONSUMER=true
ENABLE_WEEKLY_EMAIL_SCHEDULE=true
ENABLE_WEEKLY_EMAIL_CONSUMER=true

# Bank recovery is fail-closed by default. Enable only through an approved release manifest.
BANK_RECOVERY_MODE=off

# External worker heartbeat (dead-man's switch). When set on the scheduler-owning
# worker, a pg-boss job pings this HetrixTools URL every 2 minutes; if the pings
# stop, HetrixTools alerts. Leave blank everywhere except the prod worker so no
# other environment ever pings the production monitor. Secret — never commit a value.
HETRIX_WORKER_HEARTBEAT_URL=

# Financial email schedules and per-user consumers are independently default-on.
# Schedule flags are considered only on the single PGBOSS_SCHEDULE owner.
# Rollout: enable consumers before schedules. Rollback: disable schedules before consumers.

# Persist pg-boss warning information. Safe to keep true.
PGBOSS_PERSIST_WARNINGS=true


# Auto bank-sync throttle for pg-boss scheduled syncs.
# This is only used after PGBOSS_SCHEDULE=true. It limits how many requisition
# sync jobs one scanner run enqueues. Start conservative during pg-boss soak.
ACCOUNT_AUTO_SYNC_MAX_ENQUEUED=10

# Optional bossbench (pg-boss dashboard) basic-auth credentials, mounted at
# /v1/admin/jobs (routes/v1/admin.ts). That route already requires ADMIN_API_KEY, so
# these are defense-in-depth, not the primary gate. Leave blank locally to fall back to
# unauthenticated read-only browsing (still gated by ADMIN_API_KEY).

# Email sender. The name defaults to INSTANCE_NAME when empty.
EMAIL_FROM=
EMAIL_FROM_NAME=
# Resend transactional email (verify the sender's domain in Resend). Without it, set
# SMTP_HOST and friends, or leave both unset to write emails to the API log.
RESEND_API_KEY=

# HMAC secret for versioned global email opt-out links (minimum 32 characters).
EMAIL_OPT_OUT_SIGNING_SECRET=

SENTRY_DSN=

# Admin + internal service auth. ADMIN_API_KEY gates /v1/admin and /docs; the internal key
# authenticates service-to-service calls.
ADMIN_API_KEY=
INTERNAL_SERVICE_API_KEY=
# reCAPTCHA secret for the public support form.
RECAPTCHA_SECRET_KEY=
# Comma-separated origin allow-list for CORS.
CORS_ALLOWED_ORIGINS=

# App-level master key for AES-256-GCM encryption of stored BYOK provider secrets
# (e.g. Enable Banking private keys), via services/crypto/secret-encryption.service.ts.
# Must be a 32-byte (256-bit) key, base64-encoded. Generate one locally with:
#   openssl rand -base64 32
# Never commit a real value here — set it through your secret store like every other secret.
CREDENTIAL_ENCRYPTION_KEY_V1=

EODHD_API_KEY=

# Rollback switch for legacy immediate portfolio CSV imports. Keep false/unset.
# Enables legacy /upload, /import, and S3-triggered Lambda import paths only for approved rollback windows.



POSTHOG_API_KEY=
ANALYTICS_OUTBOX_MODE=off

# Bank recovery is fail-closed by default. Enable only through an approved release manifest.
BANK_RECOVERY_MODE=off

# Deterministic transaction metadata enrichment
TRANSACTION_METADATA_ENRICHMENT_ENABLED=true

# Deterministic transaction categorization
TRANSACTION_DETERMINISTIC_CATEGORIZATION_ENABLED=false

# GPT transaction enrichment foundation
TRANSACTION_ENRICHMENT_GPT_ENABLED=false
TRANSACTION_ENRICHMENT_GPT_MODE=off
TRANSACTION_ENRICHMENT_GPT_MODEL_VERSION=DeepSeek-V4-Flash

# Azure AI Foundry resource - OpenAI-format deployments (OCR + AI Assistant)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# Assistant tool-calling deployment (gpt-5.4-mini)
AZURE_OPENAI_DEPLOYMENT=
# Receipt/invoice OCR vision deployment (gpt-5.4-nano)
AZURE_OPENAI_OCR_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Azure AI Foundry model-inference endpoint - non-OpenAI-format deployments (transaction enrichment via DeepSeek-V4-Flash)
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_VERSION=

# Default runtime is pg-boss. Set lambda or http only for explicit rollback windows.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional seed controls. Blank values are treated as unset; seeded accounts are
# data fixtures and cannot log in.
SEED_REFERENCE_DATE=
SEED_RANDOM_SEED=

# Manual portfolio-snapshot trigger (API) — URL is called with the token as a bearer credential.

# Worker-only: demo data refresh schedule.
ENABLE_PGBOSS_DEMO_DATA_REFRESH=false
