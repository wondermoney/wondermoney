{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": [
    "-lintignore"
  ],
  "ignore": [
    "**/*.d.ts",
    "scripts/**",
    "src/database/constants/asset-class-rollup.ts",
    "src/database/entity/**",
    "src/database/filters/soft-delete-filter.ts",
    "src/database/migrations/**",
    "src/database/scripts/**",
    "src/database/seeders/**",
    "src/database/utils/**",
    "src/services/lifecycle/activation-copy.ts"
  ],
  "ignoreDependencies": [
    "pino-pretty",
    "prettier"
  ],
  "ignoreBinaries": [
    "infisical",
    "audit"
  ]
}
