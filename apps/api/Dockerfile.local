# Development image for docker-compose.yml (watch mode). Build context is the monorepo root,
# which the compose file also bind-mounts at /repo. Base image pinned by digest to match
# Dockerfile (node:26.13.0-alpine as of 2026-10-31); Dependabot bumps both together.
FROM node:26.13.0-alpine@sha256:c6ad9e9c1d80f6eb607c26b4b0a132ff7a2344fad1c78ea3baa2a7d4c8de6d94

# Node 25+ no longer bundles corepack, so install it (pinned) before enabling it; it then
# provides the pnpm version in the root package.json's packageManager field.
RUN npm install -g corepack@0.36.0 && corepack enable && apk add --no-cache curl
WORKDIR /repo
ENV NODE_ENV=development

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .pnpmfile.cjs ./
COPY apps/api/package.json apps/api/
COPY packages/shared/package.json packages/shared/
COPY packages/react-email/package.json packages/react-email/
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter @wondermoney/api...

COPY apps/api apps/api
COPY packages/shared packages/shared
COPY packages/react-email packages/react-email
RUN pnpm --filter @wondermoney/shared --filter @wondermoney/react-email run build:lib

WORKDIR /repo/apps/api
EXPOSE 3000
CMD ["pnpm", "run", "dev"]
