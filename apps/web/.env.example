# --- Where this instance lives --------------------------------------------------
# The WonderMoney API and this web app's own address.
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Instance settings (all optional; see lib/instance.ts) -----------------------
# Help links. Defaults to the project's public docs.
NEXT_PUBLIC_DOCS_URL=""
# Shown on the sign-up page only when both are set.
NEXT_PUBLIC_TERMS_URL=""
NEXT_PUBLIC_PRIVACY_URL=""
# Must match the API's AUTH_COOKIE_DOMAIN when the app and API are on different hostnames
# (e.g. ".example.com"). Leave empty when they share one hostname, or for a host-only cookie.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=""
# A shared read-only demo account, if this instance has one.
NEXT_PUBLIC_DEMO_EMAIL=""
# wonder.money only: the banner announcing the hosted service's move to open source.
NEXT_PUBLIC_SHOW_PIVOT_BANNER=""

# --- Mobile app passkeys (optional) ---------------------------------------------
# Served as /.well-known/apple-app-site-association and /.well-known/assetlinks.json, which let
# the mobile app use this web app's passkeys (lib/mobile-app/associated-apps.ts). Empty: 404.
# Only for an app build that lists this hostname among its associated domains.
IOS_APP_TEAM_ID=""
IOS_APP_BUNDLE_ID=""
ANDROID_APP_PACKAGE=""
# SHA-256 fingerprints of the Android signing certificates, comma-separated (AB:CD:...). Set the
# same value on the API, which accepts Android's passkey origin only for these.
ANDROID_APP_CERT_SHA256=""

# --- Optional integrations -------------------------------------------------------
# Error tracking (also needs NEXT_PUBLIC_ENABLE_SENTRY / ENABLE_SENTRY).
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_IGNORE_API_RESOLUTION_ERROR=1
# Optional browser analytics: configured trackers load only after explicit opt-in.
# Replay and email identification are disabled. In development also set NEXT_PUBLIC_ENABLE_ANALYTICS=1.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_GTM_ID=""
# reCAPTCHA v3 on the public contact form (the API needs RECAPTCHA_SECRET_KEY too).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
