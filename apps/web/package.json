{
  "name": "@wondermoney/web",
  "version": "6.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "dev:worktree": "pnpm dev:webpack -p 3000",
    "dev:wdyr": "NEXT_PUBLIC_ENABLE_WDYR=1 next dev",
    "devi": "infisical run -- pnpm dev",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build --webpack",
    "build:analyze": "cross-env ANALYZE=true next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "e2e:worktree:preflight": "tsx scripts/worktree-e2e-preflight.ts",
    "qa:smoke": "bash scripts/e2e-smoke-agent-browser.sh",
    "type-check": "next typegen && tsc --pretty --noEmit",
    "format": "prettier --write .",
    "cypress:open": "cypress open",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "NEXT_PUBLIC_DISABLE_REACT_DEVTOOLS=1 start-server-and-test \"pnpm dev:webpack -p ${E2E_WEB_PORT:-3000}\" \"http://localhost:${E2E_WEB_PORT:-3000}\" \"cypress open --e2e\"",
    "e2e:headless": "NEXT_PUBLIC_DISABLE_REACT_DEVTOOLS=1 start-server-and-test \"pnpm dev:webpack -p ${E2E_WEB_PORT:-3000}\" \"http://localhost:${E2E_WEB_PORT:-3000}\" \"cypress run --e2e\"",
    "update-deps": "pnpm update --interactive --latest"
  },
