---
import TopLevelPage from "@/components/pages/TopLevelPage.astro";
import { getTopLevelPageStaticPaths, type TopLevelRouteId } from "@/lib/pageStaticPaths";

export const prerender = true;

export function getStaticPaths() {
  return getTopLevelPageStaticPaths("en");
}

const { routeId, redirectTo } = Astro.props as {
  routeId: TopLevelRouteId;
  redirectTo?: string;
};

if (redirectTo) {
  return Astro.redirect(`/en/${redirectTo}`, 301);
}
---

<TopLevelPage locale="en" routeId={routeId} />
