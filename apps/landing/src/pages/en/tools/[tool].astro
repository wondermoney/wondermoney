---
import ToolDetailPage from "@/components/pages/ToolDetailPage.astro";
import { getToolStaticPaths, type ToolRouteId } from "@/lib/pageStaticPaths";

export const prerender = true;

export function getStaticPaths() {
  return getToolStaticPaths("en");
}

const { routeId, redirectTo } = Astro.props as {
  routeId: ToolRouteId;
  redirectTo?: string;
};

if (redirectTo) {
  return Astro.redirect(`/en/tools/${redirectTo}`, 301);
}
---

<ToolDetailPage locale="en" routeId={routeId} />
