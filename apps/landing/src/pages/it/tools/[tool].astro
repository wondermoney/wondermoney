---
import ToolDetailPage from "@/components/pages/ToolDetailPage.astro";
import { getToolStaticPaths, type ToolRouteId } from "@/lib/pageStaticPaths";

export const prerender = true;

export function getStaticPaths() {
  return getToolStaticPaths("it");
}

const { routeId, redirectTo } = Astro.props as {
  routeId: ToolRouteId;
  redirectTo?: string;
};

if (redirectTo) {
  return Astro.redirect(`/it/tools/${redirectTo}`, 301);
}
---

<ToolDetailPage locale="it" routeId={routeId} />
