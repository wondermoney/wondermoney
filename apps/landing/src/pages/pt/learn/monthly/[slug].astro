---
import MonthlyDetailPage from "@/components/pages/MonthlyDetailPage.astro";
import { getMonthlyStaticPaths, type MonthlyContent } from "@/lib/pageStaticPaths";

export const prerender = true;

export async function getStaticPaths() {
  return getMonthlyStaticPaths("pt");
}

const { item } = Astro.props as { item: MonthlyContent };
---

<MonthlyDetailPage locale="pt" item={item} />
