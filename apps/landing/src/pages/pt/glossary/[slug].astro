---
import GlossaryDetailPage from "@/components/pages/GlossaryDetailPage.astro";
import { getGlossaryTermStaticPaths, type GlossaryTermEntry } from "@/lib/pageStaticPaths";

export const prerender = true;

export async function getStaticPaths() {
  return getGlossaryTermStaticPaths("pt");
}

const { term, alternateLinks } = Astro.props as {
  term: GlossaryTermEntry;
  alternateLinks: Array<{ hrefLang: string; href: string }>;
};
---

<GlossaryDetailPage locale="pt" term={term} alternateLinks={alternateLinks} />
