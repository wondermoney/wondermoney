---
import FeaturePage from "@/components/pages/FeaturePage.astro";
import { getFeatureStaticPaths, type FeatureRouteId } from "@/lib/pageStaticPaths";

export const prerender = true;

export function getStaticPaths() {
  return getFeatureStaticPaths("pt");
}

const { routeId } = Astro.props as { routeId: FeatureRouteId };
---

<FeaturePage locale="pt" routeId={routeId} />
