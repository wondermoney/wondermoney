---
import ToolDetailPage from "@/components/pages/ToolDetailPage.astro";
import { getToolStaticPaths, type ToolRouteId } from "@/lib/pageStaticPaths";

export const prerender = true;

export function getStaticPaths() {
  return getToolStaticPaths("de");
}

const { routeId } = Astro.props as { routeId: ToolRouteId };
---

<ToolDetailPage locale="de" routeId={routeId} />
