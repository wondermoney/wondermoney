---
import MonthlyDetailPage from "@/components/pages/MonthlyDetailPage.astro";
import { getMonthlyStaticPaths, type MonthlyContent } from "@/lib/contentCollections";

export const prerender = true;

export async function getStaticPaths() {
  return getMonthlyStaticPaths("fr");
}

const { item } = Astro.props as { item: MonthlyContent };
---

<MonthlyDetailPage locale="fr" item={item} />
