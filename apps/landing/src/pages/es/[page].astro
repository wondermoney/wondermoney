---
import TopLevelPage from "@/components/pages/TopLevelPage.astro";
import { getTopLevelPageStaticPaths, type TopLevelRouteId } from "@/lib/pageStaticPaths";

export const prerender = true;

export function getStaticPaths() {
  return getTopLevelPageStaticPaths("es");
}

const { routeId } = Astro.props as { routeId: TopLevelRouteId };
---

<TopLevelPage locale="es" routeId={routeId} />
