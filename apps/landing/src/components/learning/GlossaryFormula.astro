---
/**
 * A glossary term's formula: the expression, its variables and notes. It sits
 * under the term page's "Formula" section head (ArticleSection.astro), so it
 * draws no heading or card of its own; `hasFormulaContent` tells the page
 * whether there is anything to show.
 */
import { hasFormulaContent, type FormulaInput } from "@/lib/glossaryFormula"

interface Props {
	formula?: FormulaInput | null
}

const { formula } = Astro.props

const formulaExpression = formula?.expression?.trim() ?? ""
const variables = formula?.variables ?? []
const notes = formula?.notes?.trim() ?? ""
---

{
	hasFormulaContent(formula) && (
		<div class="not-prose">
			{formulaExpression && (
				<p class="overflow-x-auto rounded-md border border-border bg-paper-2 px-4 py-3 font-mono text-base text-foreground">
					{formulaExpression}
				</p>
			)}
			{
				variables.length > 0 && (
					<ul role="list" class="mt-4 space-y-2 text-base leading-7 text-ink-2">
						{variables.map((variable) => (
							<li>
								<strong class="font-mono font-medium text-foreground">
									{variable.symbol || variable.label || variable.name || "-"}
								</strong>
								{(variable.meaning || variable.value) && (
									<span>
										{" "}
										- {variable.meaning || variable.value}
									</span>
								)}
							</li>
						))}
					</ul>
				)
			}
			{notes && <p class="mt-4 text-base leading-7 text-ink-2">{notes}</p>}
		</div>
	)
}
