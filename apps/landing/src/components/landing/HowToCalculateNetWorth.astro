---
// The net worth guide, in the shape of a learn guide (LearnGuidePage.astro):
// the hero with the scale, numbered sections in the reading column, the
// in-article sign-up card and the questions, then the card CTA and "Keep
// reading". TopLevelPage.astro supplies the document and the header.
import ArticleSection from "@/components/learning/ArticleSection.astro";
import DataTable from "@/components/learning/DataTable.astro";
import ArticleHero from "@/components/shared/ArticleHero.astro";
import CTABanner from "@/components/shared/CTABanner";
import FigureCards from "@/components/shared/FigureCards.astro";
import FinancialDisclaimer from "@/components/shared/FinancialDisclaimer";
import { buttonVariants } from "@/components/ui/button";
import { appSignupUrl } from "@/lib/appLinks";
import { buildOutline, readingMinutes } from "@/lib/articleOutline";
import { PAGE_FIGURES } from "@/lib/hairline/articleFigures";
import type { Lang } from "@/lib/i18nLocale";
import { toLocalizedPath } from "@/lib/routes";
import { topLevelPageCard } from "@/lib/topLevelPageCards";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `lp.howToCalculateNetWorth.${key}`;

const sectionKeys = ["what", "why", "assets", "liabilities", "calculate", "example", "track"] as const;
type SectionKey = (typeof sectionKeys)[number];
const outline = buildOutline(sectionKeys.map((key) => t(k(`${key}Title`))));
const section = (key: SectionKey) => {
  const index = sectionKeys.indexOf(key);
  return { entry: outline[index], index, numbered: true };
};

const categoryRows = (kind: "asset" | "liability") =>
  [1, 2, 3, 4].map((n) => [t(k(`${kind}Category${n}`)), t(k(`${kind}Category${n}Items`))]);
const exampleAssets = [1, 2, 3, 4].map((n) => t(k(`exampleAsset${n}`)));
const exampleLiabilities = [1, 2, 3].map((n) => t(k(`exampleLiability${n}`)));
const faqs = [1, 2, 3, 4].map((n) => ({ question: t(k(`faq${n}Q`)), answer: t(k(`faq${n}A`)) }));

const readMinutes = readingMinutes([
  t(k("heroSubtitle")),
  ...["whatBody", "whyBody", "assetsBody", "assetNote", "liabilitiesBody", "calculateBody", "trackBody", "autoBody"].map(
    (key) => t(k(key)),
  ),
  ...categoryRows("asset").flat(),
  ...categoryRows("liability").flat(),
  ...exampleAssets,
  ...exampleLiabilities,
  ...faqs.flatMap((item) => [item.question, item.answer]),
]);

const keepReading = [
  topLevelPageCard("pageNetWorthTracker", locale, t),
  topLevelPageCard("pageFireCalculator", locale, t),
];
---

<article>
  <ArticleHero
    locale={locale}
    title={t(k("heroTitle"))}
    dek={t(k("heroSubtitle"))}
    breadcrumbs={[{ label: t("footer.resources"), href: toLocalizedPath("pageResources", locale) }]}
    readMinutes={readMinutes}
    outline={outline}
    figure={PAGE_FIGURES.pageHowToCalculateNetWorth}
  />

  <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8 lg:py-16">
    <div class="max-w-[40rem] space-y-10">
      <ArticleSection {...section("what")}>
        <p>{t(k("whatBody"))}</p>
        <p class="not-prose rounded-lg border border-border bg-paper-2 px-4 py-3 text-base font-semibold text-foreground">
          {t(k("formulaLabel"))}
        </p>
      </ArticleSection>

      <ArticleSection {...section("why")}>
        <p>{t(k("whyBody"))}</p>
      </ArticleSection>

      <ArticleSection {...section("assets")}>
        <p>{t(k("assetsBody"))}</p>
        <div class="not-prose">
          <DataTable rows={categoryRows("asset")} />
          <p class="mt-3 text-sm leading-6 text-muted-foreground">{t(k("assetNote"))}</p>
        </div>
      </ArticleSection>

      <ArticleSection {...section("liabilities")}>
        <p>{t(k("liabilitiesBody"))}</p>
        <div class="not-prose">
          <DataTable rows={categoryRows("liability")} />
        </div>
      </ArticleSection>

      <ArticleSection {...section("calculate")}>
        <p>{t(k("calculateBody"))}</p>
      </ArticleSection>

      <ArticleSection {...section("example")}>
        <div class="not-prose space-y-4">
          <div class="grid gap-4 sm:grid-cols-2">
            <section class="rounded-card border border-success-text/30 p-5">
              <h3 class="text-sm font-semibold text-success-text">{t(k("exampleAssetsLabel"))}</h3>
              <ul role="list" class="mt-3 text-sm text-foreground">
                {exampleAssets.map((item) => <li class="border-b border-border-2 py-1.5 last:border-0">{item}</li>)}
              </ul>
              <p class="mt-3 text-sm font-semibold text-success-text">{t(k("exampleTotalAssets"))}</p>
            </section>
            <section class="rounded-card border border-destructive-text/30 p-5">
              <h3 class="text-sm font-semibold text-destructive-text">{t(k("exampleLiabilitiesLabel"))}</h3>
              <ul role="list" class="mt-3 text-sm text-foreground">
                {exampleLiabilities.map((item) => <li class="border-b border-border-2 py-1.5 last:border-0">{item}</li>)}
              </ul>
              <p class="mt-3 text-sm font-semibold text-destructive-text">{t(k("exampleTotalLiabilities"))}</p>
            </section>
          </div>
          <p class="rounded-lg border border-border bg-paper-2 px-4 py-3 text-lg font-semibold text-foreground">
            {t(k("exampleResult"))}
          </p>
        </div>
      </ArticleSection>

      <ArticleSection {...section("track")}>
        <p>{t(k("trackBody"))}</p>
      </ArticleSection>

      <section class="rounded-card border border-border bg-paper-2 p-5 sm:p-6">
        <h2 class="text-lg font-semibold text-foreground">{t(k("autoTitle"))}</h2>
        <p class="mt-3 text-base leading-7 text-ink-2">{t(k("autoBody"))}</p>
        <a href={appSignupUrl(locale)} data-net-worth-inline-cta class:list={[buttonVariants(), "mt-5"]}>
          {t("lp.shared.ctaPrimary")}
        </a>
        <p class="mt-3 text-sm text-muted-foreground">{t("lp.shared.trialNote")}</p>
      </section>

      <section class="rounded-card border border-border bg-background p-5 sm:p-6">
        <h2 class="text-lg font-semibold text-foreground">{t(k("faqTitle"))}</h2>
        <div class="mt-3 space-y-3">
          {faqs.map((item) => (
            <details class="rounded-md border border-border p-3">
              <summary class="cursor-pointer font-medium text-foreground">{item.question}</summary>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">{item.answer}</p>
            </details>
          ))}
        </div>
      </section>
    </div>

    <div class="mt-12 max-w-[40rem]">
      <FinancialDisclaimer locale={locale} client:idle />
    </div>
  </div>
</article>

<div class="mx-auto max-w-7xl px-6 pb-16 lg:px-8">
  <CTABanner
    locale={locale}
    variant="card"
    client:idle
    headline={t(k("ctaHeadline"))}
    description={t(k("ctaBody"))}
  />

  <section aria-labelledby="keep-reading" class="mt-16">
    <h2 id="keep-reading" class="text-base font-semibold text-foreground">{t("article.keepReading")}</h2>
    <FigureCards locale={locale} cards={keepReading} class="mt-4" />
  </section>
</div>

<script>
  import { getPageType, pushGtmEvent } from "@/lib/gtm";

  document.querySelector("[data-net-worth-inline-cta]")?.addEventListener("click", () => {
    pushGtmEvent({ event: "cta_click", cta_position: "inline", page_type: getPageType() });
  });
</script>
