---
// The FIRE calculator page, in the shape of every calculator page
// (ToolDetailPage.astro): the hero with the deck chair, the calculator across
// the page, its guide in the article column (what FIRE is, a worked example,
// the method and how to track it), the card CTA and the related pages as
// figure cards. TopLevelPage.astro supplies the document, header and JSON-LD.
import FireCalculatorComp from "@/components/calculators/FireCalculatorComp";
import FireGuide from "@/components/calculators/FireGuide.astro";
import ArticleHero from "@/components/shared/ArticleHero.astro";
import CTABanner from "@/components/shared/CTABanner";
import FigureCards from "@/components/shared/FigureCards.astro";
import FinancialDisclaimer from "@/components/shared/FinancialDisclaimer";
import type { OutlineEntry } from "@/lib/articleOutline";
import type { FigureCard } from "@/lib/figureCards";
import { figureForTool } from "@/lib/hairline/articleFigures";
import type { Lang } from "@/lib/i18nLocale";
import { toLocalizedPath, toToolsHubPath } from "@/lib/routes";
import { getToolCatalogEntry } from "@/lib/toolsCatalog";
import { topLevelPageCard } from "@/lib/topLevelPageCards";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `lp.fireCalculator.${key}`;

const calculatorLabel = t("global.relatedContent.calculator");
const outline: OutlineEntry[] = [
  { id: "calculator", title: calculatorLabel },
  { id: "guide", title: t("global.relatedContent.guide") },
];

const relatedCards: FigureCard[] = [
  ...getToolCatalogEntry("pageFireCalculator").related.map((routeId) => {
    const { key } = getToolCatalogEntry(routeId);
    return {
      href: toLocalizedPath(routeId, locale),
      title: t(`tools.${key}.title`),
      description: t(`tools.${key}.description`),
      figure: figureForTool(routeId),
      kind: calculatorLabel,
    };
  }),
  topLevelPageCard("pageHowToCalculateNetWorth", locale, t),
  topLevelPageCard("pageNetWorthTracker", locale, t),
  topLevelPageCard("pagePortfolioTracker", locale, t),
];
---

<article>
  <ArticleHero
    locale={locale}
    title={t(k("heroTitle"))}
    dek={t(k("heroSubtitle"))}
    breadcrumbs={[{ label: t("header.tools"), href: toToolsHubPath(locale) }, { label: t(k("eyebrow")) }]}
    outline={outline}
    figure={figureForTool("pageFireCalculator")}
  />

  <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8 lg:py-16">
    <section id="calculator" class="tool-calculator scroll-mt-24 space-y-5" aria-labelledby="fire-calculator-heading">
      <h2 id="fire-calculator-heading" class="text-2xl font-bold tracking-[-0.015em] text-foreground sm:text-3xl">
        {t(k("calcTitle"))}
      </h2>
      <p class="max-w-[40rem] text-lg leading-[1.7] text-ink-2">{t(k("calcBody"))}</p>
      <FireCalculatorComp locale={locale} client:load />
    </section>

    <div id="guide" class="mt-16 scroll-mt-24 border-t border-border pt-12 lg:mt-20 lg:pt-16">
      <FireGuide locale={locale} />
    </div>

    <div class="tool-guide-aside mt-12 max-w-[42rem]">
      <FinancialDisclaimer locale={locale} client:idle />
    </div>
  </div>
</article>

<div class="mx-auto max-w-7xl px-6 pb-16 lg:px-8">
  <CTABanner
    locale={locale}
    variant="card"
    client:idle
    headline={t(k("ctaHeadline"))}
    description={t(k("ctaBody"))}
  />

  <section aria-labelledby="related-content" class="mt-16">
    <h2 id="related-content" class="text-base font-semibold text-foreground">{t("global.relatedContent.title")}</h2>
    <FigureCards locale={locale} cards={relatedCards} class="mt-4" />
  </section>
</div>
