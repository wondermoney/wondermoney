---
// The FIRE calculator page: the calculator first, then what FIRE is, a worked
// example and the method (all prerendered), and the next step into WonderMoney.
import FireCalculatorComp from "@/components/calculators/FireCalculatorComp";
import FireGuide from "@/components/calculators/FireGuide.astro";
import CTABanner from "@/components/shared/CTABanner";
import type { Lang } from "@/lib/i18nLocale";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `lp.fireCalculator.${key}`;

const trackSteps = [1, 2, 3].map((number) => ({
  number,
  title: t(k(`track${number}Title`)),
  body: t(k(`track${number}Body`)),
}));
---

{/* Hero */}
<section class="bg-background pb-8 pt-16 md:pt-24">
  <div class="mx-auto max-w-4xl px-6 text-center lg:px-8">
    <h1 class="text-4xl font-semibold tracking-tight text-foreground sm:text-5xl [text-wrap:balance]">
      <span class="mb-3 block text-xl tracking-normal text-foreground">{t(k("eyebrow"))}</span>{" "}
      {t(k("heroTitle"))}
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-muted-foreground">
      {t(k("heroSubtitle"))}
    </p>
  </div>
</section>

{/* Calculator */}
<section class="pb-16 pt-8 md:pb-20" aria-labelledby="fire-calculator-heading">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <h2 id="fire-calculator-heading" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("calcTitle"))}
    </h2>
    <p class="mt-2 text-muted-foreground">{t(k("calcBody"))}</p>
    <div class="mt-6">
      <FireCalculatorComp locale={locale} client:load />
    </div>
  </div>
</section>

{/* What is FIRE */}
<section class="bg-paper-2 py-16 md:py-20">
  <div class="mx-auto max-w-3xl px-6 lg:px-8">
    <h2 class="mb-6 text-3xl font-semibold tracking-tight text-foreground">{t(k("whatTitle"))}</h2>
    <p class="mb-4 leading-7 text-muted-foreground">{t(k("whatBody1"))}</p>
    <p class="mb-4 leading-7 text-muted-foreground">{t(k("whatBody2"))}</p>
    <p class="max-w-[60ch] leading-7 text-muted-foreground">{t(k("whatBody3"))}</p>
  </div>
</section>

{/* Worked example and method */}
<section class="px-6 py-16 md:py-20 lg:px-8">
  <FireGuide locale={locale} />
</section>

{/* Track progress */}
<section class="py-16 md:py-20">
  <div class="mx-auto max-w-3xl px-6 lg:px-8">
    <h2 class="mb-12 text-center text-3xl font-semibold tracking-tight text-foreground">
      {t(k("trackTitle"))}
    </h2>
    <div class="flex flex-col gap-10">
      {
        trackSteps.map((step) => (
          <div class="flex gap-5">
            <div class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-primary-foreground">
              {step.number}
            </div>
            <div>
              <h3 class="text-base font-semibold text-foreground">{step.title}</h3>
              <p class="mt-1 text-sm leading-6 text-muted-foreground">{step.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

{/* Next step */}
<section class="py-8 pb-16 md:pb-24">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <CTABanner
      locale={locale}
      client:idle
      headline={t(k("ctaHeadline"))}
      description={t(k("ctaBody"))}
    />
  </div>
</section>
