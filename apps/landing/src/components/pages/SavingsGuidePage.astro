---
import "@/styles/globals.css";
import ContentLayout from "@/layouts/ContentLayout.astro";
import ArticleHero from "@/components/shared/ArticleHero.astro";
import FigureCards from "@/components/shared/FigureCards.astro";
import {
  SAVINGS_COLUMN_IDS,
  SAVINGS_GUIDE_CHECKED_ON,
  SAVINGS_GUIDE_RELATED_ROUTE_IDS,
  SAVINGS_PRODUCT_IDS,
  SAVINGS_SOURCE_IDS,
  SAVINGS_SOURCES,
  getProductCells,
  getTableRowCells,
} from "@/content/savingsGuide";
import { readingMinutes, sectionNumber } from "@/lib/articleOutline";
import { figureForTool, PAGE_FIGURES } from "@/lib/hairline/articleFigures";
import type { Lang } from "@/lib/i18nLocale";
import { formatMonthYear } from "@/lib/numberFormat";
import { buildAlternateLinks, toLocalizedPath } from "@/lib/routes";
import { getToolCatalogEntry } from "@/lib/toolsCatalog";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const routeId = "pageSavingsGuide";
const canonicalPath = toLocalizedPath(routeId, locale);
const canonicalUrl = `${Astro.url.origin}${canonicalPath}`;
const checkedOn = formatMonthYear(locale, new Date(`${SAVINGS_GUIDE_CHECKED_ON}T00:00:00Z`));

const cellText = (part: string) => t(`savingsGuide.cells.${part}`);
// Labels that introduce the lines after them rather than being a line of their own.
const LABEL_PARTS = new Set(["domesticBanks", "foreignBanks"]);

const relatedTools = SAVINGS_GUIDE_RELATED_ROUTE_IDS.map((toolRouteId) => {
  const key = getToolCatalogEntry(toolRouteId).key;
  return {
    href: toLocalizedPath(toolRouteId, locale),
    title: t(`tools.${key}.title`),
    description: t(`tools.${key}.description`),
    figure: figureForTool(toolRouteId),
    kind: t("global.relatedContent.calculator"),
  };
});

const taxItems = ["domestic", "foreign", "insurance", "ppr"] as const;

// The page's sections, in order: the hero's chips and the numbers on the headings.
const outline = [
  { id: "savings-table-title", title: t("savingsGuide.tableTitle") },
  { id: "savings-products-title", title: t("savingsGuide.productsTitle") },
  { id: "savings-fgd-title", title: t("savingsGuide.fgd.title") },
  { id: "savings-tax-title", title: t("savingsGuide.tax.title") },
  { id: "savings-related-title", title: t("savingsGuide.related.title") },
  { id: "savings-sources-title", title: t("savingsGuide.sources.title") },
];
const number = (id: string) => sectionNumber(outline.findIndex((entry) => entry.id === id));
const readMinutes = readingMinutes([
  t("savingsGuide.intro"),
  ...SAVINGS_PRODUCT_IDS.map((product) => t(`savingsGuide.products.${product}.text`)),
  t("savingsGuide.fgd.p1"),
  t("savingsGuide.fgd.p2"),
  t("savingsGuide.fgd.p3"),
  t("savingsGuide.tax.intro"),
  ...taxItems.map((item) => t(`savingsGuide.tax.${item}.text`)),
]);
const h2 = "scroll-mt-24 text-2xl font-semibold tracking-tight";

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: t("savingsGuide.title"),
  description: t("savingsGuide.metaDescription"),
  url: canonicalUrl,
  inLanguage: locale,
  publisher: { "@type": "Organization", name: "WonderMoney", url: "https://wonder.money" },
};
---

<ContentLayout
  title={t("savingsGuide.metaTitle")}
  description={t("savingsGuide.metaDescription")}
  canonicalUrl={canonicalUrl}
  alternateLinks={buildAlternateLinks(routeId)}
  layout="article"
  structuredData={articleSchema}
  locale={locale}
>
  <article>
    <ArticleHero
      locale={locale}
      title={t("savingsGuide.title")}
      dek={t("savingsGuide.intro")}
      breadcrumbs={[{ label: t("footer.resources"), href: toLocalizedPath("pageResources", locale) }]}
      readMinutes={readMinutes}
      outline={outline}
      figure={PAGE_FIGURES.pageSavingsGuide}
    >
      <p class="mt-5">
        <span class="inline-flex items-center rounded-full border border-info/30 bg-info/5 px-3 py-1 text-xs font-medium text-info-text">
          {t("savingsGuide.checked", { date: checkedOn })}
        </span>
      </p>
    </ArticleHero>

    <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8 lg:py-16">
    <div class="max-w-5xl">

    <section aria-labelledby="savings-table-title" class="mt-10">
      <h2 id="savings-table-title" class={h2}><span aria-hidden="true" class="mb-2 block font-mono text-sm font-medium tracking-normal text-primary">{number("savings-table-title")}</span>{t("savingsGuide.tableTitle")}</h2>
      <p class="mt-2 max-w-prose text-sm text-muted-foreground">{t("savingsGuide.tableHint")}</p>

      <div class="mt-4 hidden lg:block" data-savings-table>
        <table class="w-full table-fixed border-collapse text-left text-sm">
          <caption class="sr-only">{t("savingsGuide.tableCaption")}</caption>
          <thead>
            <tr class="border-b-2 border-border">
              <th scope="col" class="w-[13%] p-2 align-bottom font-semibold">{t("savingsGuide.productColumn")}</th>
              {SAVINGS_COLUMN_IDS.map((column) => (
                <th scope="col" class="p-2 align-bottom font-semibold">{t(`savingsGuide.columns.${column}`)}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {SAVINGS_PRODUCT_IDS.map((product) => (
              <tr class="border-b border-border">
                <th scope="row" class="p-2 align-top font-semibold">
                  <a href={`#${product}`} class="underline decoration-border underline-offset-4 hover:decoration-current">
                    {t(`savingsGuide.products.${product}.name`)}
                  </a>
                </th>
                {getTableRowCells(product).map(({ column, rowSpan, parts }) => (
                  <td
                    rowspan={rowSpan}
                    data-column={column}
                    class:list={["p-2 align-top", rowSpan > 1 && "border-x border-border bg-muted/30"]}
                  >
                    {parts.map((part) => (
                      <p class:list={[LABEL_PARTS.has(part) ? "mt-2 font-medium first:mt-0" : "leading-5"]}>
                        {cellText(part)}
                      </p>
                    ))}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <ul role="list" class="mt-4 grid gap-4 lg:hidden" data-savings-cards>
        {SAVINGS_PRODUCT_IDS.map((product) => (
          <li class="min-w-0 rounded-lg border border-border p-4">
            <h3 class="break-words text-base font-semibold">
              <a href={`#${product}`} class="underline decoration-border underline-offset-4">
                {t(`savingsGuide.products.${product}.name`)}
              </a>
            </h3>
            <dl class="mt-3 grid gap-3 text-sm">
              {getProductCells(product).map(({ column, parts }) => (
                <div class="min-w-0">
                  <dt class="font-medium text-muted-foreground">{t(`savingsGuide.columns.${column}`)}</dt>
                  <dd class="mt-0.5 break-words">
                    {parts.map((part) => (
                      <p class:list={[LABEL_PARTS.has(part) && "mt-1 font-medium"]}>{cellText(part)}</p>
                    ))}
                  </dd>
                </div>
              ))}
            </dl>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="savings-products-title" class="mt-12">
      <h2 id="savings-products-title" class={h2}><span aria-hidden="true" class="mb-2 block font-mono text-sm font-medium tracking-normal text-primary">{number("savings-products-title")}</span>{t("savingsGuide.productsTitle")}</h2>
      <div class="mt-4 grid gap-8 md:grid-cols-2">
        {SAVINGS_PRODUCT_IDS.map((product) => (
          <section id={product} class="min-w-0 scroll-mt-24">
            <h3 class="break-words text-lg font-semibold">{t(`savingsGuide.products.${product}.name`)}</h3>
            <p class="mt-2 leading-7 text-muted-foreground">{t(`savingsGuide.products.${product}.text`)}</p>
          </section>
        ))}
      </div>
    </section>

    <section id="fgd" aria-labelledby="savings-fgd-title" class="mt-12 max-w-prose scroll-mt-24">
      <h2 id="savings-fgd-title" class={h2}><span aria-hidden="true" class="mb-2 block font-mono text-sm font-medium tracking-normal text-primary">{number("savings-fgd-title")}</span>{t("savingsGuide.fgd.title")}</h2>
      <p class="mt-3 text-lg leading-[1.7] text-ink-2">{t("savingsGuide.fgd.p1")}</p>
      <p class="mt-3 text-lg leading-[1.7] text-ink-2">{t("savingsGuide.fgd.p2")}</p>
      <p class="mt-3 text-lg leading-[1.7] text-ink-2">{t("savingsGuide.fgd.p3")}</p>
    </section>

    <section id="irs" aria-labelledby="savings-tax-title" class="mt-12 scroll-mt-24">
      <h2 id="savings-tax-title" class={h2}><span aria-hidden="true" class="mb-2 block font-mono text-sm font-medium tracking-normal text-primary">{number("savings-tax-title")}</span>{t("savingsGuide.tax.title")}</h2>
      <p class="mt-3 max-w-prose leading-7">{t("savingsGuide.tax.intro")}</p>
      <div class="mt-4 grid gap-6 md:grid-cols-2">
        {taxItems.map((item) => (
          <section class="min-w-0">
            <h3 class="text-lg font-semibold">{t(`savingsGuide.tax.${item}.title`)}</h3>
            <p class="mt-2 leading-7 text-muted-foreground">{t(`savingsGuide.tax.${item}.text`)}</p>
          </section>
        ))}
      </div>
    </section>

    <section aria-labelledby="savings-related-title" class="mt-12">
      <h2 id="savings-related-title" class={h2}><span aria-hidden="true" class="mb-2 block font-mono text-sm font-medium tracking-normal text-primary">{number("savings-related-title")}</span>{t("savingsGuide.related.title")}</h2>
      <p class="mt-2 max-w-prose text-muted-foreground">{t("savingsGuide.related.intro")}</p>
      <FigureCards locale={locale} cards={relatedTools} class="mt-6" />
    </section>

    <section id="sources" aria-labelledby="savings-sources-title" class="mt-12 scroll-mt-24">
      <h2 id="savings-sources-title" class={h2}><span aria-hidden="true" class="mb-2 block font-mono text-sm font-medium tracking-normal text-primary">{number("savings-sources-title")}</span>{t("savingsGuide.sources.title")}</h2>
      <p class="mt-2 max-w-prose text-muted-foreground">{t("savingsGuide.sources.intro")}</p>
      <ul role="list" class="mt-4 space-y-2 text-sm">
        {SAVINGS_SOURCE_IDS.map((source) => (
          <li class="break-words">
            <a href={SAVINGS_SOURCES[source].url} rel="noopener noreferrer" class="underline decoration-border underline-offset-4 hover:decoration-current">
              {t(`savingsGuide.sources.items.${source}`)}
            </a>
            <span class="text-muted-foreground"> · {t("savingsGuide.sources.checkedOn", { date: checkedOn })}</span>
          </li>
        ))}
      </ul>
    </section>

    <p class="mt-10 max-w-prose text-sm text-muted-foreground">{t("savingsGuide.disclaimer")}</p>
    </div>
    </div>
  </article>
</ContentLayout>
