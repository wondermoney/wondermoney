---
import "@/styles/globals.css";
import ContentLayout from "@/layouts/ContentLayout.astro";
import ArticleHero from "@/components/shared/ArticleHero.astro";
import ContentSearch from "@/components/shared/ContentSearch";
import { PAGE_FIGURES } from "@/lib/hairline/articleFigures";
import { getGlossaryTerms } from "@/lib/contentCollections";
import { getTranslations } from "@/lib/translations";
import type { Lang } from "@/lib/i18nLocale";
import { buildAlternateLinksForPath } from "@/lib/routes";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const alternateLinks = buildAlternateLinksForPath((lang) => `/${lang}/glossary`);

// Alphabetical by term.
const terms = (await getGlossaryTerms()).filter((term) => term.locale === locale);

function normalizeLetter(value: string): string {
  const firstChar = value.charAt(0).toUpperCase();
  const normalized = firstChar.normalize("NFD").replace(/[\u0300-\u036f]/g, "");

  if (normalized >= "A" && normalized <= "Z") {
    return normalized;
  }

  return "#";
}

const grouped: Record<string, typeof terms> = {};
const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
const glossarySections = [...alphabet, "#"];

for (const term of terms) {
  const letter = normalizeLetter(term.term);
  if (!grouped[letter]) {
    grouped[letter] = [];
  }
  grouped[letter].push(term);
}

const glossaryPrefix = `/${locale}/glossary`;
const categoryLabel = (category?: string) =>
  category ? t(`category.${category}`, { defaultValue: category }) : undefined;

const searchItems = terms.map((term) => ({
  title: term.term,
  description: term.definition,
  href: `${glossaryPrefix}/${term.slug}`,
  category: categoryLabel(term.category),
}));

const definedTermSetSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  name: t("glossary.hub.title"),
  description: t("glossary.hub.schemaDescription"),
  url: `https://wonder.money${glossaryPrefix}`,
  hasDefinedTerm: terms.map((term) => ({
    "@type": "DefinedTerm",
    name: term.term,
    description: term.definition,
    url: `https://wonder.money${glossaryPrefix}/${term.slug}`,
  })),
};
---

<ContentLayout
  title={t("glossary.hub.pageTitle")}
  description={t("glossary.hub.pageDescription")}
  alternateLinks={alternateLinks}
  layout="article"
  locale={locale}
  structuredData={definedTermSetSchema}
>
  <ArticleHero
    locale={locale}
    title={t("glossary.hub.title")}
    dek={t("glossary.hub.description")}
    breadcrumbs={[{ label: t("header.glossary") }]}
    figure={PAGE_FIGURES.glossaryHub}
  />

  <div class="mx-auto max-w-7xl px-6 pb-16 pt-2 lg:px-8">
    <ContentSearch
      locale={locale}
      client:load
      items={searchItems}
      placeholder={t("glossary.hub.searchPlaceholder")}
    />

    <nav class="mt-6" aria-label={t("glossary.hub.letterNav")}>
      <ul role="list" class="flex flex-wrap gap-1">
        {glossarySections.map((letter) => (
          <li>
            {grouped[letter] ? (
              <a
                href={`#letter-${letter}`}
                class="flex h-10 w-9 items-center justify-center rounded-md border border-border bg-card font-mono text-sm font-medium text-foreground transition-colors hover:border-primary/40 hover:text-primary"
              >
                {letter}
              </a>
            ) : (
              <span class="flex h-10 w-9 items-center justify-center font-mono text-sm text-muted-foreground/60">
                {letter}
              </span>
            )}
          </li>
        ))}
      </ul>
    </nav>

    {
      terms.length === 0 ? (
        <p class="mt-12 max-w-[40rem] rounded-card border border-border bg-paper-2 p-8 text-lg text-muted-foreground">
          {t("glossary.hub.comingSoon")}
        </p>
      ) : (
        <div class="mt-12 space-y-12">
          {glossarySections
            .filter((letter) => grouped[letter])
            .map((letter) => (
              <section
                id={`letter-${letter}`}
                class="grid scroll-mt-24 gap-x-12 gap-y-2 lg:grid-cols-[5rem_minmax(0,1fr)]"
              >
                <h2 class="text-3xl font-semibold leading-none tracking-[-0.02em] text-foreground lg:pt-5">
                  {letter}
                </h2>
                <ul role="list" class="grid gap-x-10 sm:grid-cols-2 xl:grid-cols-3">
                  {grouped[letter].map((term) => (
                    <li class="min-w-0 border-t border-border">
                      <a href={`${glossaryPrefix}/${term.slug}`} class="group block py-5">
                        {term.category && (
                          <span class="block text-sm text-muted-foreground">{categoryLabel(term.category)}</span>
                        )}
                        <h3 class="mt-0.5 text-lg font-semibold tracking-[-0.01em] text-foreground group-hover:text-primary">
                          {term.term}
                        </h3>
                        <p class="mt-1 line-clamp-2 text-sm leading-6 text-muted-foreground">{term.definition}</p>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
        </div>
      )
    }
  </div>
</ContentLayout>
