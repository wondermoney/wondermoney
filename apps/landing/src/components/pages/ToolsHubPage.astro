---
import "@/styles/globals.css";
import ContentLayout from "@/layouts/ContentLayout.astro";
import ArticleHero from "@/components/shared/ArticleHero.astro";
import FigureCards from "@/components/shared/FigureCards.astro";
import { sectionNumber } from "@/lib/articleOutline";
import { toolsHubGroupCards } from "@/lib/figureCards";
import { buildAlternateLinksForPath, toToolsHubPath, type Lang } from "@/lib/routes";
import { buildToolsHub, buildToolsHubItemList } from "@/lib/toolsCatalog";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const alternateLinks = buildAlternateLinksForPath((lang) => toToolsHubPath(lang));
const groups = buildToolsHub(locale);
const itemListSchema = buildToolsHubItemList(locale, t);
---

<ContentLayout
  title={t("tools.hub.pageTitle")}
  description={t("tools.hub.pageDescription")}
  alternateLinks={alternateLinks}
  layout="article"
  locale={locale}
  structuredData={itemListSchema}
>
  <div data-tools-hub>
    <ArticleHero
      locale={locale}
      title={t("tools.hub.title")}
      dek={t("tools.hub.description")}
      breadcrumbs={[{ label: t("header.tools") }]}
      figure="calculator"
    >
      <nav class="mt-7" aria-labelledby="tools-hub-tasks">
        <h2 id="tools-hub-tasks" class="text-sm font-medium text-foreground">
          {t("tools.hub.tasks.title")}
        </h2>
        <p class="mt-1 text-sm text-muted-foreground">{t("tools.hub.tasks.description")}</p>
        <ul role="list" class="mt-3 flex flex-wrap gap-2.5">
          {
            groups.map((group) => (
              <li class="min-w-0">
                <a
                  href={`#${group.anchor}`}
                  data-tools-hub-link="task"
                  data-group={group.id}
                  class="inline-flex min-h-10 items-center rounded-full border border-border bg-card px-3.5 py-1.5 text-sm text-foreground transition-colors hover:border-primary/40 hover:text-primary"
                >
                  {t(`tools.hub.groups.${group.id}.title`)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </ArticleHero>

    <div class="mx-auto max-w-7xl space-y-14 px-6 pb-16 pt-12 lg:px-8 lg:pt-14">
      {
        groups.map((group, index) => (
          <section id={group.anchor} class="scroll-mt-28" aria-labelledby={`${group.anchor}-title`}>
            <h2
              id={`${group.anchor}-title`}
              class="text-2xl font-bold tracking-[-0.015em] text-foreground sm:text-3xl"
            >
              <span aria-hidden="true" class="mb-2 block font-mono text-sm font-medium tracking-normal text-primary">
                {sectionNumber(index)}
              </span>
              {t(`tools.hub.groups.${group.id}.title`)}
            </h2>
            <p class="mt-3 max-w-[40rem] text-lg leading-[1.7] text-ink-2">
              {t(`tools.hub.groups.${group.id}.intro`)}
            </p>
            <FigureCards locale={locale} cards={toolsHubGroupCards(group, t)} variant="index" class="mt-6" />
          </section>
        ))
      }
    </div>
  </div>
</ContentLayout>

<script>
  import { trackToolsHubClicks } from "@/lib/toolsHubTracking";

  const hub = document.querySelector<HTMLElement>("[data-tools-hub]");
  if (hub) trackToolsHubClicks(hub);
</script>
