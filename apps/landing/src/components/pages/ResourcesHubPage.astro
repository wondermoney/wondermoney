---
import "@/styles/globals.css";
import ContentLayout from "@/layouts/ContentLayout.astro";
import ArticleHero from "@/components/shared/ArticleHero.astro";
import FigureCards from "@/components/shared/FigureCards.astro";
import { figureForResource } from "@/lib/hairline/articleFigures";
import type { Lang } from "@/lib/i18nLocale";
import { buildResourcesHub } from "@/lib/resourcesHub";
import { buildAlternateLinks } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const links = buildResourcesHub(locale);
const routeId = "pageResources";
const cards = links.map(({ destination, href, title, description, figure }) => ({
  href,
  title,
  description,
  figure: figure ?? figureForResource(destination),
  data: { "data-resource-destination": destination },
}));
---

<ContentLayout
  title={t("resources.metaTitle")}
  description={t("resources.metaDescription")}
  alternateLinks={buildAlternateLinks(routeId)}
  layout="article"
  locale={locale}
>
  <ArticleHero
    locale={locale}
    title={t("resources.title")}
    dek={t("resources.intro")}
    breadcrumbs={[{ label: t("footer.resources") }]}
  />

  <section aria-label={t("resources.title")} class="mx-auto max-w-7xl px-6 pb-16 pt-10 lg:px-8">
    <FigureCards id="resources-hub-links" locale={locale} cards={cards} headingLevel={2} />
  </section>
</ContentLayout>

<script>
  import { trackResourcesHubClicks } from "@/lib/resourcesHubTracking";

  const links = document.getElementById("resources-hub-links");
  if (links) trackResourcesHubClicks(links);
</script>
