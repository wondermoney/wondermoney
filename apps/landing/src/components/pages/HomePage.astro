---
import "@/styles/globals.css";
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/homepage/Hero";
import HowItWorks from "@/components/homepage/HowItWorks";
import FeatureStack from "@/components/homepage/FeatureStack";
import PrivacyStatement from "@/components/homepage/PrivacyStatement";
import OpenSource from "@/components/homepage/OpenSource";
import Faq from "@/components/homepage/Faq";
import BottomCTA from "@/components/homepage/BottomCTA";
import Header from "@/components/shared/Header";
import Footer from "@/components/shared/Footer";
import NotABank from "@/components/shared/NotABank";
import StructuredData from "@/components/shared/StructuredData.astro";
import { getTranslations } from "@/lib/translations";
import type { Lang } from "@/lib/i18nLocale";
import { buildAlternateLinksForPath } from "@/lib/routes";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const alternateLinks = buildAlternateLinksForPath((lang) => `/${lang}`);

const webApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "WonderMoney",
  "url": "https://app.wonder.money",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Web",
};

// Built from the same keys the FAQ accordion renders, in the page's language.
const homepageFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": ["faq1", "faq2", "faq3", "faq5"].map((key) => ({
    "@type": "Question",
    "name": t(`homepage.faq.${key}.question`),
    "acceptedAnswer": {
      "@type": "Answer",
      "text": t(`homepage.faq.${key}.answer`),
    },
  })),
};
---

<Layout
  locale={locale}
  title={t("homepage.metaTitle")}
  description={t("homepage.metaDescription")}
  alternateLinks={alternateLinks}
>
  <Header locale={locale} client:load />
  <main class="relative">
    <Hero locale={locale} client:idle />
    <FeatureStack locale={locale} client:idle />
    <HowItWorks locale={locale} />
    <PrivacyStatement locale={locale} />
    <OpenSource locale={locale} client:idle />
    <Faq locale={locale} client:idle />
    <BottomCTA locale={locale} client:idle />
    <div class="bg-paper-2 px-6 pb-16 lg:px-8">
      <NotABank locale={locale} client:idle />
    </div>
  </main>
  <Footer locale={locale} className="mt-0 md:mt-0" client:idle />
  <StructuredData data={[webApplicationSchema, homepageFaqSchema]} />
</Layout>
