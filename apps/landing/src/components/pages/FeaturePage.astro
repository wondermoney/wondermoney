---

<Layout locale={locale} title={pageMetaSelected.title} description={pageMetaSelected.description} alternateLinks={alternateLinks}>
  <Header locale={locale} client:load />
  <main class="relative">
    {routeId === "featureAccounts" && <FeatureAccounts locale={locale} client:idle />}
    {routeId === "featureBudgeting" && <FeatureBudgeting locale={locale} client:idle />}
    {routeId === "featureCategorization" && <FeatureCategorization locale={locale} client:idle />}
    {routeId === "featureCredits" && <FeatureCredits locale={locale} />}
    {routeId === "featureFinancialMarkets" && <FeatureFinancialMarkets locale={locale} />}
    {routeId === "featureGoals" && <FeatureGoals locale={locale} />}
    {routeId === "featureNetWorth" && <FeatureNetWorth locale={locale} />}
    {routeId === "featurePrivacy" && <FeaturePrivacy locale={locale} client:idle />}
    {routeId === "featurePortfolio" && <FeaturePortfolio locale={locale} />}
    {routeId === "featureReports" && <FeatureReports locale={locale} />}
    {showFinancialDisclaimer && (
      <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
        <FinancialDisclaimer locale={locale} client:idle />
      </div>
    )}
  </main>
  <Footer locale={locale} client:idle />
  <StructuredData data={structuredDataByRouteId[routeId]} />
</Layout>
