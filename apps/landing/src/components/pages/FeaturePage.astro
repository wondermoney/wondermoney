import { getTranslations } from "@/lib/translations";
import type { FeatureRouteId } from "@/lib/pageStaticPaths";
import FinancialDisclaimer from "@/components/shared/FinancialDisclaimer";

interface Props {
  locale: Lang;
  routeId: FeatureRouteId;
}

const { locale, routeId } = Astro.props;
const t = getTranslations(locale);

const pageMeta: Record<FeatureRouteId, { title: string; description: string }> = {
