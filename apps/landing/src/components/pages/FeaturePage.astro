---
import "@/styles/globals.css";
import Header from "@/components/shared/Header";
import Footer from "@/components/shared/Footer";
import Layout from "@/layouts/Layout.astro";
import StructuredData from "@/components/shared/StructuredData.astro";
import FeatureAccounts from "@/components/landing/FeatureAccounts";
import FeatureBudgeting from "@/components/landing/FeatureBudgeting";
import FeatureCategorization from "@/components/landing/FeatureCategorization";
import FeatureCredits from "@/components/landing/FeatureCredits";
