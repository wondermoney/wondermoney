---
/**
 * A curated list of outside resources (podcasts, newsletters, YouTube channels…) in the
 * Direction B article layout: the hero with the review date, how the entries were chosen, the
 * entries as cards, the pages they lead to, the closing CTA and the other lists. The content is
 * built by buildCuratedListPage (src/lib/resources/curatedLists/page.ts).
 */
import "@/styles/globals.css";
import ContentLayout from "@/layouts/ContentLayout.astro";
import ArticleHero from "@/components/shared/ArticleHero.astro";
import CTABanner from "@/components/shared/CTABanner";
import FigureCards from "@/components/shared/FigureCards.astro";
import { sectionNumber } from "@/lib/articleOutline";
import { getGuides } from "@/lib/contentCollections";
import type { Lang } from "@/lib/i18nLocale";
import { CURATED_LIST_STALE_AFTER_DAYS, type CuratedListId } from "@/lib/resources/curatedLists";
import { buildCuratedListPage } from "@/lib/resources/curatedLists/page";
import { buildAlternateLinks, toLocalizedPath } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
  listId: CuratedListId;
}

const { locale, listId } = Astro.props;
const t = getTranslations(locale);
const guideTitles = new Map(
  (await getGuides()).filter((guide) => guide.locale === locale).map((guide) => [guide.slug, guide.title]),
);
const page = buildCuratedListPage({ listId, locale, t, guideTitles, origin: Astro.url.origin });
const number = (id: string) => sectionNumber(page.outline.findIndex((entry) => entry.id === id));
const h2 = "scroll-mt-24 text-2xl font-semibold tracking-tight";
const index = "mb-2 block font-mono text-sm font-medium tracking-normal text-primary";
---

<ContentLayout
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalUrl={page.canonicalUrl}
  alternateLinks={buildAlternateLinks(page.list.routeId)}
  layout="article"
  structuredData={page.structuredData}
  locale={locale}
>
  <article data-curated-list={listId}>
    <ArticleHero
      locale={locale}
      title={page.title}
      dek={page.dek}
      breadcrumbs={[{ label: t("footer.resources"), href: toLocalizedPath("pageResources", locale) }]}
      outline={page.outline}
      figure={page.list.figure}
    >
      <p class="mt-5">
        <span class="inline-flex items-center rounded-full border border-info/30 bg-info/5 px-3 py-1 text-xs font-medium text-info-text">
          {page.reviewedBadge}
        </span>
      </p>
    </ArticleHero>

    <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8 lg:py-16">
      <div
        data-curated-stale
        data-reviewed={page.list.reviewed}
        data-stale-after-days={CURATED_LIST_STALE_AFTER_DAYS}
        hidden={!page.stale.atBuild}
        role="note"
        class="mb-10 max-w-prose rounded-card border border-warning-text/30 p-4 text-sm"
      >
        <p class="font-semibold text-warning-text">{page.stale.title}</p>
        <p class="mt-1 text-ink-2">{page.stale.text}</p>
      </div>

      <section aria-labelledby="curated-how" class="max-w-prose">
        <h2 id="curated-how" class={h2}><span aria-hidden="true" class={index}>{number("curated-how")}</span>{page.how.title}</h2>
        <p class="mt-3 text-lg leading-[1.7] text-ink-2">{page.how.intro}</p>
        <ul role="list" class="mt-4 space-y-2 text-lg leading-[1.7] text-ink-2">
          {page.how.criteria.map((criterion) => (
            <li class="flex gap-3">
              <svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mt-[0.45em] size-4 shrink-0 text-primary">
                <path d="M3 8.5l3 3 7-7" />
              </svg>
              <span>{criterion}</span>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-base leading-7 text-muted-foreground">{page.how.order}</p>
        <p class="mt-2 text-base leading-7 text-muted-foreground">{page.how.owner}</p>
      </section>

      <section aria-labelledby="curated-list" class="mt-14">
        <h2 id="curated-list" class={h2}><span aria-hidden="true" class={index}>{number("curated-list")}</span>{page.listTitle}</h2>
        <ul role="list" class="mt-6 grid gap-4 md:grid-cols-2" data-curated-entries>
          {page.entries.map((entry) => (
            <li class="flex min-w-0 flex-col rounded-card border border-border bg-card p-6" data-curated-entry>
              <h3 class="break-words text-lg font-semibold leading-7 tracking-[-0.01em]">
                <a href={entry.url} rel="noopener noreferrer" class="group underline decoration-border underline-offset-4 hover:decoration-current">
                  {entry.name}
                  <svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="ml-1 inline size-3.5 align-baseline text-muted-foreground group-hover:text-primary">
                    <path d="M6 3h7v7M13 3L4 12" />
                  </svg>
                </a>
              </h3>
              <p class="mt-1 text-sm text-muted-foreground">{entry.meta}</p>
              <dl class="mt-4 grid gap-3 text-base leading-7">
                <div>
                  <dt class="text-sm font-medium text-muted-foreground">{page.labels.audience}</dt>
                  <dd class="text-foreground">{entry.audience}</dd>
                </div>
                <div>
                  <dt class="text-sm font-medium text-muted-foreground">{page.labels.value}</dt>
                  <dd class="text-foreground">{entry.value}</dd>
                </div>
              </dl>
              <div class="mt-auto pt-5">
                {entry.related && (
                  <p class="text-sm">
                    <span class="text-muted-foreground">{page.labels.applyIt} </span>
                    <a href={entry.related.href} class="font-medium text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-current">
                      {entry.related.title}
                    </a>
                  </p>
                )}
                <p class="mt-2 text-xs text-muted-foreground">{entry.dates}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      {page.practice.cards.length > 0 && (
        <section aria-labelledby="curated-practice" class="mt-14">
          <h2 id="curated-practice" class={h2}><span aria-hidden="true" class={index}>{number("curated-practice")}</span>{page.practice.title}</h2>
          <p class="mt-2 max-w-prose text-muted-foreground">{page.practice.intro}</p>
          <FigureCards locale={locale} cards={page.practice.cards} class="mt-6" />
        </section>
      )}
    </div>
  </article>

  <div class="mx-auto max-w-7xl px-6 pb-16 lg:px-8">
    <CTABanner locale={locale} variant="card" client:idle />

    {page.otherLists.length > 0 && (
      <section aria-labelledby="keep-reading" class="mt-16">
        <h2 id="keep-reading" class="text-base font-semibold text-foreground">{t("article.keepReading")}</h2>
        <FigureCards locale={locale} cards={page.otherLists} class="mt-4" />
      </section>
    )}
  </div>
</ContentLayout>

<script>
  // The page is prerendered: show the review note once the list has gone unreviewed too long,
  // counted from today, not only from the build.
  const note = document.querySelector<HTMLElement>("[data-curated-stale]");
  if (note?.hidden) {
    const reviewed = Date.parse(`${note.dataset.reviewed}T00:00:00Z`);
    const days = Math.floor((Date.now() - reviewed) / 86_400_000);
    if (days > Number(note.dataset.staleAfterDays)) note.hidden = false;
  }
</script>
