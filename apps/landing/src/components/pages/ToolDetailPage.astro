          <MortgageTransferCalculatorComp locale={locale} client:load />
        )}
        {routeId === "toolBuyVsRent" && <BuyVsRentCalculatorComp locale={locale} client:load />}
        {routeId === "toolBorrowingCapacity" && (
          <BorrowingCapacityCalculatorComp locale={locale} client:load />
        )}
        {routeId === "toolRateRevision" && <RateRevisionCalculatorComp locale={locale} client:load />}
