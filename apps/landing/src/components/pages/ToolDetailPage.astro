const calculatorLabel = t("global.relatedContent.calculator");
const guideLabel = t("global.relatedContent.guide");

const relatedCards: FigureCard[] = related.map((relatedRouteId) => {
  const relatedKey = getToolCatalogEntry(relatedRouteId).key;

  return {
    title: t(`tools.${relatedKey}.title`),
    description: t(`tools.${relatedKey}.description`),
    href: toLocalizedPath(relatedRouteId, locale),
    figure: figureForTool(relatedRouteId),
    kind: calculatorLabel,
  };
});

if ((SAVINGS_GUIDE_RELATED_ROUTE_IDS as readonly string[]).includes(routeId)) {
  relatedCards.push({
    title: t("savingsGuide.title"),
    description: t("savingsGuide.hubDescription"),
    href: toLocalizedPath("pageSavingsGuide", locale),
    figure: PAGE_FIGURES.pageSavingsGuide,
    kind: guideLabel,
  });
}

// Every calculator but these two has a guide under it; the hero's chips jump to both.
const toolsWithoutGuide: readonly ToolRouteId[] = ["toolNetWorth", "toolSavingsRate"];
const hasGuide = !toolsWithoutGuide.includes(routeId);
const outline: OutlineEntry[] = hasGuide
  ? [
      { id: "calculator", title: calculatorLabel },
      { id: "guide", title: guideLabel },
    ]
  : [];

const alternateLinks = buildAlternateLinks(routeId);
const pageTitle = t(`tools.${key}.pageTitle`);
const pageDescription = t(`tools.${key}.pageDescription`);
const sectionTitle = t(`tools.${key}.title`);
const sectionSubtitle = t(`tools.${key}.subtitle`);
const toolsHubHref = `/${locale}/tools`;

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: pageTitle,
  url: `https://wonder.money${toLocalizedPath(routeId, locale)}`,
  applicationCategory: "FinanceApplication",
  operatingSystem: "Web",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "EUR",
  },
};
---

<ContentLayout
  title={pageTitle}
  description={pageDescription}
  alternateLinks={alternateLinks}
  layout="article"
  locale={locale}
  structuredData={schema}
>
  <article>
    <ArticleHero
      locale={locale}
      title={sectionTitle}
      dek={sectionSubtitle}
      breadcrumbs={[{ label: t("header.tools"), href: toolsHubHref }, { label: sectionTitle }]}
      outline={outline}
      figure={figureForTool(routeId)}
    />

    <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8 lg:py-16">
      <div id="calculator" class="scroll-mt-24">
        {routeId === "toolCompoundInterest" && <CompoundInterestCalculatorComp locale={locale} client:load />}
        {routeId === "toolNetWorth" && <NetWorthCalculatorComp locale={locale} client:load />}
        {routeId === "toolSavingsRate" && <SavingsRateCalculatorComp locale={locale} client:load />}
        {routeId === "toolInvestmentReturn" && (
          <>
            <section class="space-y-5">
              <h2 class="text-2xl font-bold tracking-[-0.015em] text-foreground sm:text-3xl">{t("tools.investmentReturn.projection.pastHeading")}</h2>
              <InvestmentReturnCalculatorComp locale={locale} client:load />
            </section>
            <section class="mt-16 space-y-5">
              <h2 class="text-2xl font-bold tracking-[-0.015em] text-foreground sm:text-3xl">{t("tools.investmentReturn.projection.heading")}</h2>
              <p class="max-w-[40rem] text-lg leading-[1.7] text-ink-2">{t("tools.investmentReturn.projection.intro")}</p>
              <IndexProjectionCalculator locale={locale} client:load />
            </section>
          </>
        )}
        {routeId === "toolInvestorProfile" && <InvestorProfileQuiz locale={locale} client:load />}
        {routeId === "toolDebtToIncome" && <DebtToIncomeCalculatorComp locale={locale} client:load />}
        {routeId === "toolEmergencyFund" && <EmergencyFundCalculatorComp locale={locale} client:load />}
        {routeId === "toolMortgage" && <MortgageCalculatorComp locale={locale} client:load />}
        {routeId === "toolHouseholdBudget" && <HouseholdBudgetCalculatorComp locale={locale} client:load />}
        {routeId === "toolSavingsGoal" && <SavingsGoalCalculatorComp locale={locale} client:load />}
        {routeId === "toolTermDeposit" && <TermDepositCalculatorComp locale={locale} client:load />}
        {routeId === "toolEarlyRepayment" && <EarlyRepaymentCalculatorComp locale={locale} client:load />}
