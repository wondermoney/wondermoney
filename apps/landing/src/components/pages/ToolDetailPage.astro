        </div>
      )}

      <div class="mt-12 max-w-[40rem]">
        <FinancialDisclaimer locale={locale} client:idle />
      </div>
    </div>
  </article>

  <div class="mx-auto max-w-7xl px-6 pb-16 lg:px-8">
    <CTABanner locale={locale} variant="card" client:idle {...nextStepCtaByRouteId[routeId]} />

    {relatedCards.length > 0 && (
      <section aria-labelledby="related-content" class="mt-16">
        <h2 id="related-content" class="text-base font-semibold text-foreground">{t("global.relatedContent.title")}</h2>
        <FigureCards locale={locale} cards={relatedCards} class="mt-4" />
      </section>
    )}
  </div>
</ContentLayout>
