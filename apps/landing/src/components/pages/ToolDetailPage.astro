---
import "@/styles/globals.css";
import ContentLayout from "@/layouts/ContentLayout.astro";
import CompoundInterestCalculatorComp from "@/components/calculators/CompoundInterestCalculatorComp";
import CompoundInterestGuide from "@/components/calculators/CompoundInterestGuide.astro";
import NetWorthCalculatorComp from "@/components/calculators/NetWorthCalculatorComp";
import SavingsRateCalculatorComp from "@/components/calculators/SavingsRateCalculatorComp";
import IndexProjectionCalculator from "@/components/calculators/IndexProjectionCalculator";
import InvestorProfileQuiz from "@/components/calculators/InvestorProfileQuiz";
import InvestorProfileGuide from "@/components/calculators/InvestorProfileGuide.astro";
import IndexProjectionGuide from "@/components/calculators/IndexProjectionGuide.astro";
import InvestmentReturnCalculatorComp from "@/components/calculators/InvestmentReturnCalculatorComp";
import DebtToIncomeCalculatorComp from "@/components/calculators/DebtToIncomeCalculatorComp";
import DebtToIncomeGuide from "@/components/calculators/DebtToIncomeGuide.astro";
import EmergencyFundCalculatorComp from "@/components/calculators/EmergencyFundCalculatorComp";
import EmergencyFundMethod from "@/components/calculators/EmergencyFundMethod.astro";
import MortgageCalculatorComp from "@/components/calculators/MortgageCalculatorComp";
import MortgageCalculatorGuide from "@/components/calculators/MortgageCalculatorGuide.astro";
import HouseholdBudgetCalculatorComp from "@/components/calculators/HouseholdBudgetCalculatorComp";
import HouseholdBudgetGuide from "@/components/calculators/HouseholdBudgetGuide.astro";
import SavingsGoalCalculatorComp from "@/components/calculators/SavingsGoalCalculatorComp";
import SavingsGoalGuide from "@/components/calculators/SavingsGoalGuide.astro";
import TermDepositCalculatorComp from "@/components/calculators/TermDepositCalculatorComp";
