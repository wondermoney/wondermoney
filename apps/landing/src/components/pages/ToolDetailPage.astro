          {routeId === "toolHolidayAllowance" && <AllowanceGuide locale={locale} kind="holiday" />}
          {routeId === "toolWithholdingTables" && <WithholdingTablesGuide locale={locale} />}
          {routeId === "toolUnemploymentBenefit" && <UnemploymentBenefitGuide locale={locale} />}
          {routeId === "toolSickPay" && <SickPayGuide locale={locale} />}
          {routeId === "toolDismissalCompensation" && <DismissalCompensationGuide locale={locale} />}
          {routeId === "toolPersonalLoan" && <PersonalLoanGuide locale={locale} />}
          {routeId === "toolPropertyTax" && <PropertyTaxGuide locale={locale} />}
          {routeId === "toolVehicleTax" && <VehicleTaxGuide locale={locale} />}
          {routeId === "toolPropertyCapitalGains" && <PropertyCapitalGainsGuide locale={locale} />}
          {routeId === "toolStatePension" && <StatePensionGuide locale={locale} />}
          {routeId === "toolSp500History" && <Sp500HistoryGuide locale={locale} />}
          {routeId === "toolEuribor" && <EuriborGuide locale={locale} />}
          {routeId === "toolDepositRateIndex" && <DepositRateIndexGuide locale={locale} />}
          {routeId === "toolTermDepositOffers" && <TermDepositOffersGuide locale={locale} />}
          {routeId === "toolFreeBankAccounts" && <FreeBankAccountsGuide locale={locale} />}
