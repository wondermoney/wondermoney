import MortgageTransferGuide from "@/components/calculators/MortgageTransferGuide.astro";
import BuyVsRentCalculatorComp from "@/components/calculators/BuyVsRentCalculatorComp";
import BuyVsRentGuide from "@/components/calculators/BuyVsRentGuide.astro";
import BorrowingCapacityCalculatorComp from "@/components/calculators/BorrowingCapacityCalculatorComp";
import BorrowingCapacityGuide from "@/components/calculators/BorrowingCapacityGuide.astro";
import RateRevisionCalculatorComp from "@/components/calculators/RateRevisionCalculatorComp";
import RateRevisionGuide from "@/components/calculators/RateRevisionGuide.astro";
import PersonalLoanCalculatorComp from "@/components/calculators/PersonalLoanCalculatorComp";
import CarLoanCalculatorComp from "@/components/calculators/CarLoanCalculatorComp";
import CarLoanGuide from "@/components/calculators/CarLoanGuide.astro";
import PersonalLoanGuide from "@/components/calculators/PersonalLoanGuide.astro";
import InflationCalculatorComp from "@/components/calculators/InflationCalculatorComp";
