import SavingsCertificatesCalculatorComp from "@/components/calculators/SavingsCertificatesCalculatorComp";
import SavingsCertificatesGuide from "@/components/calculators/SavingsCertificatesGuide.astro";
import PropertyTaxCalculatorComp from "@/components/calculators/PropertyTaxCalculatorComp";
import PropertyTaxGuide from "@/components/calculators/PropertyTaxGuide.astro";
import VehicleTaxCalculatorComp from "@/components/calculators/VehicleTaxCalculatorComp";
import VehicleTaxGuide from "@/components/calculators/VehicleTaxGuide.astro";
import PurchaseTaxesCalculatorComp from "@/components/calculators/PurchaseTaxesCalculatorComp";
import PurchaseTaxesGuide from "@/components/calculators/PurchaseTaxesGuide.astro";
import YouthMortgageCalculatorComp from "@/components/calculators/YouthMortgageCalculatorComp";
import YouthMortgageGuide from "@/components/calculators/YouthMortgageGuide.astro";
import NetSalaryCalculatorComp from "@/components/calculators/NetSalaryCalculatorComp";
import NetSalaryGuide from "@/components/calculators/NetSalaryGuide.astro";
import UnemploymentBenefitCalculatorComp from "@/components/calculators/UnemploymentBenefitCalculatorComp";
import UnemploymentBenefitGuide from "@/components/calculators/UnemploymentBenefitGuide.astro";
import DismissalCompensationCalculatorComp from "@/components/calculators/DismissalCompensationCalculatorComp";
import DismissalCompensationGuide from "@/components/calculators/DismissalCompensationGuide.astro";
import AllowanceCalculatorComp from "@/components/calculators/AllowanceCalculatorComp";
import AllowanceGuide from "@/components/calculators/AllowanceGuide.astro";
import WithholdingTablesComp from "@/components/calculators/WithholdingTablesComp";
import WithholdingTablesGuide from "@/components/calculators/WithholdingTablesGuide.astro";
import PropertyCapitalGainsCalculatorComp from "@/components/calculators/PropertyCapitalGainsCalculatorComp";
import PropertyCapitalGainsGuide from "@/components/calculators/PropertyCapitalGainsGuide.astro";
import CTABanner from "@/components/shared/CTABanner";
import FinancialDisclaimer from "@/components/shared/FinancialDisclaimer";
import RelatedContent from "@/components/shared/RelatedContent";
import { buildAlternateLinks, toLocalizedPath, type Lang } from "@/lib/routes";
import { getToolCatalogEntry } from "@/lib/toolsCatalog";
import { getTranslations } from "@/lib/translations";
import type { ToolRouteId } from "@/lib/pageStaticPaths";

interface Props {
  locale: Lang;
  routeId: ToolRouteId;
}

const { locale, routeId } = Astro.props;
const t = getTranslations(locale);

const { key, related } = getToolCatalogEntry(routeId);

// Tools whose closing call to action names their own next step in the app.
const nextStepCtaByRouteId: Partial<
  Record<ToolRouteId, { headline: string; description: string; ctaText?: string; ctaHref?: string }>
> = {
  toolCompoundInterest: {
    headline: t("tools.compoundInterest.nextStepHeadline"),
    description: t("tools.compoundInterest.nextStepDescription"),
    ctaText: t("tools.compoundInterest.nextStepCta"),
  },
  toolDebtToIncome: {
    headline: t("tools.debtToIncome.ctaHeadline"),
    description: t("tools.debtToIncome.ctaDescription"),
  },
  toolEmergencyFund: {
    headline: t("tools.emergencyFund.nextStepHeadline"),
    description: t("tools.emergencyFund.nextStepDescription"),
    ctaText: t("tools.emergencyFund.nextStepCta"),
  },
  toolMortgage: {
    headline: t("tools.mortgage.cta.headline"),
    description: t("tools.mortgage.cta.description"),
  },
  toolHouseholdBudget: {
    headline: t("tools.householdBudget.ctaHeadline"),
    description: t("tools.householdBudget.ctaDescription"),
  },
  toolSavingsGoal: {
    headline: t("tools.savingsGoal.nextStepHeadline"),
    description: t("tools.savingsGoal.nextStepDescription"),
    ctaText: t("tools.savingsGoal.nextStepCta"),
  },
  toolTermDeposit: {
    headline: t("tools.termDeposit.ctaHeadline"),
    description: t("tools.termDeposit.ctaDescription"),
  },
  toolEarlyRepayment: {
    headline: t("tools.earlyRepayment.cta.headline"),
    description: t("tools.earlyRepayment.cta.description"),
  },
  toolMortgageTransfer: {
    headline: t("tools.mortgageTransfer.cta.headline"),
    description: t("tools.mortgageTransfer.cta.description"),
  },
  toolBuyVsRent: {
    headline: t("tools.buyVsRent.ctaHeadline"),
    description: t("tools.buyVsRent.ctaDescription"),
  },
  toolBorrowingCapacity: {
    headline: t("tools.borrowingCapacity.nextStepHeadline"),
    description: t("tools.borrowingCapacity.nextStepDescription"),
    ctaText: t("tools.borrowingCapacity.nextStepCta"),
  },
  toolInvestmentReturn: {
    headline: t("tools.investmentReturn.projection.ctaHeadline"),
    description: t("tools.investmentReturn.projection.ctaDescription"),
    ctaText: t("tools.investmentReturn.projection.ctaText"),
  },
  toolInvestorProfile: {
    headline: t("tools.investorProfile.nextStepHeadline"),
    description: t("tools.investorProfile.nextStepDescription"),
    ctaText: t("tools.investorProfile.nextStepCta"),
    ctaHref: toLocalizedPath("featurePortfolio", locale),
  },
  toolRateRevision: {
    headline: t("tools.rateRevision.nextStepHeadline"),
    description: t("tools.rateRevision.nextStepDescription"),
    ctaText: t("tools.rateRevision.nextStepCta"),
  },
  toolCarLoan: {
    headline: t("tools.carLoan.nextStepHeadline"),
    description: t("tools.carLoan.nextStepDescription"),
    ctaText: t("tools.carLoan.nextStepCta"),
  },
  toolInflation: {
    headline: t("tools.inflation.nextStepHeadline"),
    description: t("tools.inflation.nextStepDescription"),
    ctaText: t("tools.inflation.nextStepCta"),
    ctaHref: toLocalizedPath("featurePortfolio", locale),
  },
  toolSavingsCertificates: {
    headline: t("tools.savingsCertificates.nextStepHeadline"),
    description: t("tools.savingsCertificates.nextStepDescription"),
    ctaText: t("tools.savingsCertificates.nextStepCta"),
  },
  toolPropertyTax: {
    headline: t("tools.propertyTax.nextStepHeadline"),
    description: t("tools.propertyTax.nextStepDescription"),
    ctaText: t("tools.propertyTax.nextStepCta"),
  },
  toolVehicleTax: {
    headline: t("tools.vehicleTax.nextStepHeadline"),
    description: t("tools.vehicleTax.nextStepDescription"),
    ctaText: t("tools.vehicleTax.nextStepCta"),
  },
  toolPropertyCapitalGains: {
    headline: t("tools.propertyCapitalGains.nextStepHeadline"),
    description: t("tools.propertyCapitalGains.nextStepDescription"),
    ctaText: t("tools.propertyCapitalGains.nextStepCta"),
  },
  toolPurchaseTaxes: {
    headline: t("tools.purchaseTaxes.nextStepHeadline"),
    description: t("tools.purchaseTaxes.nextStepDescription"),
    ctaText: t("tools.purchaseTaxes.nextStepCta"),
  },
  toolYouthMortgage: {
    headline: t("tools.youthMortgage.nextStepHeadline"),
    description: t("tools.youthMortgage.nextStepDescription"),
    ctaText: t("tools.youthMortgage.nextStepCta"),
  },
  toolNetSalary: {
    headline: t("tools.netSalary.nextStepHeadline"),
    description: t("tools.netSalary.nextStepDescription"),
    ctaText: t("tools.netSalary.nextStepCta"),
  },
  toolUnemploymentBenefit: {
    headline: t("tools.unemploymentBenefit.nextStepHeadline"),
    description: t("tools.unemploymentBenefit.nextStepDescription"),
    ctaText: t("tools.unemploymentBenefit.nextStepCta"),
  },
  toolDismissalCompensation: {
    headline: t("tools.dismissalCompensation.nextStepHeadline"),
    description: t("tools.dismissalCompensation.nextStepDescription"),
    ctaText: t("tools.dismissalCompensation.nextStepCta"),
  },
  toolChristmasAllowance: {
    headline: t("tools.christmasAllowance.nextStepHeadline"),
    description: t("tools.christmasAllowance.nextStepDescription"),
    ctaText: t("tools.christmasAllowance.nextStepCta"),
  },
  toolHolidayAllowance: {
    headline: t("tools.holidayAllowance.nextStepHeadline"),
    description: t("tools.holidayAllowance.nextStepDescription"),
    ctaText: t("tools.holidayAllowance.nextStepCta"),
  },
  toolWithholdingTables: {
    headline: t("tools.withholdingTables.nextStepHeadline"),
    description: t("tools.withholdingTables.nextStepDescription"),
    ctaText: t("tools.withholdingTables.nextStepCta"),
  },
  toolPersonalLoan: {
    headline: t("tools.personalLoan.nextStepHeadline"),
    description: t("tools.personalLoan.nextStepDescription"),
    ctaText: t("tools.personalLoan.nextStepCta"),
  },
};

const relatedItems = related.map((relatedRouteId) => {
  const relatedKey = getToolCatalogEntry(relatedRouteId).key;

  return {
    title: t(`tools.${relatedKey}.title`),
    description: t(`tools.${relatedKey}.description`),
    href: toLocalizedPath(relatedRouteId, locale),
    type: "calculator" as const,
  };
});

const alternateLinks = buildAlternateLinks(routeId);
const pageTitle = t(`tools.${key}.pageTitle`);
const pageDescription = t(`tools.${key}.pageDescription`);
const sectionTitle = t(`tools.${key}.title`);
const sectionSubtitle = t(`tools.${key}.subtitle`);
const toolsHubHref = `/${locale}/tools`;

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: pageTitle,
  url: `https://wonder.money${toLocalizedPath(routeId, locale)}`,
  applicationCategory: "FinanceApplication",
  operatingSystem: "Web",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "EUR",
  },
};
---

<ContentLayout
  title={pageTitle}
  description={pageDescription}
  alternateLinks={alternateLinks}
  breadcrumbs={[
    { label: t("header.tools"), href: toolsHubHref },
    { label: sectionTitle, href: toolsHubHref },
  ]}
  locale={locale}
  structuredData={schema}
>
  <section>
    <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
      {sectionTitle}
    </h1>
    <p class="mt-3 max-w-3xl text-lg text-muted-foreground">{sectionSubtitle}</p>
  </section>

  <div class="mt-8">
    {routeId === "toolCompoundInterest" && <CompoundInterestCalculatorComp locale={locale} client:load />}
    {routeId === "toolNetWorth" && <NetWorthCalculatorComp locale={locale} client:load />}
    {routeId === "toolSavingsRate" && <SavingsRateCalculatorComp locale={locale} client:load />}
    {routeId === "toolInvestmentReturn" && (
      <>
        <section class="mb-10 space-y-4">
          <h2 class="text-2xl font-semibold tracking-tight">{t("tools.investmentReturn.projection.pastHeading")}</h2>
          <InvestmentReturnCalculatorComp locale={locale} client:load />
        </section>
        <section class="space-y-4">
          <h2 class="text-2xl font-semibold tracking-tight">{t("tools.investmentReturn.projection.heading")}</h2>
          <p class="max-w-3xl text-muted-foreground">{t("tools.investmentReturn.projection.intro")}</p>
          <IndexProjectionCalculator locale={locale} client:load />
        </section>
        <IndexProjectionGuide locale={locale} />
      </>
    )}
    {routeId === "toolInvestorProfile" && <InvestorProfileQuiz locale={locale} client:load />}
    {routeId === "toolDebtToIncome" && <DebtToIncomeCalculatorComp locale={locale} client:load />}
    {routeId === "toolEmergencyFund" && <EmergencyFundCalculatorComp locale={locale} client:load />}
    {routeId === "toolMortgage" && <MortgageCalculatorComp locale={locale} client:load />}
    {routeId === "toolHouseholdBudget" && <HouseholdBudgetCalculatorComp locale={locale} client:load />}
    {routeId === "toolSavingsGoal" && <SavingsGoalCalculatorComp locale={locale} client:load />}
    {routeId === "toolTermDeposit" && <TermDepositCalculatorComp locale={locale} client:load />}
    {routeId === "toolEarlyRepayment" && <EarlyRepaymentCalculatorComp locale={locale} client:load />}
    {routeId === "toolMortgageTransfer" && (
      <MortgageTransferCalculatorComp locale={locale} client:load />
    )}
    {routeId === "toolBuyVsRent" && <BuyVsRentCalculatorComp locale={locale} client:load />}
    {routeId === "toolBorrowingCapacity" && (
      <BorrowingCapacityCalculatorComp locale={locale} client:load />
    )}
    {routeId === "toolRateRevision" && <RateRevisionCalculatorComp locale={locale} client:load />}
    {routeId === "toolCarLoan" && <CarLoanCalculatorComp locale={locale} client:load />}
    {routeId === "toolInflation" && <InflationCalculatorComp locale={locale} client:load />}
    {routeId === "toolSavingsCertificates" && (
      <SavingsCertificatesCalculatorComp locale={locale} client:load />
    )}
    {routeId === "toolPurchaseTaxes" && <PurchaseTaxesCalculatorComp locale={locale} client:load />}
    {routeId === "toolYouthMortgage" && <YouthMortgageCalculatorComp locale={locale} client:load />}
    {routeId === "toolNetSalary" && <NetSalaryCalculatorComp locale={locale} client:load />}
    {routeId === "toolChristmasAllowance" && <AllowanceCalculatorComp locale={locale} kind="christmas" client:load />}
    {routeId === "toolHolidayAllowance" && <AllowanceCalculatorComp locale={locale} kind="holiday" client:load />}
    {routeId === "toolWithholdingTables" && <WithholdingTablesComp locale={locale} client:load />}
    {routeId === "toolUnemploymentBenefit" && <UnemploymentBenefitCalculatorComp locale={locale} client:load />}
    {routeId === "toolDismissalCompensation" && <DismissalCompensationCalculatorComp locale={locale} client:load />}
    {routeId === "toolPersonalLoan" && <PersonalLoanCalculatorComp locale={locale} client:load />}
    {routeId === "toolPropertyTax" && <PropertyTaxCalculatorComp locale={locale} client:load />}
    {routeId === "toolVehicleTax" && <VehicleTaxCalculatorComp locale={locale} client:load />}
    {routeId === "toolPropertyCapitalGains" && <PropertyCapitalGainsCalculatorComp locale={locale} client:load />}
  </div>

  {routeId === "toolCompoundInterest" && <CompoundInterestGuide locale={locale} />}
  {routeId === "toolInvestorProfile" && <InvestorProfileGuide locale={locale} />}
  {routeId === "toolDebtToIncome" && <DebtToIncomeGuide locale={locale} />}
  {routeId === "toolEmergencyFund" && <EmergencyFundMethod locale={locale} />}
  {routeId === "toolMortgage" && <MortgageCalculatorGuide locale={locale} />}
  {routeId === "toolHouseholdBudget" && <HouseholdBudgetGuide locale={locale} />}
  {routeId === "toolSavingsGoal" && <SavingsGoalGuide locale={locale} />}
  {routeId === "toolTermDeposit" && <TermDepositGuide locale={locale} />}
  {routeId === "toolEarlyRepayment" && <EarlyRepaymentGuide locale={locale} />}
  {routeId === "toolMortgageTransfer" && <MortgageTransferGuide locale={locale} />}
  {routeId === "toolBuyVsRent" && <BuyVsRentGuide locale={locale} />}
  {routeId === "toolBorrowingCapacity" && <BorrowingCapacityGuide locale={locale} />}
  {routeId === "toolRateRevision" && <RateRevisionGuide locale={locale} />}
  {routeId === "toolCarLoan" && <CarLoanGuide locale={locale} />}
  {routeId === "toolInflation" && <InflationGuide locale={locale} />}
  {routeId === "toolSavingsCertificates" && <SavingsCertificatesGuide locale={locale} />}
  {routeId === "toolPurchaseTaxes" && <PurchaseTaxesGuide locale={locale} />}
  {routeId === "toolYouthMortgage" && <YouthMortgageGuide locale={locale} />}
  {routeId === "toolNetSalary" && <NetSalaryGuide locale={locale} />}
  {routeId === "toolChristmasAllowance" && <AllowanceGuide locale={locale} kind="christmas" />}
  {routeId === "toolHolidayAllowance" && <AllowanceGuide locale={locale} kind="holiday" />}
  {routeId === "toolWithholdingTables" && <WithholdingTablesGuide locale={locale} />}
  {routeId === "toolUnemploymentBenefit" && <UnemploymentBenefitGuide locale={locale} />}
  {routeId === "toolDismissalCompensation" && <DismissalCompensationGuide locale={locale} />}
  {routeId === "toolPersonalLoan" && <PersonalLoanGuide locale={locale} />}
  {routeId === "toolPropertyTax" && <PropertyTaxGuide locale={locale} />}
  {routeId === "toolVehicleTax" && <VehicleTaxGuide locale={locale} />}
  {routeId === "toolPropertyCapitalGains" && <PropertyCapitalGainsGuide locale={locale} />}

  <div class="mt-8">
    <FinancialDisclaimer locale={locale} client:idle />
  </div>

  <RelatedContent locale={locale} client:idle items={relatedItems} />
  <div class="mt-8">
    <CTABanner locale={locale} client:idle {...nextStepCtaByRouteId[routeId]} />
  </div>
</ContentLayout>
