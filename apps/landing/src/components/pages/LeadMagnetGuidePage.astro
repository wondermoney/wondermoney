---
import "@/styles/globals.css";
import ContentLayout from "@/layouts/ContentLayout.astro";
import CTABanner from "@/components/shared/CTABanner";
import ArticleHero from "@/components/shared/ArticleHero.astro";
import { buildOutline, readingMinutes, sectionNumber } from "@/lib/articleOutline";
import { PAGE_FIGURES } from "@/lib/hairline/articleFigures";
import { getTranslations } from "@/lib/translations";
import { buildAlternateLinks, toLocalizedPath } from "@/lib/routes";
import type { Lang } from "@/lib/i18nLocale";
import { leadMagnetGuide } from "@/content/leadMagnetGuide";

interface Props {
	locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const canonicalPath = toLocalizedPath("guideMoneyCheckin", locale);
const canonicalUrl = `${Astro.url.origin}${canonicalPath}`;
const alternateLinks = buildAlternateLinks("guideMoneyCheckin");

const outline = buildOutline(leadMagnetGuide.sections.map((section) => section.heading));
const numbered = outline.length > 1;
const readMinutes = readingMinutes([
	leadMagnetGuide.subtitle,
	...leadMagnetGuide.intro,
	...leadMagnetGuide.keyTakeaways,
	...leadMagnetGuide.sections.flatMap((section) => [section.heading, ...section.paragraphs]),
	...leadMagnetGuide.faqs.flatMap((item) => [item.question, item.answer]),
]);

const articleSchema = {
	"@context": "https://schema.org",
	"@type": "Article",
	headline: leadMagnetGuide.title,
	description: t("leadMagnetGuide.metaDescription"),
	url: canonicalUrl,
	publisher: {
		"@type": "Organization",
		name: "WonderMoney",
		url: "https://wonder.money",
	},
};
---

<ContentLayout
	title={t("leadMagnetGuide.metaTitle")}
	description={t("leadMagnetGuide.metaDescription")}
	canonicalUrl={canonicalUrl}
	alternateLinks={alternateLinks}
	layout="article"
	locale={locale}
	structuredData={articleSchema}
>
	<article>
		<ArticleHero
			locale={locale}
			title={leadMagnetGuide.title}
			dek={leadMagnetGuide.subtitle}
			breadcrumbs={[{ label: t("leadMagnetGuide.breadcrumbLabel") }]}
			readMinutes={readMinutes}
			outline={outline}
			figure={PAGE_FIGURES.guideMoneyCheckin}
		/>

		<div class="mx-auto max-w-7xl px-6 py-12 lg:px-8 lg:py-16">
			<div class="max-w-[40rem] space-y-10">
				<div class="prose prose-lg article-prose">
					{leadMagnetGuide.intro.map((paragraph) => <p>{paragraph}</p>)}
				</div>

				<section class="rounded-card border border-border bg-paper-2 p-5 sm:p-6">
					<h2 class="text-lg font-semibold text-foreground">
						{t("leadMagnetGuide.keyTakeawaysTitle")}
					</h2>
					<ul class="mt-3 list-disc space-y-2 pl-5 text-base leading-7 text-ink-2">
						{leadMagnetGuide.keyTakeaways.map((item) => <li>{item}</li>)}
					</ul>
				</section>

				{leadMagnetGuide.sections.map((section, index) => (
					<section class="prose prose-lg article-prose">
						<h2 id={outline[index]?.id}>
							{numbered && (
								<span aria-hidden="true" class="mb-2 block font-mono text-sm font-medium tracking-normal text-primary">
									{sectionNumber(index)}
								</span>
							)}
							{section.heading}
						</h2>
						{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
					</section>
				))}

				<section class="rounded-card border border-border bg-background p-5 sm:p-6">
					<h2 class="text-lg font-semibold text-foreground">{t("leadMagnetGuide.faqTitle")}</h2>
					<div class="mt-3 space-y-3">
						{leadMagnetGuide.faqs.map((item) => (
							<details class="rounded-md border border-border p-3">
								<summary class="cursor-pointer font-medium text-foreground">{item.question}</summary>
								<p class="mt-2 text-sm leading-6 text-muted-foreground">{item.answer}</p>
							</details>
						))}
					</div>
				</section>
			</div>
		</div>
	</article>

	<div class="mx-auto max-w-7xl px-6 pb-16 lg:px-8">
		<CTABanner locale={locale} variant="card" client:idle />
	</div>
</ContentLayout>
