---
import "@/styles/globals.css";
import ContentLayout from "@/layouts/ContentLayout.astro";
import CTABanner from "@/components/shared/CTABanner";
import ArticleHero from "@/components/shared/ArticleHero.astro";
import FigureCards from "@/components/shared/FigureCards.astro";
import ArticleSection from "@/components/learning/ArticleSection.astro";
import GlossaryFormula from "@/components/learning/GlossaryFormula.astro";
import DataTable from "@/components/learning/DataTable.astro";
import ReferenceList from "@/components/learning/ReferenceList.astro";
import { getEntry, render } from "astro:content";
import { buildOutline, readingMinutes } from "@/lib/articleOutline";
import type { GlossaryTermEntry } from "@/lib/contentCollections";
import { glossaryTermCards } from "@/lib/figureCards";
import { hasFormulaContent } from "@/lib/glossaryFormula";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
  term: GlossaryTermEntry;
  alternateLinks: Array<{ hrefLang: string; href: string }>;
}

const { term, locale, alternateLinks } = Astro.props as Props;
const t = getTranslations(locale);

const canonicalPath = `/${locale}/glossary/${term.slug}`;
const canonicalUrl = `${Astro.url.origin}${canonicalPath}`;

const glossaryPrefix = `/${locale}/glossary`;
const primaryDefinition = term.plainDefinition || term.definition;
const technicalDefinition = term.technicalDefinition;
const whyItMatters = term.whyItMatters;
const miniExample = term.miniExample;
const hasStructuredExample = Boolean(miniExample);

const miniTableColumns = term.miniTable?.columns ?? [];
const miniTableRows = (term.miniTable?.rows ?? []).filter((row) => row.length > 0);

const normalizedReferences = term.references.filter(
  (reference) => Boolean(reference.title || reference.url || reference.publisher),
);

const relatedTerms = term.relatedTerms;

const relatedLinks = glossaryTermCards({
  locale,
  t,
  relatedCalculator: term.relatedCalculator,
  relatedGuide: { slug: term.relatedGuideSlug, title: term.relatedGuideTitle },
});
// "Keep reading" holds three cards, as under a guide; the other calculators follow as chips.
const KEEP_READING = 3;
const relatedCards = relatedLinks.slice(0, KEEP_READING);
const moreTools = relatedLinks.slice(KEEP_READING);

// The Markdown body is the explanation; a technical definition takes its place.
const entry = await getEntry("glossary", term.id);
if (!entry) throw new Error(`No glossary term at src/content/glossary/${term.id}.md`);
const { Content: Explanation } = await render(entry);
const showExplanation = !technicalDefinition && Boolean(term.bodyText);
const exampleText = miniExample || term.example;

// The body's titled sections, in reading order; numbered when there are two or more.
type SectionKey = "whyItMatters" | "technicalDefinition" | "explanation" | "formula" | "example" | "miniTable";
const sectionTitles: Array<[SectionKey, string]> = [];
if (whyItMatters) sectionTitles.push(["whyItMatters", t("glossary.term.whyItMatters")]);
if (technicalDefinition) sectionTitles.push(["technicalDefinition", t("glossary.term.technicalDefinition")]);
if (showExplanation) sectionTitles.push(["explanation", t("glossary.term.explanation")]);
if (hasFormulaContent(term.formula)) sectionTitles.push(["formula", term.formula.title || t("glossary.term.formula")]);
if (exampleText) sectionTitles.push(["example", hasStructuredExample ? t("glossary.term.miniExample") : t("glossary.term.example")]);
if (miniTableRows.length > 0) sectionTitles.push(["miniTable", term.miniTable?.title || t("glossary.term.miniTable")]);

const outline = buildOutline(sectionTitles.map(([, title]) => title));
const numbered = outline.length > 1;
const section = (key: SectionKey) => {
  const index = sectionTitles.findIndex(([candidate]) => candidate === key);
  return index < 0 ? undefined : { entry: outline[index], index, numbered };
};

const readMinutes = readingMinutes([
  primaryDefinition ?? "",
  whyItMatters ?? "",
  technicalDefinition ?? "",
  showExplanation ? term.bodyText : "",
  term.formula?.notes ?? "",
  exampleText ?? "",
]);

const categoryLabel = term.category ? t(`category.${term.category}`, { defaultValue: term.category }) : undefined;

const definedTermSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  name: term.term,
  description: primaryDefinition,
  url: `https://wonder.money${glossaryPrefix}/${term.slug}`,
  inDefinedTermSet: {
    "@type": "DefinedTermSet",
    name: t("glossary.hub.title"),
    url: `https://wonder.money${glossaryPrefix}`,
  },
};

const whyItMattersSection = section("whyItMatters");
const technicalSection = section("technicalDefinition");
const explanationSection = section("explanation");
const formulaSection = section("formula");
const exampleSection = section("example");
const miniTableSection = section("miniTable");
---

<ContentLayout
  title={term.seoTitle || `${term.term} — WonderMoney`}
  description={term.seoDescription || primaryDefinition}
  canonicalUrl={canonicalUrl}
  layout="article"
  locale={locale}
  alternateLinks={alternateLinks}
  structuredData={definedTermSchema}
>
  <article>
    <ArticleHero
      locale={locale}
      title={term.term}
      breadcrumbs={[
        { label: t("header.glossary"), href: glossaryPrefix },
        ...(categoryLabel ? [{ label: categoryLabel }] : []),
      ]}
      readMinutes={readMinutes}
      outline={outline}
    />

    <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8 lg:py-16">
      <div class="max-w-[40rem] space-y-10">
        {primaryDefinition && (
          <div class="prose prose-lg article-prose">
            <p class="text-foreground">{primaryDefinition}</p>
          </div>
        )}

        {whyItMattersSection && (
          <ArticleSection {...whyItMattersSection}>
            <p>{whyItMatters}</p>
          </ArticleSection>
        )}

        {technicalSection && (
          <ArticleSection {...technicalSection}>
            <p>{technicalDefinition}</p>
          </ArticleSection>
        )}

        {explanationSection && (
          <ArticleSection {...explanationSection}>
            <Explanation />
          </ArticleSection>
        )}

        {formulaSection && (
          <ArticleSection {...formulaSection}>
            <GlossaryFormula formula={term.formula} />
          </ArticleSection>
        )}

        {exampleSection && (
          <ArticleSection {...exampleSection}>
            <p>{exampleText}</p>
          </ArticleSection>
        )}

        {miniTableSection && (
          <ArticleSection {...miniTableSection}>
            <div class="not-prose">
              <DataTable columns={miniTableColumns} rows={miniTableRows} />
            </div>
          </ArticleSection>
        )}

        {normalizedReferences.length > 0 && (
          <ReferenceList title={t("glossary.term.references")} references={normalizedReferences} />
        )}
      </div>

      {relatedTerms.length > 0 && (
        <section class="mt-12 max-w-[40rem]">
          <h2 class="text-lg font-semibold text-foreground">{t("glossary.term.relatedTerms")}</h2>
          <ul role="list" class="mt-4 flex flex-wrap gap-2.5">
            {relatedTerms.map((related) => (
              <li class="min-w-0">
                <a
                  href={`${glossaryPrefix}/${related.slug}`}
                  class="inline-flex min-h-10 items-center rounded-full border border-border bg-card px-3.5 py-1.5 text-sm text-foreground transition-colors hover:border-primary/40 hover:text-primary"
                >
                  {related.term}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </article>

  <div class="mx-auto max-w-7xl px-6 pb-16 lg:px-8">
    <CTABanner locale={locale} variant="card" client:idle />

    {relatedCards.length > 0 && (
      <section aria-labelledby="keep-reading" class="mt-16">
        <h2 id="keep-reading" class="text-base font-semibold text-foreground">{t("article.keepReading")}</h2>
        <FigureCards locale={locale} cards={relatedCards} class="mt-4" />
        {moreTools.length > 0 && (
          <div class="mt-8">
            <h3 class="text-sm font-semibold text-foreground">{t("header.tools")}</h3>
            <ul role="list" class="mt-3 flex flex-wrap gap-2.5">
              {moreTools.map((tool) => (
                <li class="min-w-0">
                  <a
                    href={tool.href}
                    class="inline-flex min-h-10 items-center rounded-full border border-border bg-card px-3.5 py-1.5 text-sm text-foreground transition-colors hover:border-primary/40 hover:text-primary"
                  >
                    {tool.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )}
  </div>
</ContentLayout>
