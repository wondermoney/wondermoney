---
import { toIntlLocale } from "@/lib/numberFormat";
import "@/styles/globals.css";
import { PortableText } from "astro-portabletext";
import ContentLayout from "@/layouts/ContentLayout.astro";
import ArticleHero from "@/components/shared/ArticleHero.astro";
import ArticleSection from "@/components/learning/ArticleSection.astro";
import ReferenceList from "@/components/learning/ReferenceList.astro";
import DataTable from "@/components/learning/DataTable.astro";
import { buildOutline, portableTextToPlain, readingMinutes } from "@/lib/articleOutline";
import { PAGE_FIGURES } from "@/lib/hairline/articleFigures";
import type { Lang } from "@/lib/i18nLocale";
import type { PortableTextBlock } from "@/lib/learningContent";
import type { MonthlyContent } from "@/lib/pageStaticPaths";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
  item: MonthlyContent;
}

const { locale, item: monthlyItem } = Astro.props;
const t = getTranslations(locale);
const learnPrefix = `/${locale}/learn`;
const monthlyPrefix = `${learnPrefix}/monthly`;

const monthYearLabel = (() => {
  if (!monthlyItem.year || !monthlyItem.month) {
    return null;
  }

  return new Date(monthlyItem.year, monthlyItem.month - 1, 1).toLocaleDateString(toIntlLocale(locale), {
    year: "numeric",
    month: "long",
  });
})();

const publishedLabel = monthlyItem.publishedAt
  ? new Date(monthlyItem.publishedAt).toLocaleDateString(toIntlLocale(locale), {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : null;

const chartSummary = monthlyItem.trendChartConfig?.series ?? [];
const deltaRows = (monthlyItem.changeVsPrevious ?? []).filter((entry) => Boolean(entry.metric));
const references = monthlyItem.references ?? monthlyItem.dataSources ?? [];

const seriesTitle = t("resources.links.monthly.title");
const title = monthlyItem.title || seriesTitle;
const whatChanged = monthlyItem.whatChanged ?? [];
const whoShouldCare = monthlyItem.whoShouldCare ?? [];
const bodyBlocks = Array.isArray(monthlyItem.body) ? (monthlyItem.body as PortableTextBlock[]) : [];

// The indicator sections, in reading order; numbered when there are two or more.
type SectionKey = "methodology" | "snapshot" | "change" | "whatChanged" | "whoShouldCare" | "trend";
const sectionTitles: Array<[SectionKey, string]> = [];
if (monthlyItem.methodology) sectionTitles.push(["methodology", t("learn.monthly.methodology")]);
if (monthlyItem.snapshotTable) sectionTitles.push(["snapshot", monthlyItem.snapshotTable.title || t("learn.monthly.snapshotTable")]);
if (deltaRows.length > 0) sectionTitles.push(["change", t("learn.monthly.changeVsPrevious")]);
if (whatChanged.length > 0) sectionTitles.push(["whatChanged", t("learn.monthly.whatChanged")]);
if (whoShouldCare.length > 0) sectionTitles.push(["whoShouldCare", t("learn.monthly.whoShouldCare")]);
if (chartSummary.length > 0) sectionTitles.push(["trend", monthlyItem.trendChartConfig?.title || t("learn.monthly.trendChart")]);

const outline = buildOutline(sectionTitles.map(([, sectionTitle]) => sectionTitle));
const section = (key: SectionKey) => {
  const index = sectionTitles.findIndex(([candidate]) => candidate === key);
  return index < 0 ? undefined : { entry: outline[index], index, numbered: outline.length > 1 };
};
const methodologySection = section("methodology");
const snapshotSection = section("snapshot");
const changeSection = section("change");
const whatChangedSection = section("whatChanged");
const whoShouldCareSection = section("whoShouldCare");
const trendSection = section("trend");

const readMinutes = readingMinutes([
  monthlyItem.excerpt ?? "",
  monthlyItem.methodology ?? "",
  ...deltaRows.map((entry) => `${entry.metric} ${entry.note ?? ""}`),
  ...whatChanged.map((change) => `${change.title ?? ""} ${change.detail ?? ""}`),
  ...whoShouldCare,
  portableTextToPlain(bodyBlocks),
]);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: monthlyItem.title,
  description: monthlyItem.seoDescription || monthlyItem.excerpt,
  url: `https://wonder.money${monthlyPrefix}/${monthlyItem.slug}`,
  datePublished: monthlyItem.publishedAt,
  publisher: {
    "@type": "Organization",
    name: "WonderMoney",
    url: "https://wonder.money",
  },
  ...(monthlyItem.ogImageUrl ? { image: monthlyItem.ogImageUrl } : {}),
};
---

<ContentLayout
  title={monthlyItem.seoTitle || `${title} - WonderMoney`}
  description={monthlyItem.seoDescription || monthlyItem.excerpt || ""}
  ogImage={monthlyItem.ogImageUrl}
  ogType="article"
  layout="article"
  locale={locale}
  structuredData={articleSchema}
>
  <article>
    <ArticleHero
      locale={locale}
      title={title}
      dek={monthlyItem.excerpt}
      breadcrumbs={[
        { label: t("header.learn"), href: learnPrefix },
        { label: seriesTitle, href: monthlyPrefix },
      ]}
      readMinutes={readMinutes}
      outline={outline}
      figure={PAGE_FIGURES.monthlyHub}
    >
      {(monthYearLabel || publishedLabel) && (
        <p class="mt-5 text-sm text-muted-foreground">
          {monthYearLabel && (
            <time datetime={`${monthlyItem.year}-${String(monthlyItem.month).padStart(2, "0")}`}>{monthYearLabel}</time>
          )}
          {monthYearLabel && publishedLabel && <span aria-hidden="true"> · </span>}
          {publishedLabel && <time datetime={monthlyItem.publishedAt}>{publishedLabel}</time>}
        </p>
      )}
    </ArticleHero>

    <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8 lg:py-16">
      <div class="max-w-[40rem] space-y-10">
        {methodologySection && (
          <ArticleSection {...methodologySection}>
            <p>{monthlyItem.methodology}</p>
          </ArticleSection>
        )}

        {snapshotSection && (
          <ArticleSection {...snapshotSection}>
            <div class="not-prose">
              <DataTable
                columns={monthlyItem.snapshotTable?.columns ?? []}
                rows={monthlyItem.snapshotTable?.rows ?? []}
              />
            </div>
          </ArticleSection>
        )}

        {changeSection && (
          <ArticleSection {...changeSection}>
            <ul>
              {deltaRows.map((entry) => (
                <li>
                  <strong>{entry.metric}:</strong>{" "}
                  {entry.delta ?? 0}
                  {entry.unit ? ` ${entry.unit}` : ""}
                  {entry.note ? ` - ${entry.note}` : ""}
                </li>
              ))}
            </ul>
          </ArticleSection>
        )}

        {whatChangedSection && (
          <ArticleSection {...whatChangedSection}>
            {whatChanged.map((change) => (
              <>
                {change.title && <h3>{change.title}</h3>}
                {change.detail && <p>{change.detail}</p>}
              </>
            ))}
          </ArticleSection>
        )}

        {whoShouldCareSection && (
          <ArticleSection {...whoShouldCareSection}>
            <ul>
              {whoShouldCare.map((entry) => (
                <li>{entry}</li>
              ))}
            </ul>
          </ArticleSection>
        )}

        {trendSection && (
          <ArticleSection {...trendSection}>
            <p>
              {t("learn.monthly.chartType")}: {monthlyItem.trendChartConfig?.chartType || "line"}
            </p>
            <ul>
              {chartSummary.map((series) => (
                <li>
                  <strong>{series.label}:</strong>{" "}
                  {(series.values ?? []).join(", ")}
                </li>
              ))}
            </ul>
          </ArticleSection>
        )}

        {bodyBlocks.length > 0 && (
          <section class="prose prose-lg article-prose">
            <PortableText value={[...bodyBlocks]} />
          </section>
        )}

        <ReferenceList title={t("glossary.term.references")} references={references} />

        {monthlyItem.dataSources && monthlyItem.dataSources.length > 0 && (
          <ReferenceList title={t("learn.monthly.dataSources")} references={monthlyItem.dataSources} />
        )}
      </div>
    </div>
  </article>
</ContentLayout>
