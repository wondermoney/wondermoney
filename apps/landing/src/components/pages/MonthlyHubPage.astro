---
import { toIntlLocale } from "@/lib/numberFormat";
import "@/styles/globals.css";
import ContentLayout from "@/layouts/ContentLayout.astro";
import { sanityClient } from "sanity:client";
import type { Lang } from "@/lib/i18nLocale";
import { buildAlternateLinksForPath } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

type MonthlyListItem = {
  title?: string;
  slug?: string;
  excerpt?: string;
  year?: number;
  month?: number;
  publishedAt?: string;
  contentStatus?: string;
};

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const learnPrefix = `/${locale}/learn`;
const monthlyPrefix = `${learnPrefix}/monthly`;
const alternateLinks = buildAlternateLinksForPath((lang) => `/${lang}/learn/monthly`);

const monthlyItems = (await sanityClient.fetch(
  `*[_type == "monthlyContent" && locale == $locale] | order(year desc, month desc) {
    title,
    "slug": slug.current,
    excerpt,
    year,
    month,
    publishedAt,
    contentStatus
  }`,
  { locale },
)) as MonthlyListItem[];

const validMonthlyItems = monthlyItems.filter((item) => Boolean(item.slug?.trim() && item.title?.trim()));

const monthYearLabel = (year?: number, month?: number) => {
  if (!year || !month) {
    return null;
  }

  const dateValue = new Date(year, month - 1, 1);
  return dateValue.toLocaleDateString(toIntlLocale(locale), {
    year: "numeric",
    month: "long",
  });
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: locale === "pt" ? "Atualizacoes Mensais" : "Monthly Updates",
  description:
    locale === "pt"
      ? "Atualizacoes mensais com contexto, metodologia e principais mudancas de mercado."
      : "Monthly updates with context, methodology, and key market changes.",
  url: `https://wonder.money${monthlyPrefix}`,
  numberOfItems: validMonthlyItems.length,
  itemListElement: validMonthlyItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.title,
    url: `https://wonder.money${monthlyPrefix}/${item.slug}`,
  })),
};
---

<ContentLayout
  title={locale === "pt" ? "Aprenda - Atualizacoes Mensais - WonderMoney" : "Learn - Monthly Updates - WonderMoney"}
  description={locale === "pt"
    ? "Acompanha as atualizacoes mensais com metodologia, fontes e principais mudancas nos indicadores."
    : "Follow monthly updates with methodology, sources, and key indicator changes."}
  alternateLinks={alternateLinks}
  breadcrumbs={[
    { label: locale === "pt" ? "Aprenda" : "Learn", href: learnPrefix },
    { label: locale === "pt" ? "Mensal" : "Monthly", href: "#" },
  ]}
  locale={locale}
  structuredData={itemListSchema}
>
  <section>
    <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
      {locale === "pt" ? "Atualizacoes Mensais" : "Monthly Updates"}
    </h1>
    <p class="mt-3 max-w-3xl text-lg text-muted-foreground">
      {locale === "pt"
        ? "Relatorios mensais com metodologia, fontes de dados e o que mudou face ao periodo anterior."
        : "Monthly reports with methodology, data sources, and what changed versus the previous period."}
    </p>
  </section>

  {
    validMonthlyItems.length === 0 ? (
      <div class="mt-12 rounded-card border border-border bg-paper-2 p-12 text-center">
        <p class="text-lg text-muted-foreground">
          {locale === "pt" ? "Atualizacoes mensais em breve." : "Monthly updates coming soon."}
        </p>
      </div>
    ) : (
      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
        {validMonthlyItems.map((item) => (
          <a
            href={`${monthlyPrefix}/${item.slug}`}
            class="group rounded-card border border-border bg-background p-6 transition-colors hover:border-primary/40 hover:bg-accent"
          >
            {monthYearLabel(item.year, item.month) && (
              <p class="text-sm text-muted-foreground">
                <time datetime={`${item.year}-${String(item.month).padStart(2, "0")}`}>{monthYearLabel(item.year, item.month)}</time>
              </p>
            )}
            <h2 class="mt-2 text-xl font-semibold text-foreground group-hover:text-primary">
              {item.title || (locale === "pt" ? "Sem titulo" : "Untitled")}
            </h2>
            {item.excerpt && <p class="mt-3 line-clamp-3 text-sm leading-6 text-muted-foreground">{item.excerpt}</p>}
            {item.publishedAt && (
              <p class="mt-3 text-xs text-muted-foreground">
                {new Date(item.publishedAt).toLocaleDateString(toIntlLocale(locale), {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </p>
            )}
            <span class="mt-4 inline-block text-sm font-medium text-primary underline underline-offset-4 decoration-primary/40 group-hover:opacity-80">
              {t("learn.monthlySeries.readUpdate")}
            </span>
          </a>
        ))}
      </div>
    )
  }
</ContentLayout>
