---
import { toIntlLocale } from "@/lib/numberFormat";
import "@/styles/globals.css";
import ContentLayout from "@/layouts/ContentLayout.astro";
import ArticleHero from "@/components/shared/ArticleHero.astro";
import FigureCards from "@/components/shared/FigureCards.astro";
import { PAGE_FIGURES } from "@/lib/hairline/articleFigures";
import { sanityClient } from "sanity:client";
import type { Lang } from "@/lib/i18nLocale";
import { buildAlternateLinksForPath } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

type MonthlyListItem = {
  title?: string;
  slug?: string;
  excerpt?: string;
  year?: number;
  month?: number;
  publishedAt?: string;
  contentStatus?: string;
};

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const learnPrefix = `/${locale}/learn`;
const monthlyPrefix = `${learnPrefix}/monthly`;
const alternateLinks = buildAlternateLinksForPath((lang) => `/${lang}/learn/monthly`);

const monthlyItems = (await sanityClient.fetch(
  `*[_type == "monthlyContent" && locale == $locale] | order(year desc, month desc) {
    title,
    "slug": slug.current,
    excerpt,
    year,
    month,
    publishedAt,
    contentStatus
  }`,
  { locale },
)) as MonthlyListItem[];

const validMonthlyItems = monthlyItems.filter((item) => Boolean(item.slug?.trim() && item.title?.trim()));

const monthYearLabel = (year?: number, month?: number) => {
  if (!year || !month) {
    return null;
  }

  const dateValue = new Date(year, month - 1, 1);
  return dateValue.toLocaleDateString(toIntlLocale(locale), {
    year: "numeric",
    month: "long",
  });
};

const title = t("resources.links.monthly.title");
const dek = t("resources.links.monthly.description");

const cards = validMonthlyItems.map((item) => ({
  href: `${monthlyPrefix}/${item.slug}`,
  title: item.title as string,
  description: item.excerpt,
  figure: PAGE_FIGURES.monthlyHub,
  kind: monthYearLabel(item.year, item.month) ?? undefined,
}));

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: title,
  description: dek,
  url: `https://wonder.money${monthlyPrefix}`,
  numberOfItems: validMonthlyItems.length,
  itemListElement: validMonthlyItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.title,
    url: `https://wonder.money${monthlyPrefix}/${item.slug}`,
  })),
};
---

<ContentLayout
  title={`${t("header.learn")} - ${title} - WonderMoney`}
  description={t("learn.monthlySeries.description")}
  alternateLinks={alternateLinks}
  layout="article"
  locale={locale}
  structuredData={itemListSchema}
>
  <ArticleHero
    locale={locale}
    title={title}
    dek={dek}
    breadcrumbs={[{ label: t("header.learn"), href: learnPrefix }, { label: title }]}
    figure={PAGE_FIGURES.monthlyHub}
  />

  <div class="mx-auto max-w-7xl px-6 pb-16 pt-10 lg:px-8">
    {
      cards.length === 0 ? (
        <p class="max-w-[40rem] rounded-card border border-border bg-paper-2 p-8 text-lg text-muted-foreground">
          {t("learn.monthly.comingSoon")}
        </p>
      ) : (
        <FigureCards locale={locale} cards={cards} headingLevel={2} />
      )
    }
  </div>
</ContentLayout>
