---
import { formatMonthYear } from "@/lib/numberFormat";
import "@/styles/globals.css";
import ContentLayout from "@/layouts/ContentLayout.astro";
import CTABanner from "@/components/shared/CTABanner";
import EmailCaptureForm from "@/components/shared/EmailCaptureForm";
import ArticleHero from "@/components/shared/ArticleHero.astro";
import FigureCards from "@/components/shared/FigureCards.astro";
import GuideBody from "@/components/learning/GuideBody.astro";
import { getEntry, render } from "astro:content";
import { readingMinutes } from "@/lib/articleOutline";
import { getGuides, type GuideEntry } from "@/lib/contentCollections";
import { guideKeepReading } from "@/lib/figureCards";
import { figureForGuide } from "@/lib/hairline/articleFigures";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
  guide: GuideEntry;
  alternateLinks: Array<{ hrefLang: string; href: string }>;
}

const { guide, locale, alternateLinks } = Astro.props;
const t = getTranslations(locale);

const canonicalPath = `/${locale}/learn/${guide.slug}`;
const canonicalUrl = `${Astro.url.origin}${canonicalPath}`;

const learnPrefix = `/${locale}/learn`;
const glossaryPrefix = `/${locale}/glossary`;

const formatDate = (dateValue?: string) => (dateValue ? formatMonthYear(locale, new Date(dateValue)) : null);
const publishedDate = formatDate(guide.publishedAt);
const reviewedDate = formatDate(guide.lastReviewedAt);

const entry = await getEntry("guides", guide.id);
if (!entry) throw new Error(`No guide at src/content/guides/${guide.id}.md`);
const { Content } = await render(entry);

const readMinutes = readingMinutes([guide.excerpt, guide.bodyText]);

const glossaryTerms = guide.relatedTerms;

const siblings = (await getGuides()).filter((sibling) => sibling.locale === locale && sibling.slug !== guide.slug);
const keepReading = guideKeepReading({
  locale,
  t,
  relatedCalculators: guide.relatedCalculators,
  category: guide.category,
  siblings,
});

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: guide.title,
  description: guide.seoDescription || guide.excerpt,
  url: canonicalUrl,
  datePublished: guide.publishedAt,
  publisher: {
    "@type": "Organization",
    name: "WonderMoney",
    url: "https://wonder.money",
  },
  ...(guide.ogImageUrl && { image: guide.ogImageUrl }),
};
---

<ContentLayout
  title={guide.seoTitle || `${guide.title} — WonderMoney`}
  description={guide.seoDescription || guide.excerpt || ""}
  ogImage={guide.ogImageUrl}
  ogType="article"
  canonicalUrl={canonicalUrl}
  layout="article"
  locale={locale}
  alternateLinks={alternateLinks}
  structuredData={articleSchema}
>
  <article>
    <ArticleHero
      locale={locale}
      title={guide.title}
      dek={guide.excerpt}
      breadcrumbs={[
        { label: t("header.learn"), href: learnPrefix },
        ...(guide.category ? [{ label: t(`category.${guide.category}`, { defaultValue: guide.category }) }] : []),
      ]}
      readMinutes={readMinutes}
      figure={figureForGuide(guide.slug)}
    >
      {(publishedDate || reviewedDate) && (
        <p class="mt-5 text-sm text-muted-foreground">
          {publishedDate && <time datetime={guide.publishedAt}>{publishedDate}</time>}
          {publishedDate && reviewedDate && <span aria-hidden="true"> · </span>}
          {reviewedDate && (
            <span>
              {t("learn.guide.reviewed")}: <time datetime={guide.lastReviewedAt}>{reviewedDate}</time>
            </span>
          )}
        </p>
      )}
    </ArticleHero>

    <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8 lg:py-16">
      {guide.bodyText && (
        <GuideBody references={guide.references}>
          <Content />
        </GuideBody>
      )}

      {glossaryTerms.length > 0 && (
        <section class="mt-12 max-w-[40rem]">
          <h2 class="text-lg font-semibold text-foreground">{t("learn.guide.glossaryTerms")}</h2>
          <ul role="list" class="mt-4 flex flex-wrap gap-2.5">
            {glossaryTerms.map((term) => (
              <li class="min-w-0">
                <a
                  href={`${glossaryPrefix}/${term.slug}`}
                  class="inline-flex min-h-10 items-center rounded-full border border-border bg-card px-3.5 py-1.5 text-sm text-foreground transition-colors hover:border-primary/40 hover:text-primary"
                >
                  {term.term}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </article>

  <div class="mx-auto max-w-7xl px-6 pb-16 lg:px-8">
    <CTABanner locale={locale} variant="card" client:idle />

    {keepReading.length > 0 && (
      <section aria-labelledby="keep-reading" class="mt-16">
        <h2 id="keep-reading" class="text-base font-semibold text-foreground">{t("article.keepReading")}</h2>
        <FigureCards locale={locale} cards={keepReading} class="mt-4" />
      </section>
    )}

    <div class="mt-16">
      <EmailCaptureForm locale={locale} source="guide-page" variant="inline" client:idle />
    </div>
  </div>
</ContentLayout>
