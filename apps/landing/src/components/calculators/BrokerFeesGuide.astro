---
// Prerendered explanation for the broker fee comparison: how to read the table, a worked example
// computed with the same functions the calculator runs (brokerFeesGuide.ts), the method, what it
// leaves out and the tools to go on with, on the guide building blocks (guideBlocks.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildBrokerFeesGuide } from "./brokerFeesGuide";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.brokerFees.guide.${key}`;

const guide = buildBrokerFeesGuide(locale);
const { values } = guide;

// Each item is read through t() with the example's values, so a limit can quote the assumptions.
const limits = Object.keys(t<Record<string, string>>(k("limits.items"), { returnObjects: true })).map((item) =>
  t(k(`limits.items.${item}`), values),
);

const related = [
  { key: "compound", href: toLocalizedPath("toolCompoundInterest", locale) },
  { key: "return", href: toLocalizedPath("toolInvestmentReturn", locale) },
  { key: "profile", href: toLocalizedPath("toolInvestorProfile", locale) },
  { key: "netWorth", href: toLocalizedPath("toolNetWorth", locale) },
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(k("read.title"))}</h2>
    <p>{t(k("read.what"))}</p>
    <p>{t(k("read.protection"))}</p>
    <p>{t(k("read.notRec"))}</p>
  </section>

  <section>
    <h2>{t(k("example.title"))}</h2>
    <p>{t(k("example.setup"), values)}</p>
    <p>{t(k("example.bank"), values)}</p>
    <GuideFigures items={guide.bankFlow} operators={guide.flowOperators} caption={values.bank} />
    <p>{t(k("example.online"), values)}</p>
    <GuideFigures items={guide.onlineFlow} operators={guide.flowOperators} caption={values.online} />
    <p>{t(k("example.takeaway"), values)}</p>
  </section>

  <section>
    <h2>{t(k("method.title"))}</h2>
    <p>{t(k("method.intro"), values)}</p>
    <GuideTermList items={guide.steps} />
    <p>{guide.stepsNote}</p>
  </section>

  <section>
    <h2>{t(k("limits.title"))}</h2>
    <ul class="list-disc space-y-2 pl-6">
      {limits.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section>
    <h2>{t(k("related.title"))}</h2>
    <ul class="space-y-3">
      {
        related.map((item) => (
          <li>
            <a href={item.href}>{t(k(`related.${item.key}Link`))}</a>
            <p>{t(k(`related.${item.key}Body`))}</p>
          </li>
        ))
      }
    </ul>
  </section>
</ToolGuide>
