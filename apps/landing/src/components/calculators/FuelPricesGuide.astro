---
// Prerendered explanation for the fuel price page: how to read the averages and the cost estimate,
// a worked example computed from the same function the calculator runs, the method, DGEG as the
// source with its terms and dates, what the figures leave out (including that nothing is
// forecast), and the tools to go on with. The figures, the formulas and the term lists are
// built in energyGuides.ts.
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildFuelPricesGuide } from "./energyGuides";
import {
  FUEL_PRICES_SOURCE,
  computeFuelCost,
  fuelCostExample,
  fuelPriceSummaries,
} from "@/lib/calculators/fuelCost";
import { FUEL_STATIONS_SOURCE } from "@/lib/calculators/fuelStations";
import { formatMoney, formatNumber, formatPercent } from "@/lib/numberFormat";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.fuelPrices.guide.${key}`;

const example = fuelCostExample();
const outcome = computeFuelCost(example);
if (!outcome.ok) throw new Error("The fuel cost worked example has invalid inputs");
const { result } = outcome;
const trips = computeFuelCost({ ...example, period: "trip", distance: 40, tripsPerMonth: 20 });
if (!trips.ok) throw new Error("The fuel cost trip example has invalid inputs");
const [diesel, gasoline] = fuelPriceSummaries();

const euro = (value: number, decimals = 2) => formatMoney(locale, value, { decimals });
const values = {
  distance: `${formatNumber(locale, example.distance)} km`,
  consumption: `${formatNumber(locale, example.consumption, 1)} L/100 km`,
  price: `${euro(example.price, 3)}/L`,
  litres: `${formatNumber(locale, result.monthlyLitres, 1)} L`,
  monthly: euro(result.monthly),
  yearly: euro(result.yearly, 0),
  per100: euro(result.per100Km),
  tripCost: euro(trips.result.cost),
  tripMonthly: euro(trips.result.monthly),
  dieselChange: formatPercent(locale, diesel.changePercent, { decimals: 1, sign: "always" }),
  gasolineChange: formatPercent(locale, gasoline.changePercent, { decimals: 1, sign: "always" }),
  asOf: FUEL_PRICES_SOURCE.asOf,
  fetched: FUEL_PRICES_SOURCE.fetchedOn,
  first: FUEL_PRICES_SOURCE.firstDate,
  stationsDate: FUEL_STATIONS_SOURCE.fetchedAt.slice(0, 10),
  stationsTime: FUEL_STATIONS_SOURCE.fetchedAt.slice(11, 16),
  stationsDistrict: FUEL_STATIONS_SOURCE.top.district,
  stationsMunicipality: FUEL_STATIONS_SOURCE.top.municipality,
};

const guide = buildFuelPricesGuide(locale, values);

const related = [
  { key: "householdBudget", href: toLocalizedPath("toolHouseholdBudget", locale) },
  { key: "carLoan", href: toLocalizedPath("toolCarLoan", locale) },
  { key: "vehicleTax", href: toLocalizedPath("toolVehicleTax", locale) },
] as const;

---

<ToolGuide>
  <section>
    <h2>{t(k("read.title"))}</h2>
    <GuideTermList items={guide.readTerms} />
  </section>

  <section>
    <h2>{t(k("example.title"))}</h2>
    <p>{t(k("example.setup"), values)}</p>
    <GuideFigures items={guide.flow} operators={guide.flowOperators} />
    <p>{t(k("example.trips"), values)}</p>
  </section>

  <section>
    <h2>{t(k("method.title"))}</h2>
    <p>{t(k("method.intro"))}</p>
    <GuideFormula lines={guide.formulas} label={t(k("method.formulasLabel"))} />
    <GuideTermList items={guide.notes} />
    <p>{t(k("method.change"), values)}</p>
    <p>{t(k("method.stations"), values)}</p>
  </section>

  <section>
    <h2>{t(k("data.title"))}</h2>
    <p>{t(k("data.dgeg"), values)}</p>
    <p>{t(k("data.stations"), values)}</p>
    <p>{t(k("data.terms"))}</p>
    <ul class="space-y-1">
      <li><a href={FUEL_PRICES_SOURCE.url} rel="noopener" target="_blank">{t(k("data.dgegLink"))}</a></li>
      <li><a href={FUEL_STATIONS_SOURCE.url} rel="noopener" target="_blank">{t(k("data.stationsLink"))}</a></li>
    </ul>
    <p>{t(k("data.refresh"), values)}</p>
    <p>{t(k("data.stationsRefresh"), values)}</p>
  </section>

  <section>
    <h2>{t(k("limits.title"))}</h2>
    <GuideTermList items={guide.limits} />
    <p>{t(k("limits.education"))}</p>
  </section>

  <section>
    <h2>{t(k("related.title"))}</h2>
    <ul class="space-y-3">
      {
        related.map((item) => (
          <li>
            <a href={item.href}>{t(k(`related.${item.key}Link`))}</a>
            <p>{t(k(`related.${item.key}Body`))}</p>
          </li>
        ))
      }
    </ul>
  </section>
</ToolGuide>
