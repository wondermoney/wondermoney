---
// Prerendered explanation for the remunerated accounts table: how to read it, a worked example
// computed with the same functions the calculator runs (remuneratedAccountsGuide.ts), the method,
// what it leaves out and the tools to go on with, on the guide building blocks (guideBlocks.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import { buildRemuneratedAccountsGuide } from "./remuneratedAccountsGuide";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.remuneratedAccounts.guide.${key}`;

const guide = buildRemuneratedAccountsGuide(locale);
const { values } = guide;

const list = (key: string) => Object.values(t<Record<string, string>>(k(key), { returnObjects: true }));
const steps = list("method.steps");
const limits = list("limits.items");

const related = [
  { key: "deposit", href: toLocalizedPath("toolDepositRateIndex", locale) },
  { key: "certificates", href: toLocalizedPath("toolSavingsCertificates", locale) },
  { key: "term", href: toLocalizedPath("toolTermDeposit", locale) },
  { key: "budget", href: toLocalizedPath("toolHouseholdBudget", locale) },
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(k("read.title"))}</h2>
    <p>{t(k("read.what"))}</p>
    <p>{t(k("read.notRec"))}</p>
  </section>

  <section>
    <h2>{t(k("example.title"))}</h2>
    <p>{t(k("example.setup"), values)}</p>
    <GuideFigures items={guide.flow} operators={guide.flowOperators} />
    <p>{t(k("example.capped"), values)}</p>
    <p>{t(k("example.plans"), values)}</p>
    <GuideFigures variant="grid" items={guide.plans} />
  </section>

  <section>
    <h2>{t(k("method.title"))}</h2>
    <p>{t(k("method.intro"))}</p>
    <ol class="list-decimal space-y-2 pl-6">
      {steps.map((item) => <li>{item}</li>)}
    </ol>
  </section>

  <section>
    <h2>{t(k("limits.title"))}</h2>
    <ul class="list-disc space-y-2 pl-6">
      {limits.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section>
    <h2>{t(k("related.title"))}</h2>
    <ul class="space-y-3">
      {
        related.map((item) => (
          <li>
            <a href={item.href}>{t(k(`related.${item.key}Link`))}</a>
            <p>{t(k(`related.${item.key}Body`))}</p>
          </li>
        ))
      }
    </ul>
  </section>
</ToolGuide>
