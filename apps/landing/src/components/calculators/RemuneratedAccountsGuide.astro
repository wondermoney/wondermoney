---
// Prerendered explanation for the remunerated accounts table: how to read it, a worked example
// computed with the same functions the calculator runs, the method, what it leaves out and the
// tools to go on with.
import {
  BANK_INTEREST_EXAMPLE_AMOUNT,
  computeNetInterest,
  projectRow,
} from "@/lib/calculators/bankAccounts";
import { REMUNERATED_ACCOUNTS } from "@/lib/calculators/data/remuneratedAccounts";
import { formatMoney, formatPercent } from "@/lib/numberFormat";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.remuneratedAccounts.guide.${key}`;

const find = (id: string) => {
  const account = REMUNERATED_ACCOUNTS.find((item) => item.id === id);
  if (!account) throw new Error(`Unknown account ${id}`);
  return account;
};
const net = (id: string, amount: number) => {
  const outcome = computeNetInterest(find(id), amount);
  if (!outcome.ok) throw new Error("The worked example has an invalid amount");
  return outcome.result;
};

const amount = BANK_INTEREST_EXAMPLE_AMOUNT;
const plain = net("bankinter-conta-online", amount);
const bigAmount = 50_000;
const capped = net("bankinter-conta-mais-ordenado", bigAmount);
const revolut = projectRow(find("revolut-poupanca-acesso-imediato"), amount);
if (!revolut || revolut.plans.length < 2) throw new Error("The worked example needs the plans");
const standard = revolut.plans[0].result;
const ultra = revolut.plans[revolut.plans.length - 1].result;

const eur = (value: number, decimals = 0) => formatMoney(locale, value, { currency: "EUR", decimals });
const percent = (value: number) => formatPercent(locale, value, { decimals: 2 });
const values = {
  amount: eur(amount),
  product: find("bankinter-conta-online").product,
  bank: find("bankinter-conta-online").entity,
  rate: percent(plain.ratePct),
  gross: eur(plain.gross, 2),
  tax: eur(plain.tax, 2),
  net: eur(plain.net, 2),
  product2: find("bankinter-conta-mais-ordenado").product,
  bank2: find("bankinter-conta-mais-ordenado").entity,
  rate2: percent(capped.ratePct),
  cap: eur(find("bankinter-conta-mais-ordenado").maximum ?? 0),
  amount2: eur(bigAmount),
  gross2: eur(capped.gross, 2),
  net2: eur(capped.net, 2),
  product3: find("revolut-poupanca-acesso-imediato").product,
  bank3: find("revolut-poupanca-acesso-imediato").entity,
  low: percent(find("revolut-poupanca-acesso-imediato").tanbMin),
  high: percent(find("revolut-poupanca-acesso-imediato").tanbMax),
  standardNet: eur(standard.net, 2),
  ultraFees: eur(ultra.fees, 2),
  ultraNet: eur(ultra.net, 2),
};

const list = (key: string) =>
  Object.values(t<Record<string, string>>(k(key), { returnObjects: true }));
const steps = list("method.steps");
const limits = list("limits.items");

const related = [
  { key: "deposit", href: toLocalizedPath("toolDepositRateIndex", locale) },
  { key: "certificates", href: toLocalizedPath("toolSavingsCertificates", locale) },
  { key: "term", href: toLocalizedPath("toolTermDeposit", locale) },
  { key: "budget", href: toLocalizedPath("toolHouseholdBudget", locale) },
] as const;

const linkClass =
  "font-medium text-primary underline decoration-primary/40 underline-offset-4 hover:opacity-80";
---

<div class="mt-12 max-w-3xl space-y-12 text-ink-2">
  <section aria-labelledby="rem-read">
    <h2 id="rem-read" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("read.title"))}
    </h2>
    <div class="mt-3 space-y-4 leading-7">
      <p>{t(k("read.what"))}</p>
      <p>{t(k("read.notRec"))}</p>
    </div>
  </section>

  <section aria-labelledby="rem-example">
    <h2 id="rem-example" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("example.title"))}
    </h2>
    <div class="mt-3 space-y-4 leading-7">
      <p>{t(k("example.setup"), values)}</p>
      <p>{t(k("example.capped"), values)}</p>
      <p>{t(k("example.plans"), values)}</p>
    </div>
  </section>

  <section aria-labelledby="rem-method">
    <h2 id="rem-method" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("method.title"))}
    </h2>
    <div class="mt-3 space-y-4 leading-7">
      <p>{t(k("method.intro"))}</p>
      <ol class="list-decimal space-y-2 pl-5">
        {steps.map((item) => <li>{item}</li>)}
      </ol>
    </div>
  </section>

  <section aria-labelledby="rem-limits">
    <h2 id="rem-limits" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("limits.title"))}
    </h2>
    <ul class="mt-3 list-disc space-y-2 pl-5 leading-7">
      {limits.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section aria-labelledby="rem-related">
    <h2 id="rem-related" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("related.title"))}
    </h2>
    <ul class="mt-3 space-y-3 leading-7">
      {
        related.map((item) => (
          <li>
            <a href={item.href} class={linkClass}>
              {t(k(`related.${item.key}Link`))}
            </a>
            <p>{t(k(`related.${item.key}Body`))}</p>
          </li>
        ))
      }
    </ul>
  </section>
</div>
