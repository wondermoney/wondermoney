---
// Prerendered worked example and method for the unemployment benefit calculator, on the guide
// building blocks (guideBlocks.ts). The figures come from the calculator's own function
// (benefitGuides.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildUnemploymentGuide } from "./benefitGuides";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.unemploymentBenefit.guide.${key}`;
const guide = buildUnemploymentGuide(locale);
const sources = [
  ["sourceGuide", "https://www.seg-social.pt/subsidio-de-desemprego"],
  ["sourceLaw", "https://diariodarepublica.pt/dr/detalhe/decreto-lei/220-2006-546202"],
  ["sourceIncrease", "https://diariodarepublica.pt/dr/detalhe/decreto-lei/119-2021-175983734"],
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(k("exampleTitle"))}</h2>
    <p>{t(k("example"), guide.values)}</p>
    <GuideFigures variant="grid" items={guide.figures} />
  </section>
  <section>
    <h2>{t(k("methodTitle"))}</h2>
    <GuideFormula lines={guide.formulas} label={t(k("methodFormulasLabel"))} />
    <GuideTermList items={guide.notes} columns={1} />
    <h3 class="font-semibold text-foreground">{t(k("unsupportedTitle"))}</h3>
    <ul class="list-disc space-y-2 pl-6">
      {["unsupportedTransitional", "unsupportedSocial", "unsupportedSelfEmployed", "unsupportedOther"].map((key) => <li>{t(k(key))}</li>)}
    </ul>
    <h3 class="font-semibold text-foreground">{t(k("sourcesTitle"))}</h3>
    <ul class="list-disc space-y-2 pl-6">
      {sources.map(([key, href]) => (
        <li>
          <a href={href} rel="noopener">{t(k(key))}</a>
        </li>
      ))}
    </ul>
    <p class="text-sm">{t(k("reviewed"))}</p>
  </section>
</ToolGuide>
