---
// Prerendered explanation for the Euribor page: what the rates are, a worked example computed
// from the same function the calculator runs, the data source with its date, what the figures
// leave out, and the tools to go on with.
import ToolGuide from "./ToolGuide.astro";
import {
  EURIBOR_EXAMPLE,
  EURIBOR_SOURCE,
  computeEuriborImpact,
  getLatestEuribor,
} from "@/lib/calculators/euribor";
import { formatMoney, formatNumber, formatPercent, toIntlLocale } from "@/lib/numberFormat";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.euribor.guide.${key}`;

const outcome = computeEuriborImpact(EURIBOR_EXAMPLE);
if (!outcome.ok) throw new Error("The Euribor worked example has invalid inputs");
const { revision, indexRate, newIndexRate } = outcome.result;
const [year, monthNumber] = getLatestEuribor().month.split("-").map(Number);
const month = new Intl.DateTimeFormat(toIntlLocale(locale), {
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(Date.UTC(year, monthNumber - 1, 1)));

const euros = (value: number, decimals = 0) => formatMoney(locale, value, { decimals });
const values = {
  month,
  fetched: EURIBOR_SOURCE.fetchedOn,
  balance: euros(EURIBOR_EXAMPLE.balance),
  years: String(EURIBOR_EXAMPLE.termYears),
  spread: formatPercent(locale, EURIBOR_EXAMPLE.spread, { decimals: 2 }),
  index: formatPercent(locale, indexRate, { decimals: 2 }),
  newIndex: formatPercent(locale, newIndexRate, { decimals: 2 }),
  change: formatNumber(locale, EURIBOR_EXAMPLE.change, 2),
  current: euros(revision.current.monthlyPayment, 2),
  revised: euros(revision.revised.monthlyPayment, 2),
  difference: euros(revision.monthlyChange, 2),
};

const list = (key: string) =>
  Object.values(t<Record<string, string>>(k(key), { returnObjects: true }));
const limits = list("limits.items");

const related = [
  { key: "rateRevision", href: toLocalizedPath("toolRateRevision", locale) },
  { key: "mortgage", href: toLocalizedPath("toolMortgage", locale) },
  { key: "debtToIncome", href: toLocalizedPath("toolDebtToIncome", locale) },
] as const;

const linkClass =
  "font-medium text-primary underline decoration-primary/40 underline-offset-4 hover:opacity-80";
---

<ToolGuide>
  <section aria-labelledby="euribor-read">
    <h2 id="euribor-read" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("read.title"))}
    </h2>
    <div class="mt-3 space-y-4 leading-7">
      <p>{t(k("read.intro"))}</p>
      <p>{t(k("read.monthly"), values)}</p>
    </div>
  </section>

  <section aria-labelledby="euribor-example">
    <h2 id="euribor-example" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("example.title"))}
    </h2>
    <div class="mt-3 space-y-4 leading-7">
      <p>{t(k("example.setup"), values)}</p>
      <p>{t(k("example.result"), values)}</p>
    </div>
  </section>

  <section aria-labelledby="euribor-data">
    <h2 id="euribor-data" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("data.title"))}
    </h2>
    <div class="mt-3 space-y-4 leading-7">
      <p>{t(k("data.source"), values)}</p>
      <p>
        <a href={EURIBOR_SOURCE.url} class={linkClass} rel="noopener" target="_blank">
          {t(k("data.link"))}
        </a>
      </p>
      <p>{t(k("data.daily"))}</p>
      <p>{t(k("data.trademark"))}</p>
    </div>
  </section>

  <section aria-labelledby="euribor-limits">
    <h2 id="euribor-limits" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("limits.title"))}
    </h2>
    <ul class="mt-3 list-disc space-y-2 pl-5 leading-7">
      {limits.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section aria-labelledby="euribor-related">
    <h2 id="euribor-related" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("related.title"))}
    </h2>
    <ul class="mt-3 space-y-3 leading-7">
      {
        related.map((item) => (
          <li>
            <a href={item.href} class={linkClass}>
              {t(k(`related.${item.key}Link`))}
            </a>
            <p>{t(k(`related.${item.key}Body`))}</p>
          </li>
        ))
      }
    </ul>
  </section>
</ToolGuide>
