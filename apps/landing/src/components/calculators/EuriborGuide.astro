---
// Prerendered explanation for the Euribor page: what the rates are, a worked example computed
// from the same function the calculator runs (euriborGuide.ts), the data source with its
// date, what the figures leave out, and the tools to go on with.
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import { buildEuriborGuide } from "./euriborGuide";
import { EURIBOR_SOURCE } from "@/lib/calculators/euribor";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.euribor.guide.${key}`;
const guide = buildEuriborGuide(locale);
const { values } = guide;

const list = (key: string) =>
  Object.values(t<Record<string, string>>(k(key), { returnObjects: true }));
const limits = list("limits.items");

const related = [
  { key: "rateRevision", href: toLocalizedPath("toolRateRevision", locale) },
  { key: "mortgage", href: toLocalizedPath("toolMortgage", locale) },
  { key: "debtToIncome", href: toLocalizedPath("toolDebtToIncome", locale) },
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(k("read.title"))}</h2>
    <p>{t(k("read.intro"))}</p>
    <p>{t(k("read.monthly"), values)}</p>
  </section>

  <section>
    <h2>{t(k("example.title"))}</h2>
    <p>{t(k("example.setup"), values)}</p>
    <GuideFigures items={guide.payment} operators={["+", "="]} />
    <p>{t(k("example.result"), values)}</p>
  </section>

  <section>
    <h2>{t(k("data.title"))}</h2>
    <p>{t(k("data.source"), values)}</p>
    <p>
      <a href={EURIBOR_SOURCE.url} rel="noopener" target="_blank">{t(k("data.link"))}</a>
    </p>
    <p>{t(k("data.daily"))}</p>
    <p>{t(k("data.trademark"))}</p>
  </section>

  <section>
    <h2>{t(k("limits.title"))}</h2>
    <ul class="list-disc space-y-2 pl-5">
      {limits.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section>
    <h2>{t(k("related.title"))}</h2>
    <ul class="space-y-3">
      {
        related.map((item) => (
          <li>
            <a href={item.href}>{t(k(`related.${item.key}Link`))}</a>
            <p>{t(k(`related.${item.key}Body`))}</p>
          </li>
        ))
      }
    </ul>
  </section>
</ToolGuide>
