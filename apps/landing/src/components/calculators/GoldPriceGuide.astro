---
// Prerendered explanation for the gold price page: how to read the price, a worked example
// computed from the same function the calculator runs, the method, the sources (NBP for the gold
// price and why not the LBMA price, the ECB for the euro), what the value leaves out (buyers pay
// less than the metal), and the tools to go on with.
import ToolGuide from "./ToolGuide.astro";
import {
  GOLD_PRICE_SOURCE,
  computeGoldValue,
  goldPriceSummary,
  goldValueExample,
} from "@/lib/calculators/goldValue";
import { formatMoney, formatNumber } from "@/lib/numberFormat";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.goldPrice.guide.${key}`;

const example = goldValueExample();
const outcome = computeGoldValue(example);
if (!outcome.ok) throw new Error("The gold value worked example has invalid inputs");
const { result } = outcome;
const ring = computeGoldValue({ ...example, grams: 4, purity: "k18" });
if (!ring.ok) throw new Error("The gold ring example has invalid inputs");
const summary = goldPriceSummary();

const euro = (value: number, decimals = 2) => formatMoney(locale, value, { decimals });
const values = {
  grams: `${formatNumber(locale, example.grams)} g`,
  price: `${euro(example.price)}/g`,
  pureGrams: `${formatNumber(locale, result.pureGrams)} g`,
  value: euro(result.value),
  ringValue: euro(ring.result.value),
  ringPure: `${formatNumber(locale, ring.result.pureGrams)} g`,
  ounce: euro(summary.eurPerOunce, 0),
  asOf: GOLD_PRICE_SOURCE.asOf,
  fetched: GOLD_PRICE_SOURCE.fetchedOn,
};

const list = (key: string) =>
  Object.values(t<Record<string, string>>(k(key), { returnObjects: true }));
const steps = list("method.steps");
const purities = list("purity.items");
const assumptions = list("limits.items");

const related = [
  { key: "netWorth", href: toLocalizedPath("toolNetWorth", locale) },
  { key: "inflation", href: toLocalizedPath("toolInflation", locale) },
  { key: "investmentReturn", href: toLocalizedPath("toolInvestmentReturn", locale) },
] as const;

const linkClass =
  "font-medium text-primary underline decoration-primary/40 underline-offset-4 hover:opacity-80";
---

<ToolGuide>
  <section aria-labelledby="gold-read">
    <h2 id="gold-read" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("read.title"))}
    </h2>
    <div class="mt-3 space-y-4 leading-7">
      <p>{t(k("read.price"), values)}</p>
      <p>{t(k("read.calculator"))}</p>
      <p>{t(k("read.noForecast"))}</p>
    </div>
  </section>

  <section aria-labelledby="gold-example">
    <h2 id="gold-example" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("example.title"))}
    </h2>
    <div class="mt-3 space-y-4 leading-7">
      <p>{t(k("example.setup"), values)}</p>
      <p>{t(k("example.ring"), values)}</p>
    </div>
  </section>

  <section aria-labelledby="gold-purity">
    <h2 id="gold-purity" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("purity.title"))}
    </h2>
    <div class="mt-3 space-y-4 leading-7">
      <p>{t(k("purity.intro"))}</p>
      <ul class="list-disc space-y-2 pl-5">
        {purities.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section aria-labelledby="gold-method">
    <h2 id="gold-method" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("method.title"))}
    </h2>
    <div class="mt-3 space-y-4 leading-7">
      <p>{t(k("method.intro"))}</p>
      <ol class="list-decimal space-y-2 pl-5">
        {steps.map((item) => <li>{item}</li>)}
      </ol>
    </div>
  </section>

  <section aria-labelledby="gold-buyers">
    <h2 id="gold-buyers" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("buyers.title"))}
    </h2>
    <div class="mt-3 space-y-4 leading-7">
      <p>{t(k("buyers.below"))}</p>
      <p>{t(k("buyers.jewellery"))}</p>
      <p>{t(k("buyers.tips"))}</p>
    </div>
  </section>

  <section aria-labelledby="gold-data">
    <h2 id="gold-data" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("data.title"))}
    </h2>
    <div class="mt-3 space-y-4 leading-7">
      <p>{t(k("data.nbp"), values)}</p>
      <p>{t(k("data.why"))}</p>
      <p>{t(k("data.ecb"))}</p>
      <ul class="space-y-1">
        <li><a href={GOLD_PRICE_SOURCE.url} class={linkClass} rel="noopener" target="_blank">{t(k("data.nbpLink"))}</a></li>
        <li><a href={GOLD_PRICE_SOURCE.fxUrl} class={linkClass} rel="noopener" target="_blank">{t(k("data.ecbLink"))}</a></li>
      </ul>
      <p>{t(k("data.refresh"), values)}</p>
    </div>
  </section>

  <section aria-labelledby="gold-limits">
    <h2 id="gold-limits" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("limits.title"))}
    </h2>
    <ul class="mt-3 list-disc space-y-2 pl-5 leading-7">
      {assumptions.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section aria-labelledby="gold-related">
    <h2 id="gold-related" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("related.title"))}
    </h2>
    <ul class="mt-3 space-y-3 leading-7">
      {
        related.map((item) => (
          <li>
            <a href={item.href} class={linkClass}>
              {t(k(`related.${item.key}Link`))}
            </a>
            <p>{t(k(`related.${item.key}Body`))}</p>
          </li>
        ))
      }
    </ul>
  </section>
</ToolGuide>
