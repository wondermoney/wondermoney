---
// Prerendered explanation for the gold price page: how to read the price, a worked example
// computed from the same function the calculator runs (goldPriceGuide.ts), the method, the
// sources (NBP for the gold price and why not the LBMA price, the ECB for the euro), what the
// value leaves out (buyers pay less than the metal), and the tools to go on with, on the guide
// building blocks (guideBlocks.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildGoldPriceGuide } from "./goldPriceGuide";
import { GOLD_PRICE_SOURCE } from "@/lib/calculators/goldValue";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.goldPrice.guide.${key}`;

const guide = buildGoldPriceGuide(locale);
const { values } = guide;

const related = [
  { key: "netWorth", href: toLocalizedPath("toolNetWorth", locale) },
  { key: "inflation", href: toLocalizedPath("toolInflation", locale) },
  { key: "investmentReturn", href: toLocalizedPath("toolInvestmentReturn", locale) },
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(k("read.title"))}</h2>
    <p>{t(k("read.price"), values)}</p>
    <p>{t(k("read.calculator"))}</p>
    <p>{t(k("read.noForecast"))}</p>
  </section>

  <section>
    <h2>{t(k("example.title"))}</h2>
    <p>{t(k("example.setup"), values)}</p>
    <GuideFigures items={guide.flow} operators={guide.flowOperators} />
    <p>{t(k("example.ring"), values)}</p>
  </section>

  <section>
    <h2>{t(k("purity.title"))}</h2>
    <p>{t(k("purity.intro"))}</p>
    <GuideTermList items={guide.purities} />
  </section>

  <section>
    <h2>{t(k("method.title"))}</h2>
    <p>{t(k("method.intro"))}</p>
    <GuideFormula lines={guide.formulas} label={t(k("method.formulasLabel"))} />
    <GuideTermList items={guide.steps} />
  </section>

  <section>
    <h2>{t(k("buyers.title"))}</h2>
    <p>{t(k("buyers.below"))}</p>
    <p>{t(k("buyers.jewellery"))}</p>
    <p>{t(k("buyers.tips"))}</p>
  </section>

  <section>
    <h2>{t(k("data.title"))}</h2>
    <p>{t(k("data.nbp"), values)}</p>
    <p>{t(k("data.why"))}</p>
    <p>{t(k("data.ecb"))}</p>
    <ul class="space-y-1">
      <li><a href={GOLD_PRICE_SOURCE.url} rel="noopener" target="_blank">{t(k("data.nbpLink"))}</a></li>
      <li><a href={GOLD_PRICE_SOURCE.fxUrl} rel="noopener" target="_blank">{t(k("data.ecbLink"))}</a></li>
    </ul>
    <p>{t(k("data.refresh"), values)}</p>
  </section>

  <section>
    <h2>{t(k("limits.title"))}</h2>
    <GuideTermList items={guide.limits} />
    <p>{guide.limitsNote}</p>
  </section>

  <section>
    <h2>{t(k("related.title"))}</h2>
    <ul class="space-y-3">
      {
        related.map((item) => (
          <li>
            <a href={item.href}>{t(k(`related.${item.key}Link`))}</a>
            <p>{t(k(`related.${item.key}Body`))}</p>
          </li>
        ))
      }
    </ul>
  </section>
</ToolGuide>
