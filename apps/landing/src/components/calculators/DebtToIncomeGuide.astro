---
// Prerendered explanation, worked example and method for the debt-to-income
// calculator. The figures come from the same calculation the calculator runs.
import ToolGuide from "./ToolGuide.astro";
import {
  DEBT_TO_INCOME_CAUTION_FROM,
  DEBT_TO_INCOME_HIGH_ABOVE,
  DEBT_TO_INCOME_WORKED_EXAMPLE,
  compareDebtScenario,
} from "@/lib/calculators/debtToIncome";
import { formatMoney, formatPercent } from "@/lib/numberFormat";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.debtToIncome.guide.${key}`;

const example = DEBT_TO_INCOME_WORKED_EXAMPLE;
const comparison = compareDebtScenario(example.monthlyIncome, example.rows, example.scenario);
const amountOf = (id: string) => example.rows.find((row) => row.id === id)?.amount ?? 0;
const money = (value: number) => formatMoney(locale, value);
const percent = (value: number | null) => (value === null ? "" : formatPercent(locale, value));

const exampleValues = {
  income: money(example.monthlyIncome),
  home: money(amountOf("home")),
  car: money(amountOf("car")),
  cards: money(amountOf("cards")),
  total: money(comparison.current.totalPayments),
  ratio: percent(comparison.current.ratio),
  scenarioTotal: money(comparison.scenario.totalPayments),
  scenarioRatio: percent(comparison.scenario.ratio),
};

const bands = [
  { key: "healthy", range: t(k("bandHealthyRange"), { caution: DEBT_TO_INCOME_CAUTION_FROM }) },
  {
    key: "caution",
    range: t(k("bandCautionRange"), {
      caution: DEBT_TO_INCOME_CAUTION_FROM,
      high: DEBT_TO_INCOME_HIGH_ABOVE,
    }),
  },
  { key: "high", range: t(k("bandHighRange"), { high: DEBT_TO_INCOME_HIGH_ABOVE }) },
] as const;

const methodItems = ["methodCounts", "methodExcludes", "methodIncome", "methodRounding", "methodPrivacy"];

// A new mortgage is the usual new payment; the mortgage tool works it out.
const nextHref = toLocalizedPath("toolMortgage", locale);
---

<ToolGuide>
  <section>
    <h2 class="text-2xl font-semibold tracking-tight text-foreground">{t(k("whatHeading"))}</h2>
    <p class="mt-3">{t(k("whatBody"))}</p>
  </section>

  <section>
    <h2 class="text-2xl font-semibold tracking-tight text-foreground">{t(k("readHeading"))}</h2>
    <ul class="mt-3 space-y-2">
      {
        bands.map((band) => (
          <li>
            <strong class="font-semibold text-foreground">{band.range}</strong>{" "}
            {t(k(`band${band.key[0].toUpperCase()}${band.key.slice(1)}Body`))}
          </li>
        ))
      }
    </ul>
    <p class="mt-4">{t(k("limitsBody"))}</p>
  </section>

  <section>
    <h2 class="text-2xl font-semibold tracking-tight text-foreground">{t(k("exampleHeading"))}</h2>
    <p class="mt-3">{t(k("exampleBody"), exampleValues)}</p>
    <p class="mt-3 rounded-lg border border-border bg-paper-2 px-4 py-3 font-mono text-sm text-foreground">
      {exampleValues.total} ÷ {exampleValues.income} × 100 = {exampleValues.ratio}
    </p>
    <p class="mt-3">{t(k("exampleScenario"), exampleValues)}</p>
  </section>

  <section>
    <h2 class="text-2xl font-semibold tracking-tight text-foreground">{t(k("methodHeading"))}</h2>
    <p class="mt-3 rounded-lg border border-border bg-paper-2 px-4 py-3 text-sm text-foreground">
      {t(k("methodFormula"))}
    </p>
    <ul class="mt-4 list-disc space-y-2 pl-5">
      {methodItems.map((item) => <li>{t(k(item))}</li>)}
    </ul>
  </section>

  <section>
    <h2 class="text-2xl font-semibold tracking-tight text-foreground">{t(k("nextHeading"))}</h2>
    <p class="mt-3">
      {t(k("nextBody"))}{" "}
      <a
        href={nextHref}
        class="font-medium text-primary underline decoration-primary/40 underline-offset-4 hover:opacity-80"
      >
        {t(k("nextLink"))}
      </a>
    </p>
  </section>
</ToolGuide>
