---
// Prerendered explanation, worked example and method for the debt-to-income calculator, on
// the guide building blocks. The figures come from the same calculation the calculator runs
// (debtToIncomeGuide.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildDebtToIncomeGuide } from "./debtToIncomeGuide";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.debtToIncome.guide.${key}`;
const guide = buildDebtToIncomeGuide(locale);

// A new mortgage is the usual new payment; the mortgage tool works it out.
const nextHref = toLocalizedPath("toolMortgage", locale);
---

<ToolGuide>
  <section>
    <h2>{t(k("whatHeading"))}</h2>
    <p>{t(k("whatBody"))}</p>
  </section>

  <section>
    <h2>{t(k("readHeading"))}</h2>
    <GuideTermList items={guide.bands} columns={1} />
    <p>{t(k("limitsBody"))}</p>
  </section>

  <section>
    <h2>{t(k("exampleHeading"))}</h2>
    <p>{t(k("exampleBody"), guide.exampleValues)}</p>
    <GuideFigures items={guide.flow} operators={["÷", "="]} />
    <p>{t(k("exampleScenario"), guide.exampleValues)}</p>
    <GuideFigures variant="grid" items={guide.comparison} />
  </section>

  <section>
    <h2>{t(k("methodHeading"))}</h2>
    <GuideFormula lines={guide.formulas} label={t(k("methodFormulasLabel"))} />
    <GuideTermList items={guide.notes} />
  </section>

  <section>
    <h2>{t(k("nextHeading"))}</h2>
    <p>
      {t(k("nextBody"))}{" "}
      <a href={nextHref}>{t(k("nextLink"))}</a>
    </p>
  </section>
</ToolGuide>
