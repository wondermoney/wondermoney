---
// Prerendered worked example and method for the dismissal compensation calculator, on the
// guide building blocks (guideBlocks.ts). The figures come from the calculator's own function
// (benefitGuides.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildDismissalGuide } from "./benefitGuides";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.dismissalCompensation.guide.${key}`;
const guide = buildDismissalGuide(locale);
const sources = [
  ["sourceCode", "https://diariodarepublica.pt/dr/legislacao-consolidada/lei/2009-34546475"],
  ["sourceArt148", "https://diariodarepublica.pt/dr/legislacao-consolidada/lei/2009-34546475-124448610"],
  ["sourceLaw93", "https://diariodarepublica.pt/dr/detalhe/lei/93-2019-124417106"],
  ["sourceLaw13Text", "https://diariodarepublica.pt/dr/detalhe/lei/13-2023-211340863"],
  ["sourceLaw69", "https://diariodarepublica.pt/dr/detalhe/lei/69-2013-499541"],
  ["sourceIgefe", "https://www.spgl.pt/Media/Default/Info/59000/0/60/1/NOTA%20INFORMATIVA%20N%2010%20_%20IGeFE%20_%202023%20-%20ABONOS%20POR%20CESSACAO%20DE%20CONTRATO.pdf"],
  ["sourceDgert", "https://www.dgert.gov.pt/compensacao-por-despedimento-coletivo-artigo-366-o"],
] as const;
const unsupported = ["unsupportedFixedTerm", "unsupportedJustCause", "unsupportedUnlawful", "unsupportedAgreement", "unsupportedPublic"];
---

<ToolGuide>
  <section>
    <h2>{t(k("exampleTitle"))}</h2>
    <p>{t(k("example"), guide.values)}</p>
    <GuideFigures variant="grid" items={guide.figures} />
  </section>
  <section>
    <h2>{t(k("methodTitle"))}</h2>
    <GuideFormula lines={guide.formulas} label={t(k("methodFormulasLabel"))} />
    <GuideTermList items={guide.notes} columns={1} />
    <h3 class="font-semibold text-foreground">{t(k("supportedTitle"))}</h3>
    <p>{t(k("supported"))}</p>
    <h3 class="font-semibold text-foreground">{t(k("unsupportedTitle"))}</h3>
    <ul class="list-disc space-y-2 pl-6">
      {unsupported.map((key) => <li>{t(k(key))}</li>)}
    </ul>
    <h3 class="font-semibold text-foreground">{t(k("sourcesTitle"))}</h3>
    <ul class="list-disc space-y-2 pl-6">
      {sources.map(([key, href]) => (
        <li>
          <a href={href} rel="noopener">{t(k(key))}</a>
        </li>
      ))}
    </ul>
    <p class="text-sm">{t(k("reviewed"))}</p>
  </section>
</ToolGuide>
