---
// Prerendered worked example and method for the sick pay calculator, on the guide building
// blocks (guideBlocks.ts). The figures come from the calculator's own function
// (benefitGuides.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildSickPayGuide } from "./benefitGuides";
import { SICK_PAY_SOURCES } from "@/lib/calculators/sickPay";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.sickPay.guide.${key}`;
const guide = buildSickPayGuide(locale);
const sources = [
  ["sourceGuide", SICK_PAY_SOURCES.guide],
  ["sourceLaw", SICK_PAY_SOURCES.law],
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(k("exampleTitle"))}</h2>
    <p>{t(k("example"), guide.values)}</p>
    <GuideFigures items={guide.figures} operators={guide.flowOperators} />
  </section>
  <section>
    <h2>{t(k("methodTitle"))}</h2>
    <GuideFormula lines={guide.formulas} label={t(k("methodFormulasLabel"))} />
    <GuideTermList items={guide.notes} columns={1} />
    <h3 class="font-semibold text-foreground">{t(k("unsupportedTitle"))}</h3>
    <ul class="list-disc space-y-2 pl-6">
      {["unsupportedTuberculosis", "unsupportedSelfEmployed", "unsupportedShort", "unsupportedOther"].map((key) => <li>{t(k(key))}</li>)}
    </ul>
    <h3 class="font-semibold text-foreground">{t(k("sourcesTitle"))}</h3>
    <ul class="list-disc space-y-2 pl-6">
      {sources.map(([key, href]) => (
        <li>
          <a href={href} rel="noopener">{t(k(key))}</a>
        </li>
      ))}
    </ul>
    <p class="text-sm">{t(k("reviewed"))}</p>
  </section>
</ToolGuide>
