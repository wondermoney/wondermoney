---
import {
  MIN_DAILY_CENTS,
  RMMG_2026_CENTS,
  SICK_PAY_EXAMPLE,
  computeSickPay,
  floorDailyCents,
} from "@/lib/calculators/sickPay";
import { formatMoney } from "@/lib/numberFormat";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.sickPay.guide.${key}`;
const example = computeSickPay(SICK_PAY_EXAMPLE);
if (!example.ok) throw new Error("Invalid sick pay worked example");

const money = (cents: number) => formatMoney(locale, cents / 100, { decimals: 2 });
const { result } = example;
const values = {
  gross: formatMoney(locale, SICK_PAY_EXAMPLE.grossMonthly, { decimals: 0 }),
  days: String(SICK_PAY_EXAMPLE.sickDays),
  reference: money(result.referenceDailyCents),
  total: money(result.totalCents),
  net: money(result.netMonthlyCents),
  gap: money(result.averageMonthlyGapCents),
};
const limitValues = {
  min: money(MIN_DAILY_CENTS), rmmg: money(RMMG_2026_CENTS), floor55: money(floorDailyCents(55)), floor60: money(floorDailyCents(60)),
};
const methods = [
  "methodReference", "methodBands", "methodWaiting", "methodMinimum", "methodIncrease", "methodFloor",
  "methodNetCap", "methodGap", "methodBudget",
];
---

<div class="mt-12 max-w-3xl space-y-10 text-base leading-7 text-ink-2">
  <section aria-labelledby="sick-example">
    <h2 id="sick-example" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("exampleTitle"))}
    </h2>
    <p class="mt-4">{t(k("example"), values)}</p>
  </section>
  <section aria-labelledby="sick-method">
    <h2 id="sick-method" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("methodTitle"))}
    </h2>
    <ul class="mt-4 list-disc space-y-2 pl-6">
      {methods.map((key) => <li>{t(k(key), limitValues)}</li>)}
    </ul>
    <h3 class="mt-8 font-semibold text-foreground">{t(k("unsupportedTitle"))}</h3>
    <ul class="mt-3 list-disc space-y-2 pl-6">
      {["unsupportedTuberculosis", "unsupportedSelfEmployed", "unsupportedShort", "unsupportedOther"].map((key) => <li>{t(k(key))}</li>)}
    </ul>
    <h3 class="mt-8 font-semibold text-foreground">{t(k("sourcesTitle"))}</h3>
    <ul class="mt-3 list-disc space-y-2 pl-6">
      <li>
        <a href="https://www.seg-social.pt/subsidio-de-doenca" rel="noopener" class="font-medium text-primary underline decoration-primary/40 underline-offset-4 hover:opacity-80">
          {t(k("sourceGuide"))}
        </a>
      </li>
      <li>{t(k("sourceLaw"))}</li>
    </ul>
    <p class="mt-4 text-sm">{t(k("reviewed"))}</p>
  </section>
</div>
