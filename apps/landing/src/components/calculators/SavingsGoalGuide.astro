---
// Prerendered explanation, worked example and method for the savings goal calculator, on the
// guide building blocks (guideBlocks.ts). The figures come from the same function the
// calculator runs, starting from its first state (savingsGoalGuide.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildSavingsGoalGuide } from "./savingsGoalGuide";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.savingsGoal.guide.${key}`;

const guide = buildSavingsGoalGuide(locale);
const { values } = guide;

const exampleSteps = ["exampleStep1", "exampleStep2", "exampleStep3"].map((key) =>
  t(k(key), values),
);
const assumptions = [
  "assumptionReturn",
  "assumptionCosts",
  "assumptionInflation",
  "assumptionLimits",
].map((key) => t(k(key), values));

const related = [
  { routeId: "toolSavingsRate", key: "relatedSavingsRate", title: t("tools.savingsRate.title") },
  {
    routeId: "toolCompoundInterest",
    key: "relatedCompoundInterest",
    title: t("tools.compoundInterest.title"),
  },
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(k("whatTitle"))}</h2>
    <p>{t(k("whatBody1"))}</p>
    <p>{t(k("whatBody2"))}</p>
    <ul class="list-disc space-y-2 pl-6">
      {
        related.map((item) => (
          <li>
            <a href={toLocalizedPath(item.routeId, locale)}>{item.title}</a>{": "}{t(k(item.key))}
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>{t(k("exampleTitle"))}</h2>
    <p>{t(k("exampleIntro"), values)}</p>
    <ol class="list-decimal space-y-2 pl-6">
      {exampleSteps.map((step) => <li>{step}</li>)}
    </ol>
    <GuideFigures items={guide.flow} operators={guide.flowOperators} />
    <p>{t(k("exampleOutro"), values)}</p>
  </section>

  <section>
    <h2>{t(k("methodTitle"))}</h2>
    <p>{t(k("methodIntro"))}</p>
    <GuideFormula lines={guide.formulas} label={t(k("methodFormulasLabel"))} />
    <GuideTermList items={guide.notes} />
    <h3 class="font-semibold text-foreground">{t(k("assumptionsTitle"))}</h3>
    <ul class="list-disc space-y-2 pl-6">
      {assumptions.map((item) => <li>{item}</li>)}
    </ul>
  </section>
</ToolGuide>
