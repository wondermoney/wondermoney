---
// Prerendered explanation for the S&P 500 historical returns calculator: how to read it, a worked
// example computed from the same function the calculator runs (sp500HistoryGuide.ts), the method,
// the data source with its download date, what the figures leave out, and the tools to go on
// with, on the guide building blocks (guideBlocks.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildSp500HistoryGuide } from "./sp500HistoryGuide";
import { SP500_HISTORY_SOURCE } from "@/lib/calculators/sp500History";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.sp500History.guide.${key}`;

const guide = buildSp500HistoryGuide(locale);
const { values } = guide;

const steps = Object.values(t<Record<string, string>>(k("method.steps"), { returnObjects: true }));

const related = [
  { key: "investmentReturn", href: toLocalizedPath("toolInvestmentReturn", locale) },
  { key: "compoundInterest", href: toLocalizedPath("toolCompoundInterest", locale) },
  { key: "investorProfile", href: toLocalizedPath("toolInvestorProfile", locale) },
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(k("read.title"))}</h2>
    <p>{t(k("read.intro"), values)}</p>
    <p>{t(k("read.future"))}</p>
  </section>

  <section>
    <h2>{t(k("example.title"))}</h2>
    <p>{t(k("example.setup"), values)}</p>
    <p>{t(k("example.price"), values)}</p>
    <p>{t(k("example.real"), values)}</p>
    <p>{t(k("example.range"), values)}</p>
    <GuideFigures variant="grid" items={guide.figures} />
  </section>

  <section>
    <h2>{t(k("method.title"))}</h2>
    <p>{t(k("method.intro"))}</p>
    <ol class="list-decimal space-y-2 pl-6">
      {steps.map((item) => <li>{item}</li>)}
    </ol>
    <p>{t(k("method.cagr"))}</p>
    <p>{t(k("method.contributions"))}</p>
    <p>{t(k("method.limits"), values)}</p>
  </section>

  <section>
    <h2>{t(k("data.title"))}</h2>
    <p>{t(k("data.source"), values)}</p>
    <p>
      <a href={SP500_HISTORY_SOURCE.returns.url} rel="noopener" target="_blank">{t(k("data.returnsLink"))}</a>
      {" · "}
      <a href={SP500_HISTORY_SOURCE.inflation.url} rel="noopener" target="_blank">{t(k("data.inflationLink"))}</a>
    </p>
    <p>{t(k("data.method"))}</p>
    <p>{t(k("data.check"))}</p>
    <p>{t(k("data.trademark"))}</p>
  </section>

  <section>
    <h2>{t(k("limits.title"))}</h2>
    <GuideTermList items={guide.limits} />
    <p>{guide.limitsNote}</p>
  </section>

  <section>
    <h2>{t(k("related.title"))}</h2>
    <ul class="space-y-3">
      {
        related.map((item) => (
          <li>
            <a href={item.href}>{t(k(`related.${item.key}Link`))}</a>
            <p>{t(k(`related.${item.key}Body`))}</p>
          </li>
        ))
      }
    </ul>
  </section>
</ToolGuide>
