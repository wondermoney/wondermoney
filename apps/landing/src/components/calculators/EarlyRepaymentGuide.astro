---
// Prerendered explanation for the early repayment calculator: the two ways to use a repayment,
// what to check first, a worked example computed from the same function the calculator runs,
// and the method.
import ToolGuide from "./ToolGuide.astro";
import {
  EARLY_REPAYMENT_EXAMPLE,
  EARLY_REPAYMENT_LIMITS,
  computeEarlyRepayment,
  type EarlyRepaymentResult,
} from "@/lib/calculators/earlyRepayment";
import { formatFireDuration as formatDuration } from "@/lib/calculators/fireFormat";
import { formatMoney, formatNumber, formatPercent } from "@/lib/numberFormat";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.earlyRepayment.guide.${key}`;

function calculate(feePercent: number): EarlyRepaymentResult {
  const calculation = computeEarlyRepayment({ ...EARLY_REPAYMENT_EXAMPLE, feePercent });
  if (!calculation.ok) throw new Error("The early repayment worked example has invalid inputs");
  return calculation.result;
}

const example = calculate(EARLY_REPAYMENT_EXAMPLE.feePercent);
const withFee = calculate(EARLY_REPAYMENT_EXAMPLE.exampleFeePercent);

const money = (value: number, decimals = 2) => formatMoney(locale, value, { decimals });
const duration = (months: number) => formatDuration(locale, months);
const values = {
  balance: money(EARLY_REPAYMENT_EXAMPLE.balance, 0),
  term: duration(example.original.months),
  rate: formatPercent(locale, EARLY_REPAYMENT_EXAMPLE.annualRate, { decimals: 1 }),
  payment: money(example.original.monthlyPayment),
  interest: money(example.original.totalInterest),
  repayment: money(EARLY_REPAYMENT_EXAMPLE.repayment, 0),
  balanceAfter: money(example.balanceAfter, 0),
  newPayment: money(example.lowerPayment.monthlyPayment),
  paymentDrop: money(example.lowerPayment.paymentReduction),
  lowerSaved: money(example.lowerPayment.interestSaved),
  newTerm: duration(example.shorterTerm.months),
  timeSaved: duration(example.shorterTerm.monthsSaved),
  lastPayment: money(example.shorterTerm.lastPayment),
  shorterSaved: money(example.shorterTerm.interestSaved),
  feeRate: formatPercent(locale, EARLY_REPAYMENT_EXAMPLE.exampleFeePercent, { decimals: 1 }),
  fee: money(withFee.fee),
  lowerNet: money(withFee.lowerPayment.netSaving),
  shorterNet: money(withFee.shorterTerm.netSaving),
  minBalance: money(EARLY_REPAYMENT_LIMITS.minBalance, 0),
  maxBalance: money(EARLY_REPAYMENT_LIMITS.maxBalance, 0),
  maxYears: formatNumber(locale, EARLY_REPAYMENT_LIMITS.maxTermYears),
  maxRate: formatPercent(locale, EARLY_REPAYMENT_LIMITS.maxAnnualRate, { decimals: 0 }),
  maxFee: formatPercent(locale, EARLY_REPAYMENT_LIMITS.maxFeePercent, { decimals: 0 }),
};

const list = (key: string) =>
  Object.values(t<Record<string, string>>(k(key), { returnObjects: true }));
const checks = list("before.items");
const assumptions = list("method.assumptions");

// The loan tools a visitor weighing a repayment needs next.
const related = [
  { key: "mortgage", href: toLocalizedPath("toolMortgage", locale) },
  { key: "debtToIncome", href: toLocalizedPath("toolDebtToIncome", locale) },
  { key: "emergencyFund", href: toLocalizedPath("toolEmergencyFund", locale) },
] as const;

const linkClass =
  "font-medium text-primary underline decoration-primary/40 underline-offset-4 hover:opacity-80";
---

<ToolGuide>
  <section aria-labelledby="early-repayment-choice">
    <h2 id="early-repayment-choice" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("choice.title"))}
    </h2>
    <div class="mt-3 space-y-4 leading-7">
      <p>{t(k("choice.intro"))}</p>
      <ul class="list-disc space-y-2 pl-5">
        <li>
          <strong class="font-semibold text-foreground">{t(k("choice.lowerPaymentTitle"))}</strong>{" "}
          {t(k("choice.lowerPayment"))}
        </li>
        <li>
          <strong class="font-semibold text-foreground">{t(k("choice.shorterTermTitle"))}</strong>{" "}
          {t(k("choice.shorterTerm"))}
        </li>
      </ul>
      <p>{t(k("choice.outro"))}</p>
    </div>
  </section>

  <section aria-labelledby="early-repayment-before">
    <h2 id="early-repayment-before" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("before.title"))}
    </h2>
    <ul class="mt-3 list-disc space-y-2 pl-5 leading-7">
      {checks.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section aria-labelledby="early-repayment-example">
    <h2 id="early-repayment-example" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("example.title"))}
    </h2>
    <div class="mt-3 space-y-4 leading-7">
      <p>{t(k("example.setup"), values)}</p>
      <p>{t(k("example.lowerPayment"), values)}</p>
      <p>{t(k("example.shorterTerm"), values)}</p>
      <p>{t(k("example.fee"), values)}</p>
    </div>
  </section>

  <section aria-labelledby="early-repayment-method">
    <h2 id="early-repayment-method" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("method.title"))}
    </h2>
    <div class="mt-3 space-y-4 leading-7">
      <p>{t(k("method.intro"))}</p>
      <p class="rounded-lg bg-paper-2 px-4 py-3 font-mono text-foreground">
        M = P × r ÷ (1 − (1 + r)<sup>−n</sup>)
      </p>
      <p>{t(k("method.legend"))}</p>
      <p>{t(k("method.lowerPayment"))}</p>
      <p>{t(k("method.shorterTerm"))}</p>
      <p>{t(k("method.fee"))}</p>
    </div>
    <h3 class="mt-8 font-semibold text-foreground">{t(k("method.assumptionsTitle"))}</h3>
    <ul class="mt-3 list-disc space-y-2 pl-5 leading-7">
      {assumptions.map((item) => <li>{item}</li>)}
      <li>{t(k("method.limits"), values)}</li>
    </ul>
  </section>

  <section aria-labelledby="early-repayment-related">
    <h2 id="early-repayment-related" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("related.title"))}
    </h2>
    <ul class="mt-3 space-y-3 leading-7">
      {
        related.map((item) => (
          <li>
            <a href={item.href} class={linkClass}>
              {t(k(`related.${item.key}Link`))}
            </a>
            <p>{t(k(`related.${item.key}Body`))}</p>
          </li>
        ))
      }
    </ul>
  </section>
</ToolGuide>
