---
// Prerendered explanation for the early repayment calculator: the two ways to use a repayment,
// what to check first, a worked example computed from the same function the calculator runs
// (earlyRepaymentGuide.ts), and the method, on the guide building blocks.
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildEarlyRepaymentGuide } from "./earlyRepaymentGuide";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.earlyRepayment.guide.${key}`;
const guide = buildEarlyRepaymentGuide(locale);
const { values } = guide;

// The loan tools a visitor weighing a repayment needs next.
const related = [
  { key: "mortgage", href: toLocalizedPath("toolMortgage", locale) },
  { key: "debtToIncome", href: toLocalizedPath("toolDebtToIncome", locale) },
  { key: "emergencyFund", href: toLocalizedPath("toolEmergencyFund", locale) },
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(k("choice.title"))}</h2>
    <p>{t(k("choice.intro"))}</p>
    <GuideTermList items={guide.choices} />
    <p>{t(k("choice.outro"))}</p>
  </section>

  <section>
    <h2>{t(k("before.title"))}</h2>
    <GuideTermList items={guide.checks} />
  </section>

  <section>
    <h2>{t(k("example.title"))}</h2>
    <p>{t(k("example.setup"), values)}</p>
    <GuideFigures items={guide.repayment} operators={["−", "="]} />
    <p>{t(k("example.lowerPayment"), values)}</p>
    <p>{t(k("example.shorterTerm"), values)}</p>
    <GuideFigures variant="grid" items={guide.outcomes} />
    <GuideFigures variant="grid" items={guide.interestSaved} caption={t("tools.earlyRepayment.table.interestSaved")} />
    <p>{t(k("example.fee"), values)}</p>
    <GuideFigures variant="grid" items={guide.netSaving} caption={t("tools.earlyRepayment.table.netSaving")} />
  </section>

  <section>
    <h2>{t(k("method.title"))}</h2>
    <p>{t(k("method.intro"))}</p>
    <GuideFormula lines={guide.formulas} label={t(k("method.formulasLabel"))} />
    <p>{t(k("method.zeroRate"))}</p>
    <GuideTermList items={guide.notes} />
    <h3 class="font-semibold text-foreground">{t(k("method.assumptionsTitle"))}</h3>
    <GuideTermList items={guide.assumptions} />
  </section>

  <section>
    <h2>{t(k("related.title"))}</h2>
    <ul class="space-y-3">
      {
        related.map((item) => (
          <li>
            <a href={item.href}>{t(k(`related.${item.key}Link`))}</a>
            <p>{t(k(`related.${item.key}Body`))}</p>
          </li>
        ))
      }
    </ul>
  </section>
</ToolGuide>
