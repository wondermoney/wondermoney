---
// Prerendered explanation, worked example and method for the variable-rate payment calculator,
// on the guide building blocks. The figures come from the same function the calculator runs,
// starting from its first state (rateRevisionGuide.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildRateRevisionGuide } from "./rateRevisionGuide";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.rateRevision.guide.${key}`;
const guide = buildRateRevisionGuide(locale);
const { values } = guide;

// The loan tools a visitor facing a higher payment needs next.
const related = [
  { routeId: "toolMortgage", key: "relatedMortgage", title: t("tools.mortgage.title") },
  { routeId: "toolDebtToIncome", key: "relatedDebtToIncome", title: t("tools.debtToIncome.title") },
  { routeId: "toolEarlyRepayment", key: "relatedEarlyRepayment", title: t("tools.earlyRepayment.title") },
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(k("whatTitle"))}</h2>
    <p>{t(k("whatBody1"))}</p>
    <p>{t(k("whatBody2"))}</p>
    <p>{t(k("whatBody3"))}</p>
    <ul class="list-disc space-y-2 pl-6">
      {
        related.map((item) => (
          <li>
            <a href={toLocalizedPath(item.routeId, locale)}>{item.title}</a>{": "}{t(k(item.key))}
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>{t(k("exampleTitle"))}</h2>
    <p>{t(k("exampleSetup"), values)}</p>
    <p>{t(k("exampleRise"), values)}</p>
    <GuideFigures items={guide.rise} operators={["+", "="]} />
    <p>{t(k("exampleStress"), values)}</p>
    <p>{t(k("exampleIncome"), values)}</p>
    <GuideFigures variant="grid" items={guide.incomeShares} />
  </section>

  <section>
    <h2>{t(k("methodTitle"))}</h2>
    <p>{t(k("methodIntro"))}</p>
    <GuideFormula lines={guide.formulas} label={t(k("methodFormulasLabel"))} />
    <p>{t(k("zeroRate"))}</p>
    <GuideTermList items={guide.notes} />
    <h3 class="font-semibold text-foreground">{t(k("assumptionsTitle"))}</h3>
    <GuideTermList items={guide.assumptions} />
  </section>

  <section>
    <h2>{t(k("contractTitle"))}</h2>
    <p>{t(k("contractIntro"))}</p>
    <GuideTermList items={guide.contract} />
    <p>{t(k("contractOutro"))}</p>
  </section>
</ToolGuide>
