---
import { PROPERTY_TAX_EXAMPLE, computePropertyTax } from "@/lib/calculators/propertyTax";
import { formatMoney, formatPercent } from "@/lib/numberFormat";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.propertyTax.guide.${key}`;
const example = computePropertyTax(PROPERTY_TAX_EXAMPLE);
if (!example.ok) throw new Error("Invalid property tax worked example");

const money = (value: number, decimals = 2) => formatMoney(locale, value, { decimals });
const { annualTax, monthlyProvision, schedule } = example.result;
const values = {
  vpt: money(PROPERTY_TAX_EXAMPLE.vpt, 0),
  rate: formatPercent(locale, PROPERTY_TAX_EXAMPLE.rate, { decimals: 2 }),
  tax: money(annualTax),
  instalment: money(schedule[0].amount),
  monthly: money(monthlyProvision),
};
const sources = [
  ["sourceRates", "https://info.portaldasfinancas.gov.pt/pt/informacao_fiscal/codigos_tributarios/cimi/Pages/cimi112.aspx"],
  ["sourcePayment", "https://info.portaldasfinancas.gov.pt/pt/informacao_fiscal/codigos_tributarios/cimi/Pages/cimi120.aspx"],
  ["sourceExemption", "https://www.portaldasfinancas.gov.pt/"],
] as const;
---

<div class="mt-12 max-w-3xl space-y-10 text-base leading-7 text-ink-2">
  <section aria-labelledby="property-tax-example">
    <h2 id="property-tax-example" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("exampleTitle"))}
    </h2>
    <p class="mt-4">{t(k("example"), values)}</p>
  </section>
  <section aria-labelledby="property-tax-method">
    <h2 id="property-tax-method" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("methodTitle"))}
    </h2>
    <ul class="mt-4 list-disc space-y-2 pl-6">
      {["methodTax", "methodFamily", "methodPayment", "methodBudget"].map((key) => <li>{t(k(key))}</li>)}
    </ul>
    <h3 class="mt-8 font-semibold text-foreground">{t(k("exemptionTitle"))}</h3>
    <p class="mt-3">{t(k("exemption"))}</p>
    <h3 class="mt-8 font-semibold text-foreground">{t(k("assumptionsTitle"))}</h3>
    <ul class="mt-3 list-disc space-y-2 pl-6">
      {["assumptionRate", "assumptionScope", "assumptionEducational"].map((key) => <li>{t(k(key))}</li>)}
    </ul>
    <h3 class="mt-8 font-semibold text-foreground">{t(k("sourcesTitle"))}</h3>
    <ul class="mt-3 list-disc space-y-2 pl-6">
      {sources.map(([key, href]) => (
        <li>
          <a href={href} rel="noopener" class="font-medium text-primary underline decoration-primary/40 underline-offset-4 hover:opacity-80">
            {t(k(key))}
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-sm">{t(k("reviewed"))}</p>
  </section>
</div>
