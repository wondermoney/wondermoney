---
// Prerendered worked example and method for the IMI calculator, on the guide building blocks.
// The figures come from the same function the calculator runs (propertyTaxGuide.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildPropertyTaxGuide } from "./propertyTaxGuide";
import { EBF_46 } from "@/lib/calculators/propertyTax";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.propertyTax.guide.${key}`;
const guide = buildPropertyTaxGuide(locale);
const sources = [
  ["sourceRates", "https://info.portaldasfinancas.gov.pt/pt/informacao_fiscal/codigos_tributarios/cimi/Pages/cimi112.aspx"],
  ["sourcePayment", "https://info.portaldasfinancas.gov.pt/pt/informacao_fiscal/codigos_tributarios/cimi/Pages/cimi120.aspx"],
  ["sourceMinimum", "https://info.portaldasfinancas.gov.pt/pt/informacao_fiscal/codigos_tributarios/cimi/Pages/cimi113.aspx"],
  ["sourceExemption", "https://info.portaldasfinancas.gov.pt/pt/informacao_fiscal/codigos_tributarios/cimi/Pages/cimi11a.aspx"],
  ["sourceEbf", EBF_46.source],
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(k("exampleTitle"))}</h2>
    <p>{t(k("example"), guide.values)}</p>
    <GuideFigures items={guide.tax} operators={["×", "="]} />
    <GuideFigures variant="grid" items={guide.instalments} caption={t("tools.propertyTax.result.scheduleTitle")} />
  </section>

  <section>
    <h2>{t(k("methodTitle"))}</h2>
    <GuideFormula lines={guide.formulas} label={t(k("formulasLabel"))} />
    <GuideTermList items={guide.notes} />
    <h3 class="font-semibold text-foreground">{t(k("exemptionTitle"))}</h3>
    <p>{t(k("exemption"), guide.exemptionValues)}</p>
    <h3 class="font-semibold text-foreground">{t(k("assumptionsTitle"))}</h3>
    <GuideTermList items={guide.assumptions} />
    <h3 class="font-semibold text-foreground">{t(k("sourcesTitle"))}</h3>
    <ul class="list-disc space-y-2 pl-6">
      {sources.map(([key, href]) => (
        <li>
          <a href={href} rel="noopener">{t(k(key))}</a>
        </li>
      ))}
    </ul>
    <p class="text-sm">{t(k("reviewed"))}</p>
  </section>
</ToolGuide>
