---
// Prerendered guide under the FIRE calculator: what FIRE is, a worked example, the method
// and how to track the number in WonderMoney, on the guide building blocks (guideBlocks.ts).
// The example's figures come from the same calculation the calculator runs (fireGuide.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildFireGuide } from "./fireGuide";
import type { Lang } from "@/lib/i18nLocale";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.fire.guide.${key}`;
const page = (key: string) => `lp.fireCalculator.${key}`;

const guide = buildFireGuide(locale);
const { values } = guide;

const trackSteps = [1, 2, 3].map((number) => ({
  title: t(page(`track${number}Title`)),
  body: t(page(`track${number}Body`)),
}));
---

<ToolGuide>
  <section>
    <h2>{t(page("whatTitle"))}</h2>
    <p>{t(page("whatBody1"))}</p>
    <p>{t(page("whatBody2"))}</p>
    <p>{t(page("whatBody3"))}</p>
  </section>

  <section>
    <h2>{t(k("exampleHeading"))}</h2>
    <p>{t(k("exampleBody"), values)}</p>
    <GuideFigures items={guide.flow} operators={guide.flowOperators} />
    <p>{t(k("exampleTarget"), values)}</p>
    <p>{t(k("exampleTime"), values)}</p>
    <GuideFigures variant="grid" items={guide.outcome} />
  </section>

  <section>
    <h2>{t(k("methodHeading"))}</h2>
    <GuideFormula lines={guide.formulas} label={t(k("methodFormulasLabel"))} />
    <GuideTermList items={guide.notes} />
  </section>

  <section>
    <h2>{t(page("trackTitle"))}</h2>
    <ol class="list-decimal space-y-4 pl-6">
      {trackSteps.map((step) => (
        <li>
          <h3 class="font-semibold text-foreground">{step.title}</h3>
          <p class="mt-1">{step.body}</p>
        </li>
      ))}
    </ol>
  </section>
</ToolGuide>
