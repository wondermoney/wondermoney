---
// Prerendered worked example and method for the FIRE calculator. The figures
// come from the same calculation the calculator runs, at build time.
import {
  FIRE_MAX_YEARS,
  FIRE_SPENDING_CUT,
  FIRE_WORKED_EXAMPLE,
  calculateFire,
} from "@/lib/calculators/fire";
import { formatFireDuration } from "@/lib/calculators/fireFormat";
import { formatMoney, formatPercent } from "@/lib/numberFormat";
import type { Lang } from "@/lib/i18nLocale";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.fire.guide.${key}`;

const example = FIRE_WORKED_EXAMPLE;
const result = calculateFire(example);
const cut = calculateFire({
  ...example,
  annualSpending: example.annualSpending * (1 - FIRE_SPENDING_CUT / 100),
});

// The worked example is fixed, so a change to the calculation that stops it
// projecting a date has to fail the build rather than print an empty sentence.
if (result.monthsToTarget === null || cut.monthsToTarget === null || result.progress === null) {
  throw new Error("The FIRE worked example no longer reaches its target");
}

const money = (value: number) => formatMoney(locale, value);
const rate = (value: number) =>
  formatPercent(locale, value, { decimals: Number.isInteger(value) ? 0 : 1 });

const values = {
  spending: money(example.annualSpending),
  assets: money(example.currentAssets),
  contribution: money(example.monthlyContribution),
  return: rate(example.realReturn),
  rate: rate(example.withdrawalRate),
  target: money(result.fireNumber),
  progress: rate(Math.round(result.progress * 10) / 10),
  time: formatFireDuration(locale, result.monthsToTarget),
  cut: formatPercent(locale, FIRE_SPENDING_CUT, { decimals: 0 }),
  cutSpending: money(cut.inputs.annualSpending),
  cutTarget: money(cut.fireNumber),
  cutTime: formatFireDuration(locale, cut.monthsToTarget),
};

const methodItems = ["methodMultiple", "methodGrowth", "methodRealMoney", "methodHorizon", "methodLeftOut", "methodPrivacy"];
---

<div class="mx-auto max-w-3xl space-y-10 text-base leading-7 text-ink-2">
  <section>
    <h2 class="text-2xl font-semibold tracking-tight text-foreground">{t(k("exampleHeading"))}</h2>
    <p class="mt-3">{t(k("exampleBody"), values)}</p>
    <p class="mt-3 rounded-lg border border-border bg-paper-2 px-4 py-3 font-mono text-sm text-foreground">
      {values.spending} ÷ {values.rate} = {values.target}
    </p>
    <p class="mt-3">{t(k("exampleTarget"), values)}</p>
    <p class="mt-3">{t(k("exampleTime"), values)}</p>
  </section>

  <section>
    <h2 class="text-2xl font-semibold tracking-tight text-foreground">{t(k("methodHeading"))}</h2>
    <p class="mt-3 rounded-lg border border-border bg-paper-2 px-4 py-3 text-sm text-foreground">
      {t(k("methodFormula"))}
    </p>
    <ul class="mt-4 list-disc space-y-2 pl-5">
      {methodItems.map((item) => <li>{t(k(item), { years: FIRE_MAX_YEARS })}</li>)}
    </ul>
  </section>
</div>
