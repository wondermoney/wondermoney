---
// Prerendered explanation, worked example and method for the borrowing capacity calculator,
// on the guide building blocks. The figures come from the same function the calculator runs,
// starting from its first state (borrowingCapacityGuide.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildBorrowingCapacityGuide } from "./borrowingCapacityGuide";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.borrowingCapacity.guide.${key}`;
const guide = buildBorrowingCapacityGuide(locale);
const { values } = guide;

const related = [
  { routeId: "toolMortgage", key: "relatedMortgage", title: t("tools.mortgage.title") },
  { routeId: "toolDebtToIncome", key: "relatedDebtToIncome", title: t("tools.debtToIncome.title") },
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(k("whatTitle"))}</h2>
    <p>{t(k("whatBody1"))}</p>
    <p>{t(k("whatBody2"))}</p>
    <p>{t(k("whatBody3"))}</p>
    <ul class="list-disc space-y-2 pl-6">
      {
        related.map((item) => (
          <li>
            <a href={toLocalizedPath(item.routeId, locale)}>{item.title}</a>{": "}{t(k(item.key))}
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>{t(k("exampleTitle"))}</h2>
    <p>{t(k("exampleIntro"), values)}</p>
    <GuideTermList items={guide.steps} columns={1} />
    <p>{t(k("exampleStep4"), values)}</p>
    <GuideFigures variant="grid" items={guide.limits} />
    <p>{t(k("exampleResult"), values)}</p>
    <GuideFigures items={guide.purchase} operators={["+", "="]} />
    <p>{t(k("exampleLift"), values)}</p>
    <p>{t(k("exampleSavings"), values)}</p>
  </section>

  <section>
    <h2>{t(k("methodTitle"))}</h2>
    <p>{t(k("methodIntro"))}</p>
    <GuideFormula lines={guide.formulas} label={t(k("methodFormulasLabel"))} />
    <GuideTermList items={guide.notes} />
    <h3 class="font-semibold text-foreground">{t(k("assumptionsTitle"))}</h3>
    <GuideTermList items={guide.assumptions} />
  </section>

  <section>
    <h2>{t(k("lendersTitle"))}</h2>
    <p>{t(k("lendersIntro"))}</p>
    <GuideTermList items={guide.lenderRules} />
    <p>{t(k("lendersOutro"))}</p>
  </section>
</ToolGuide>
