---
// Prerendered explanation, worked example and method for the buy versus rent calculator, on
// the guide building blocks. The figures come from the same calculation the calculator runs
// (buyVsRentGuide.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildBuyVsRentGuide } from "./buyVsRentGuide";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.buyVsRent.guide.${key}`;
const guide = buildBuyVsRentGuide(locale);
const { values } = guide;

const leftOutItems = Object.values(t<Record<string, string>>(k("leftOut"), { returnObjects: true }));
const mortgageHref = toLocalizedPath("toolMortgage", locale);
const netWorthHref = toLocalizedPath("toolNetWorth", locale);
---

<ToolGuide>
  <section>
    <h2>{t(k("whatHeading"))}</h2>
    <p>{t(k("whatBody"))}</p>
    <GuideTermList items={guide.read} />
  </section>

  <section>
    <h2>{t(k("exampleHeading"))}</h2>
    <p>{t(k("example.setup"), values)}</p>
    <p>{t(k("example.start"), values)}</p>
    <p>{t(k("example.monthly"), values)}</p>
    <p>{t(k("example.result"), values)}</p>
    <GuideFigures items={guide.owner} operators={["−", "−", "="]} />
    <GuideFigures items={guide.paths} operators={["−", "="]} />
    <p>{t(k("example.breakEven"), values)}</p>
  </section>

  <section>
    <h2>{t(k("methodHeading"))}</h2>
    <p>{t(k("methodIntro"))}</p>
    <GuideFormula lines={guide.formulas} label={t(k("formulasLabel"))} />
    <p>{t(k("formulaExample"), values)}</p>
    <GuideTermList items={guide.notes} />
    <h3 class="font-semibold text-foreground">{t(k("leftOutHeading"))}</h3>
    <ul class="list-disc space-y-2 pl-5">
      {leftOutItems.map((item) => <li>{item}</li>)}
      <li>{t(k("limits"), values)}</li>
    </ul>
  </section>

  <section>
    <h2>{t(k("relatedHeading"))}</h2>
    <p>
      {t(k("relatedMortgage"))} <a href={mortgageHref}>{t(k("relatedMortgageLink"))}</a>.
    </p>
    <p>
      {t(k("relatedNetWorth"))} <a href={netWorthHref}>{t(k("relatedNetWorthLink"))}</a>.
    </p>
  </section>
</ToolGuide>
