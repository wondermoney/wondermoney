---
// Prerendered explanation, worked example and method for the personal loan calculator, on the
// guide building blocks. The figures come from the same function the calculator runs,
// starting from its first state (personalLoanGuide.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildPersonalLoanGuide } from "./personalLoanGuide";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.personalLoan.guide.${key}`;
const guide = buildPersonalLoanGuide(locale);
const { values } = guide;

// Before borrowing: does the payment fit next to other credit, and inside the budget.
const related = [
  { routeId: "toolDebtToIncome", key: "relatedDebtToIncome", title: t("tools.debtToIncome.title") },
  { routeId: "toolHouseholdBudget", key: "relatedHouseholdBudget", title: t("tools.householdBudget.title") },
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(k("whatTitle"))}</h2>
    <p>{t(k("whatBody1"))}</p>
    <p>{t(k("whatBody2"))}</p>
    <p>{t(k("whatBody3"))}</p>
    <ul class="list-disc space-y-2 pl-6">
      {
        related.map((item) => (
          <li>
            <a href={toLocalizedPath(item.routeId, locale)}>{item.title}</a>{": "}{t(k(item.key))}
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>{t(k("aprTitle"))}</h2>
    <p>{t(k("aprBody1"))}</p>
    <p>{t(k("aprBody2"))}</p>
    <p>{t(k("aprBody3"))}</p>
  </section>

  <section>
    <h2>{t(k("exampleTitle"))}</h2>
    <p>{t(k("exampleIntro"), values)}</p>
    <p>{t(k("exampleNoFees"), values)}</p>
    <GuideFigures items={guide.noFees} operators={["+", "="]} />
    <p>{t(k("exampleFees"), values)}</p>
    <GuideFigures variant="grid" items={guide.fees} />
    <p>{t(k("exampleApr"), values)}</p>
    <GuideFigures variant="grid" items={guide.rates} />
    <p>{t(k("exampleOutro"))}</p>
  </section>

  <section>
    <h2>{t(k("methodTitle"))}</h2>
    <p>{t(k("methodIntro"))}</p>
    <GuideFormula lines={guide.formulas} label={t(k("methodFormulasLabel"))} />
    <GuideTermList items={guide.notes} />
    <h3 class="font-semibold text-foreground">{t(k("assumptionsTitle"))}</h3>
    <GuideTermList items={guide.assumptions} />
  </section>
</ToolGuide>
