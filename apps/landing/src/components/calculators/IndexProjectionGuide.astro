---
// Prerendered worked example and method for the index projection on the investment return
// page, on the guide building blocks (guideBlocks.ts). The figures come from the same
// calculation the projection runs (indexProjectionGuide.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildIndexProjectionGuide } from "./indexProjectionGuide";
import type { Lang } from "@/lib/i18nLocale";
import { getTranslations } from "@/lib/translations";

const { locale } = Astro.props as { locale: Lang };
const t = getTranslations(locale);
const key = "tools.investmentReturn.projection";
const guide = buildIndexProjectionGuide(locale);
---

<ToolGuide>
  <section>
    <h2>{t(`${key}.exampleTitle`)}</h2>
    <p>{t(`${key}.example`, guide.values)}</p>
    <GuideFigures items={guide.flow} operators={guide.flowOperators} />
  </section>

  <section>
    <h2>{t(`${key}.methodTitle`)}</h2>
    <GuideFormula lines={guide.formulas} label={t(`${key}.methodFormulasLabel`)} />
    <GuideTermList items={guide.notes} columns={1} />
  </section>
</ToolGuide>
