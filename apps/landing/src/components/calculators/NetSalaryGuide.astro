---
// Prerendered worked example and method for the net salary calculator, on the guide building
// blocks (guideBlocks.ts). The figures come from the calculator's own function (salaryGuides.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildNetSalaryGuide } from "./salaryGuides";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.netSalary.guide.${key}`;
const guide = buildNetSalaryGuide(locale);
const sources = [
  ["sourceDespacho", "https://info.portaldasfinancas.gov.pt/pt/informacao_fiscal/legislacao/Despachos_SEAF/Documents/Despacho-SEAF-2026-01-05-XXV.pdf"],
  ["sourceRegional", "https://info.portaldasfinancas.gov.pt/pt/apoio_contribuinte/tabela_ret_doclib/Pages/default.aspx"],
  ["sourceMeal", "https://www.portaldasfinancas.gov.pt/"],
  ["sourceSocialSecurity", "https://www.seg-social.pt/"],
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(k("exampleTitle"))}</h2>
    <p>{t(k("example"), guide.values)}</p>
    <GuideFigures items={guide.flow} operators={guide.flowOperators} />
  </section>
  <section>
    <h2>{t(k("methodTitle"))}</h2>
    <GuideTermList items={guide.notes} />
    <h3 class="font-semibold text-foreground">{t(k("finalTitle"))}</h3>
    <p>{t(k("final"))}</p>
    <h3 class="font-semibold text-foreground">{t(k("unsupportedTitle"))}</h3>
    <ul class="list-disc space-y-2 pl-6">
      {["unsupportedYouth", "unsupportedDisability", "unsupportedNovember", "unsupportedOther"].map((key) => <li>{t(k(key))}</li>)}
    </ul>
    <h3 class="font-semibold text-foreground">{t(k("sourcesTitle"))}</h3>
    <ul class="list-disc space-y-2 pl-6">
      {sources.map(([key, href]) => (
        <li>
          <a href={href} rel="noopener">{t(k(key))}</a>
        </li>
      ))}
    </ul>
    <p class="text-sm">{t(k("reviewed"))}</p>
  </section>
</ToolGuide>
