---
// Prerendered explanation, worked example and method for the term deposit calculator, on
// the guide building blocks (guideBlocks.ts). The figures come from the same calculation the
// calculator runs (termDepositGuide.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildTermDepositGuide } from "./termDepositGuide";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.termDeposit.guide.${key}`;

const guide = buildTermDepositGuide(locale);
const { values } = guide;

const compoundInterestHref = toLocalizedPath("toolCompoundInterest", locale);
const emergencyFundHref = toLocalizedPath("toolEmergencyFund", locale);
const savingsGoalHref = toLocalizedPath("toolSavingsGoal", locale);
---

<ToolGuide>
  <section>
    <h2>{t(k("whatHeading"))}</h2>
    <p>{t(k("whatBody"))}</p>
  </section>

  <section>
    <h2>{t(k("readHeading"))}</h2>
    <GuideTermList items={guide.readTerms} />
  </section>

  <section>
    <h2>{t(k("exampleHeading"))}</h2>
    <p>{t(k("exampleSetup"), values)}</p>
    <GuideFigures items={guide.maturityFlow} operators={guide.maturityOperators} />
    <p>{t(k("exampleCompounded"), values)}</p>
    <p>{t(k("exampleTax"), values)}</p>
    <GuideFigures items={guide.taxFlow} operators={guide.taxOperators} />
  </section>

  <section>
    <h2>{t(k("methodHeading"))}</h2>
    <p>{t(k("methodIntro"))}</p>
    <GuideFormula lines={guide.formulas} label={t(k("methodFormulasLabel"))} />
    <GuideTermList items={guide.notes} />
    <p>{t(k("methodLimits"), values)}</p>
  </section>

  <section>
    <h2>{t(k("nextHeading"))}</h2>
    <p>
      {t(k("nextCompound"))}{" "}
      <a href={compoundInterestHref}>{t(k("nextCompoundLink"))}</a>
    </p>
    <p>
      {t(k("nextEmergency"))}{" "}
      <a href={emergencyFundHref}>{t(k("nextEmergencyLink"))}</a>
    </p>
    <p>
      {t(k("nextSavingsGoal"))}{" "}
      <a href={savingsGoalHref}>{t(k("nextSavingsGoalLink"))}</a>
    </p>
  </section>
</ToolGuide>
