---
// Prerendered worked example and method for the inflation calculator, on the guide building
// blocks (guideBlocks.ts). The figures come from the same function the calculator runs
// (inflationGuide.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import { buildInflationGuide } from "./inflationGuide";
import { CPI_SOURCE, CPI_YEARS } from "@/lib/calculators/portugalCpi";
import { toIntlLocale } from "@/lib/numberFormat";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const key = (name: string) => `tools.inflation.guide.${name}`;

const guide = buildInflationGuide(locale);

const retrieved = new Intl.DateTimeFormat(toIntlLocale(locale), {
  dateStyle: "long",
  timeZone: "UTC",
}).format(new Date(CPI_SOURCE.retrieved));
---

<ToolGuide>
  <section>
    <h2>{t(key("exampleTitle"))}</h2>
    <p>{t(key("exampleBudget"), guide.values)}</p>
    <GuideFigures items={guide.budget} operators={["→"]} />
    <p>{t(key("exampleInvestment"), guide.values)}</p>
    <GuideFigures items={guide.investment} operators={["→"]} />
  </section>
  <section>
    <h2>{t(key("methodTitle"))}</h2>
    <p>{t(key("method"), { baseYear: CPI_SOURCE.baseYear })}</p>
    <GuideFormula lines={guide.formulas} label={t(key("methodFormulasLabel"))} />
    <p>{t(key("limitations"))}</p>
    <p>{t(key("coverage"), { first: CPI_YEARS[0], last: CPI_YEARS.at(-1) })}</p>
    <p>
      {t(key("retrieved"), { date: retrieved })}
      {" "}
      <a href={CPI_SOURCE.url}>{t(key("source"), { id: CPI_SOURCE.id })}</a>
      {" · "}
      <a href={CPI_SOURCE.methodologyUrl}>{t(key("methodology"))}</a>
    </p>
  </section>
</ToolGuide>
