---
// Prerendered explanation for the term deposit offers comparison: what the table is and is not, a
// worked example computed by the same function the table runs (termDepositOffersGuide.ts), the
// method, the data and its date, what the figures leave out, and the tools to go on with, on the
// guide building blocks (guideBlocks.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildTermDepositOffersGuide } from "./termDepositOffersGuide";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.termDepositOffers.guide.${key}`;

const guide = buildTermDepositOffersGuide(locale);
const { values } = guide;

// Each item goes through t() so its {{placeholders}} are filled like any other string.
const limits = Object.keys(t<Record<string, string>>(k("limits.items"), { returnObjects: true })).map((item) =>
  t(`${k("limits.items")}.${item}`, values),
);

const related = [
  { key: "termDeposit", href: toLocalizedPath("toolTermDeposit", locale) },
  { key: "depositRateIndex", href: toLocalizedPath("toolDepositRateIndex", locale) },
  { key: "savingsCertificates", href: toLocalizedPath("toolSavingsCertificates", locale) },
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(k("read.title"))}</h2>
    <p>{t(k("read.what"), values)}</p>
    <p>{t(k("read.noRecommendation"))}</p>
  </section>

  <section>
    <h2>{t(k("example.title"))}</h2>
    <p>{t(k("example.setup"), values)}</p>
    <GuideFigures items={guide.flow} operators={guide.flowOperators} />
  </section>

  <section>
    <h2>{t(k("method.title"))}</h2>
    <p>{t(k("method.intro"))}</p>
    <GuideTermList items={guide.steps} />
  </section>

  <section>
    <h2>{t(k("data.title"))}</h2>
    <p>{t(k("data.source"), values)}</p>
    <p>{t(k("data.refresh"))}</p>
    <p>
      {t(k("data.fgd"))}{" "}
      <a href="https://www.fgd.pt/en" rel="noopener" target="_blank">fgd.pt</a>
    </p>
  </section>

  <section>
    <h2>{t(k("limits.title"))}</h2>
    <ul class="list-disc space-y-2 pl-6">
      {limits.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section>
    <h2>{t(k("related.title"))}</h2>
    <ul class="space-y-3">
      {
        related.map((item) => (
          <li>
            <a href={item.href}>{t(k(`related.${item.key}Link`))}</a>
            <p>{t(k(`related.${item.key}Body`))}</p>
          </li>
        ))
      }
    </ul>
  </section>
</ToolGuide>
