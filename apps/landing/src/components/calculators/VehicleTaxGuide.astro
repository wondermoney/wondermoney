---
// Prerendered worked example and method for the IUC calculator, on the guide building blocks.
// The figures come from the same function the calculator runs (vehicleTaxGuide.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildVehicleTaxGuide } from "./vehicleTaxGuide";
import { IUC_TABLES } from "@/lib/calculators/vehicleTax";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.vehicleTax.guide.${key}`;
const guide = buildVehicleTaxGuide(locale);
const { values } = guide;
const base = "https://info.portaldasfinancas.gov.pt/pt/informacao_fiscal/codigos_tributarios/iuc/Pages/";
const sources = [
  ["sourceCategoryA", `${base}iuc9.aspx`],
  ["sourceCategoryB", `${base}iuc10.aspx`],
  ["sourcePayment", `${base}iuc17.aspx`],
  ["sourceDiesel", IUC_TABLES.dieselSurchargeSource],
  ["sourceBudget", IUC_TABLES.budgetSource],
  ["sourceSchedule", IUC_TABLES.schedule2027Source],
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(k("exampleTitle"))}</h2>
    <p>{t(k("example"), values)}</p>
    <GuideFigures items={guide.tax} operators={["×", "+", "="]} />
  </section>

  <section>
    <h2>{t(k("methodTitle"))}</h2>
    <GuideFormula lines={guide.formulas} label={t(k("formulasLabel"))} />
    <GuideTermList items={guide.notes} />
    <h3 class="font-semibold text-foreground">{t(k("exemptionTitle"))}</h3>
    <p>{t(k("exemption"))}</p>
    <h3 class="font-semibold text-foreground">{t(k("scopeTitle"))}</h3>
    <GuideTermList items={guide.scope} />
    <h3 class="font-semibold text-foreground">{t(k("assumptionsTitle"))}</h3>
    <GuideTermList items={guide.assumptions} />
    <h3 class="font-semibold text-foreground">{t(k("sourcesTitle"))}</h3>
    <ul class="list-disc space-y-2 pl-6">
      {sources.map(([key, href]) => (
        <li>
          <a href={href} rel="noopener">{t(k(key), values)}</a>
        </li>
      ))}
    </ul>
    <p class="text-sm">{t(k("reviewed"), values)}</p>
  </section>
</ToolGuide>
