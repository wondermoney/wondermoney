---
// Prerendered worked example and method for the property capital gains calculator, on the
// guide building blocks. The figures come from the same function the calculator runs
// (propertyCapitalGainsGuide.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildPropertyCapitalGainsGuide } from "./propertyCapitalGainsGuide";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.propertyCapitalGains.guide.${key}`;
const guide = buildPropertyCapitalGainsGuide(locale);
const { values } = guide;
const cirs = "https://info.portaldasfinancas.gov.pt/pt/informacao_fiscal/codigos_tributarios/cirs_rep/Pages/";
const sources = [
  ["sourceGains", `${cirs}irs43.aspx`],
  ["sourceRealization", `${cirs}irs44.aspx`],
  ["sourceAcquisition", `${cirs}irs46.aspx`],
  ["sourceCorrection", `${cirs}irs50.aspx`],
  ["sourceExpenses", `${cirs}irs51.aspx`],
  ["sourceExemption", `${cirs}irs10.aspx`],
  ["sourceImt", "https://info.portaldasfinancas.gov.pt/pt/informacao_fiscal/codigos_tributarios/cimt/Pages/cimt12.aspx"],
  ["sourceCoefficients", "https://diariodarepublica.pt/dr/detalhe/portaria/457-2026-1180341125"],
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(k("exampleTitle"))}</h2>
    <p>{t(k("example"), values)}</p>
    <GuideFigures items={guide.update} operators={["×", "="]} />
    <GuideFigures items={guide.gain} operators={["−", "−", "="]} />
    <GuideFigures variant="grid" items={guide.tax} />
  </section>

  <section>
    <h2>{t(k("methodTitle"))}</h2>
    <GuideFormula lines={guide.formulas} label={t(k("formulasLabel"))} />
    <GuideTermList items={guide.notes} />
    <h3 class="font-semibold text-foreground">{t(k("scopeTitle"))}</h3>
    <GuideTermList items={guide.scope} />
    <h3 class="font-semibold text-foreground">{t(k("assumptionsTitle"))}</h3>
    <GuideTermList items={guide.assumptions} />
    <h3 class="font-semibold text-foreground">{t(k("sourcesTitle"))}</h3>
    <ul class="list-disc space-y-2 pl-6">
      {sources.map(([key, href]) => (
        <li>
          <a href={href} rel="noopener">{t(k(key), values)}</a>
        </li>
      ))}
    </ul>
    <p class="text-sm">{t(k("reviewed"), values)}</p>
  </section>
</ToolGuide>
