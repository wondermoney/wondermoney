---
// Prerendered explanation, worked example, method and assumptions for the compound
// interest calculator, on the guide building blocks (guideBlocks.ts). The example is the
// calculator's starting state, computed by the same function (compoundInterestGuide.ts), so
// the prose and the tool never disagree.
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildCompoundInterestGuide } from "./compoundInterestGuide";
import type { Lang } from "@/lib/i18nLocale";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.compoundInterest.guide.${key}`;

const guide = buildCompoundInterestGuide(locale);
const { values } = guide;

const exampleSteps = ["exampleStep1", "exampleStep2", "exampleStep3"].map((key) => t(k(key), values));
const assumptions = ["assumption1", "assumption2", "assumption3", "assumption4"].map((key) => t(k(key)));
---

<ToolGuide>
  <section>
    <h2>{t(k("whatHeading"))}</h2>
    <p>{t(k("whatBody1"))}</p>
    <p>{t(k("whatBody2"))}</p>
  </section>

  <section>
    <h2>{t(k("realHeading"))}</h2>
    <p>{t(k("realBody1"))}</p>
    <p>{t(k("realBody2"))}</p>
  </section>

  <section>
    <h2>{t(k("exampleHeading"))}</h2>
    <p>{t(k("exampleIntro"), values)}</p>
    <GuideFigures items={guide.flow} operators={guide.flowOperators} />
    <ol class="list-decimal space-y-2 pl-6">
      {exampleSteps.map((step) => <li>{step}</li>)}
    </ol>
    <p>{t(k("exampleComparison"), values)}</p>
  </section>

  <section>
    <h2>{t(k("methodHeading"))}</h2>
    <GuideFormula lines={guide.formulas} label={t(k("methodFormulasLabel"))} />
    <GuideTermList items={guide.notes} />
  </section>

  <section>
    <h2>{t(k("assumptionsHeading"))}</h2>
    <ul class="list-disc space-y-2 pl-6">
      {assumptions.map((item) => <li>{item}</li>)}
    </ul>
    <p>{t(k("assumptionsNote"))}</p>
  </section>

  <section>
    <h2>{t(k("rateHeading"))}</h2>
    <p>{t(k("rateBody1"))}</p>
    <p>{t(k("rateBody2"))}</p>
  </section>
</ToolGuide>
