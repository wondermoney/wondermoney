---
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

const { locale } = Astro.props as { locale: Lang };
const t = getTranslations(locale);
const copy = (key: string) => t(`tools.investorProfile.${key}`);
---

<section class="mt-10 max-w-3xl space-y-4">
  <h2 class="text-2xl font-semibold tracking-tight">{copy("methodHeading")}</h2>
  <p class="text-muted-foreground">{copy("dimensions")}</p>
  <p class="text-muted-foreground">{copy("method")}</p>
  <h3 class="text-lg font-semibold tracking-tight">{copy("exampleHeading")}</h3>
  <p class="text-muted-foreground">{copy("example")}</p>
  <h3 class="text-lg font-semibold tracking-tight">{copy("assumptionsHeading")}</h3>
  <p class="text-muted-foreground">{copy("limitations")}</p>
  <p>
    <a
      href="https://www.investor.gov/introduction-investing/investing-basics/glossary/risk-tolerance"
      class="text-primary underline underline-offset-4"
    >{copy("source")}</a>
  </p>
</section>
