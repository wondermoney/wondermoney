---
// Prerendered method, worked example and limits for the investor profile quiz, on the guide
// building blocks (guideBlocks.ts). The example's scores come from the quiz's own scoring
// (investorProfileGuide.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import { buildInvestorProfileGuide } from "./investorProfileGuide";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

const { locale } = Astro.props as { locale: Lang };
const t = getTranslations(locale);
const copy = (key: string) => t(`tools.investorProfile.${key}`);
const guide = buildInvestorProfileGuide(locale);
---

<ToolGuide>
  <section>
    <h2>{copy("methodHeading")}</h2>
    <p>{copy("dimensions")}</p>
    <p>{copy("method")}</p>
  </section>

  <section>
    <h2>{copy("exampleHeading")}</h2>
    <p>{copy("example")}</p>
    <GuideFigures variant="grid" items={guide.figures} />
  </section>

  <section>
    <h2>{copy("assumptionsHeading")}</h2>
    <p>{copy("limitations")}</p>
    <p>
      <a href="https://www.investor.gov/introduction-investing/investing-basics/glossary/risk-tolerance">{copy("source")}</a>
    </p>
  </section>
</ToolGuide>
