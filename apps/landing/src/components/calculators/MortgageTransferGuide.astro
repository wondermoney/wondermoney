---
// Prerendered explanation for the mortgage transfer calculator: what to compare, the costs of
// switching, a worked example computed from the same function the calculator runs
// (mortgageTransferGuide.ts), and the method, on the guide building blocks.
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildMortgageTransferGuide } from "./mortgageTransferGuide";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.mortgageTransfer.guide.${key}`;
const guide = buildMortgageTransferGuide(locale);
const { values } = guide;

const costItems = Object.values(t<Record<string, string>>(k("costs.items"), { returnObjects: true }));

// The loan tools a visitor weighing a switch needs next.
const related = [
  { key: "mortgage", href: toLocalizedPath("toolMortgage", locale) },
  { key: "earlyRepayment", href: toLocalizedPath("toolEarlyRepayment", locale) },
  { key: "debtToIncome", href: toLocalizedPath("toolDebtToIncome", locale) },
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(k("compare.title"))}</h2>
    <p>{t(k("compare.intro"))}</p>
    <GuideTermList items={guide.compare} />
    <p>{t(k("compare.outro"))}</p>
  </section>

  <section>
    <h2>{t(k("costs.title"))}</h2>
    <p>{t(k("costs.intro"))}</p>
    <ul class="list-disc space-y-2 pl-5">
      {costItems.map((item) => <li>{item}</li>)}
    </ul>
    <p>{t(k("costs.outro"))}</p>
  </section>

  <section>
    <h2>{t(k("example.title"))}</h2>
    <p>{t(k("example.setup"), values)}</p>
    <GuideFigures items={guide.monthly} operators={["−", "="]} />
    <p>{t(k("example.costs"), values)}</p>
    <GuideFigures items={guide.costs} operators={["+", "+", "+"]} caption={t("tools.mortgageTransfer.results.switchingCosts")} />
    <p>{t(k("example.total"), values)}</p>
    <GuideFigures items={guide.totals} operators={["−", "="]} />
    <p>{t(k("example.longer"), values)}</p>
  </section>

  <section>
    <h2>{t(k("method.title"))}</h2>
    <p>{t(k("method.intro"))}</p>
    <GuideFormula lines={guide.formulas} label={t(k("method.formulasLabel"))} />
    <p>{t(k("method.zeroRate"))}</p>
    <GuideTermList items={guide.notes} />
    <h3 class="font-semibold text-foreground">{t(k("method.assumptionsTitle"))}</h3>
    <GuideTermList items={guide.assumptions} />
  </section>

  <section>
    <h2>{t(k("related.title"))}</h2>
    <ul class="space-y-3">
      {
        related.map((item) => (
          <li>
            <a href={item.href}>{t(k(`related.${item.key}Link`))}</a>
            <p>{t(k(`related.${item.key}Body`))}</p>
          </li>
        ))
      }
    </ul>
  </section>
</ToolGuide>
