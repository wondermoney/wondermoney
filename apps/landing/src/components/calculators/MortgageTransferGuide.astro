---
// Prerendered explanation for the mortgage transfer calculator: what to compare, the costs of
// switching, a worked example computed from the same function the calculator runs, and the
// method.
import {
  MORTGAGE_TRANSFER_EXAMPLE,
  MORTGAGE_TRANSFER_LIMITS,
  computeMortgageTransfer,
  type MortgageTransferInput,
  type MortgageTransferResult,
} from "@/lib/calculators/mortgageTransfer";
import { formatFireDuration as formatDuration } from "@/lib/calculators/fireFormat";
import { formatMoney, formatNumber, formatPercent } from "@/lib/numberFormat";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.mortgageTransfer.guide.${key}`;

const { exampleCosts, exampleLongerTermYears, ...defaults } = MORTGAGE_TRANSFER_EXAMPLE;

function calculate(overrides: Partial<MortgageTransferInput>): MortgageTransferResult {
  const calculation = computeMortgageTransfer({ ...defaults, ...exampleCosts, ...overrides });
  if (!calculation.ok) throw new Error("The mortgage transfer worked example has invalid inputs");
  return calculation.result;
}

const example = calculate({});
const longer = calculate({ newTermYears: exampleLongerTermYears });
if (example.breakEven.kind !== "month" || !longer.longerTerm || longer.netSaving >= 0) {
  throw new Error("The mortgage transfer worked example no longer tells its story");
}

const money = (value: number, decimals = 2) => formatMoney(locale, value, { decimals });
const duration = (months: number) => formatDuration(locale, months);
const percent = (value: number) => formatPercent(locale, value, { decimals: 1 });
const values = {
  balance: money(defaults.balance, 0),
  term: duration(example.current.months),
  currentRate: percent(defaults.currentRate),
  currentFees: money(defaults.currentMonthlyFees, 0),
  currentMonthly: money(example.current.monthlyTotal),
  newRate: percent(defaults.newRate),
  newFees: money(defaults.newMonthlyFees, 0),
  offerMonthly: money(example.offer.monthlyTotal),
  monthlySaving: money(example.monthlySaving),
  exitFeeRate: percent(exampleCosts.exitFeePercent),
  exitFee: money(example.costs.exitFee, 0),
  newLoanFees: money(example.costs.newLoanFees, 0),
  valuationFee: money(example.costs.valuationFee, 0),
  legalFees: money(example.costs.legalFees, 0),
  costs: money(example.costs.total, 0),
  breakEvenMonth: formatNumber(locale, example.breakEven.month),
  breakEvenTime: duration(example.breakEven.month),
  currentTotal: money(example.current.totalCost),
  offerTotal: money(example.offer.totalCost),
  netSaving: money(example.netSaving),
  interestSaved: money(example.interestSaved),
  longerTerm: duration(longer.offer.months),
  longerMonthly: money(longer.offer.monthlyTotal),
  longerSaving: money(longer.monthlySaving),
  extraInterest: money(longer.longerTerm.extraInterest),
  longerNetCost: money(-longer.netSaving),
  minBalance: money(MORTGAGE_TRANSFER_LIMITS.minBalance, 0),
  maxBalance: money(MORTGAGE_TRANSFER_LIMITS.maxBalance, 0),
  maxYears: formatNumber(locale, MORTGAGE_TRANSFER_LIMITS.maxTermYears),
  maxRate: formatPercent(locale, MORTGAGE_TRANSFER_LIMITS.maxAnnualRate, { decimals: 0 }),
  maxExitFee: formatPercent(locale, MORTGAGE_TRANSFER_LIMITS.maxExitFeePercent, { decimals: 0 }),
};

const list = (key: string) =>
  Object.values(t<Record<string, string>>(k(key), { returnObjects: true }));
const compareItems = list("compare.items");
const costItems = list("costs.items");
const assumptions = list("method.assumptions");

// The loan tools a visitor weighing a switch needs next.
const related = [
  { key: "mortgage", href: toLocalizedPath("toolMortgage", locale) },
  { key: "earlyRepayment", href: toLocalizedPath("toolEarlyRepayment", locale) },
  { key: "debtToIncome", href: toLocalizedPath("toolDebtToIncome", locale) },
] as const;

const linkClass =
  "font-medium text-primary underline decoration-primary/40 underline-offset-4 hover:opacity-80";
---

<div class="mt-12 max-w-3xl space-y-12 text-ink-2">
  <section aria-labelledby="mortgage-transfer-compare">
    <h2 id="mortgage-transfer-compare" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("compare.title"))}
    </h2>
    <div class="mt-3 space-y-4 leading-7">
      <p>{t(k("compare.intro"))}</p>
      <ul class="list-disc space-y-2 pl-5">
        {compareItems.map((item) => <li>{item}</li>)}
      </ul>
      <p>{t(k("compare.outro"))}</p>
    </div>
  </section>

  <section aria-labelledby="mortgage-transfer-costs">
    <h2 id="mortgage-transfer-costs" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("costs.title"))}
    </h2>
    <div class="mt-3 space-y-4 leading-7">
      <p>{t(k("costs.intro"))}</p>
      <ul class="list-disc space-y-2 pl-5">
        {costItems.map((item) => <li>{item}</li>)}
      </ul>
      <p>{t(k("costs.outro"))}</p>
    </div>
  </section>

  <section aria-labelledby="mortgage-transfer-example">
    <h2 id="mortgage-transfer-example" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("example.title"))}
    </h2>
    <div class="mt-3 space-y-4 leading-7">
      <p>{t(k("example.setup"), values)}</p>
      <p>{t(k("example.costs"), values)}</p>
      <p>{t(k("example.total"), values)}</p>
      <p>{t(k("example.longer"), values)}</p>
    </div>
  </section>

  <section aria-labelledby="mortgage-transfer-method">
    <h2 id="mortgage-transfer-method" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("method.title"))}
    </h2>
    <div class="mt-3 space-y-4 leading-7">
      <p>{t(k("method.intro"))}</p>
      <p class="rounded-lg bg-paper-2 px-4 py-3 font-mono text-foreground">
        M = P × r ÷ (1 − (1 + r)<sup>−n</sup>)
      </p>
      <p>{t(k("method.legend"))}</p>
      <p>{t(k("method.saving"))}</p>
      <p>{t(k("method.breakEven"))}</p>
      <p>{t(k("method.longerTerm"))}</p>
    </div>
    <h3 class="mt-8 font-semibold text-foreground">{t(k("method.assumptionsTitle"))}</h3>
    <ul class="mt-3 list-disc space-y-2 pl-5 leading-7">
      {assumptions.map((item) => <li>{item}</li>)}
      <li>{t(k("method.limits"), values)}</li>
    </ul>
  </section>

  <section aria-labelledby="mortgage-transfer-related">
    <h2 id="mortgage-transfer-related" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("related.title"))}
    </h2>
    <ul class="mt-3 space-y-3 leading-7">
      {
        related.map((item) => (
          <li>
            <a href={item.href} class={linkClass}>
              {t(k(`related.${item.key}Link`))}
            </a>
            <p>{t(k(`related.${item.key}Body`))}</p>
          </li>
        ))
      }
    </ul>
  </section>
</div>
