---
// Prerendered explanation, worked example and method for the emergency fund calculator, on
// the guide building blocks (guideBlocks.ts). The figures come from the same calculation the
// calculator runs (emergencyFundGuide.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildEmergencyFundGuide } from "./emergencyFundGuide";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.emergencyFund.${key}`;

const guide = buildEmergencyFundGuide(locale);
---

<ToolGuide>
  <section>
    <h2>{t(k("whatTitle"))}</h2>
    <p>{t(k("whatBody1"))}</p>
    <p>{t(k("whatBody2"))}</p>
  </section>

  <section>
    <h2>{t(k("exampleTitle"))}</h2>
    <p>{t(k("exampleIntro"), guide.exampleValues)}</p>
    <GuideFigures items={guide.flow} operators={guide.flowOperators} />
    <p>{t(k("exampleOutro"), guide.exampleValues)}</p>
  </section>

  <section>
    <h2>{t(k("methodTitle"))}</h2>
    <GuideFormula lines={guide.formulas} label={t(k("methodFormulasLabel"))} />
    <GuideTermList items={guide.notes} />
  </section>
</ToolGuide>
