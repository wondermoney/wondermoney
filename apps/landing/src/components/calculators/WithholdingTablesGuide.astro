---
// Prerendered guide for the withholding tables: how to read them, with the withholding as a
// formula on the guide building blocks (salaryGuides.ts), and what they leave out.
import ToolGuide from "./ToolGuide.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildWithholdingTablesGuide } from "./salaryGuides";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.withholdingTables.guide.${key}`;
const guide = buildWithholdingTablesGuide(locale);
const sources = [
  ["sourceMainland", "https://info.portaldasfinancas.gov.pt/pt/informacao_fiscal/legislacao/Despachos_SEAF/Documents/Despacho-SEAF-2026-01-05-XXV.pdf"],
  ["sourceRegional", "https://info.portaldasfinancas.gov.pt/pt/apoio_contribuinte/tabela_ret_doclib/Pages/default.aspx"],
  ["sourceMadeira", "https://info.portaldasfinancas.gov.pt/pt/informacao_fiscal/legislacao/instrucoes_administrativas/Documents/Circular_2_2026.pdf"],
  ["sourceAnnual", "https://info.portaldasfinancas.gov.pt/pt/informacao_fiscal/legislacao/diplomas_legislativos/Documents/decreto-lei-212-2026.pdf"],
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(k("howTitle"))}</h2>
    <p>{t(k("howFormula"))}</p>
    <GuideFormula lines={guide.formulas} label={t(k("methodFormulasLabel"))} />
    <GuideTermList items={guide.notes} />
  </section>
  <section>
    <h2>{t(k("finalTitle"))}</h2>
    <p>{t(k("final"))}</p>
    <h3 class="font-semibold text-foreground">{t(k("unsupportedTitle"))}</h3>
    <ul class="list-disc space-y-2 pl-6">
      {["unsupportedDisability", "unsupportedYouth", "unsupportedNovember", "unsupportedPensions"].map((key) => <li>{t(k(key))}</li>)}
    </ul>
    <h3 class="font-semibold text-foreground">{t(k("sourcesTitle"))}</h3>
    <ul class="list-disc space-y-2 pl-6">
      {sources.map(([key, href]) => (
        <li>
          <a href={href} rel="noopener">{t(k(key))}</a>
        </li>
      ))}
    </ul>
    <p class="text-sm">{t(k("reviewed"))}</p>
  </section>
</ToolGuide>
