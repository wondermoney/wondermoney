---
// Prerendered rules, worked example and method for the savings certificates calculator, on
// the guide building blocks (guideBlocks.ts). The figures come from the same calculation the
// calculator runs (savingsCertificatesGuide.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildSavingsCertificatesGuide } from "./savingsCertificatesGuide";
import { PERMANENCE_PREMIUM_STEPS, SAVINGS_CERTIFICATES_RULES } from "@/lib/calculators/savingsCertificates";
import { formatNumber } from "@/lib/numberFormat";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.savingsCertificates.guide.${key}`;

const guide = buildSavingsCertificatesGuide(locale);
const { values } = guide;

const sheetSource = SAVINGS_CERTIFICATES_RULES.rulesSource;
const igcpSource = SAVINGS_CERTIFICATES_RULES.referenceBaseRate.source;
---
<ToolGuide>
  <section>
    <h2>{t(k("rulesTitle"))}</h2>
    <p>{t(k("rulesIntro"), values)}</p>
    <ul class="list-disc space-y-2 pl-6">
      {["ruleTerm", "ruleRate", "ruleTax", "ruleRedeem"].map((key) => <li>{t(k(key), values)}</li>)}
    </ul>
    <div class="max-w-md overflow-x-auto rounded-card border border-border">
      <table class="w-full text-left text-sm">
        <caption class="border-b border-border bg-paper-2 px-4 py-2.5 text-left font-medium text-foreground">
          {t(k("premiumTitle"))}
        </caption>
        <thead class="text-muted-foreground">
          <tr>
            <th scope="col" class="px-4 py-2 font-medium">{t(k("premiumYears"))}</th>
            <th scope="col" class="px-4 py-2 text-right font-medium">{t(k("premiumPoints"))}</th>
          </tr>
        </thead>
        <tbody class="font-mono text-foreground">
          {PERMANENCE_PREMIUM_STEPS.map((step) => (
            <tr class="border-t border-border">
              <td class="px-4 py-2">{step.from === step.to ? formatNumber(locale, step.from) : `${formatNumber(locale, step.from)}–${formatNumber(locale, step.to)}`}</td>
              <td class="px-4 py-2 text-right">{formatNumber(locale, step.premium, 2)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      <a href={sheetSource} rel="noopener">{t(k("sourceSheet"))}</a>
      {" · "}
      <a href={igcpSource} rel="noopener">{t(k("sourceIgcp"), values)}</a>
    </p>
  </section>

  <section>
    <h2>{t(k("exampleTitle"))}</h2>
    <p>{t(k("exampleText"), values)}</p>
    <GuideFigures items={guide.flow} operators={guide.flowOperators} />
  </section>

  <section>
    <h2>{t(k("methodTitle"))}</h2>
    <GuideFormula lines={guide.formulas} label={t(k("methodFormulasLabel"))} />
    <GuideTermList items={guide.notes} columns={1} />
    <h3 class="font-semibold text-foreground">{t(k("assumptionsTitle"))}</h3>
    <ul class="list-disc space-y-2 pl-6">
      {["assumptionBase", "assumptionRules", "assumptionScope"].map((key) => <li>{t(k(key), values)}</li>)}
    </ul>
  </section>
</ToolGuide>
