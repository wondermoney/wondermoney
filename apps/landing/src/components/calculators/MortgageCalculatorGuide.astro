---
// Prerendered explanation for the mortgage calculator: what the result covers, a worked
// example computed from the same function the calculator runs (mortgageGuide.ts), and the
// method on the guide building blocks.
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildMortgageGuide } from "./mortgageGuide";
import type { Lang } from "@/lib/i18nLocale";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.mortgage.guide.${key}`;
const guide = buildMortgageGuide(locale);
const { values } = guide;

const list = (key: string) => Object.values(t<Record<string, string>>(k(key), { returnObjects: true }));
const included = list("coverage.included");
const excluded = list("coverage.excluded");
---

<ToolGuide>
  <section>
    <h2>{t(k("coverage.title"))}</h2>
    <p>{t(k("coverage.intro"))}</p>
    <div class="grid gap-x-10 gap-y-6 sm:grid-cols-2">
      <div>
        <h3 class="font-semibold text-foreground">{t(k("coverage.includedTitle"))}</h3>
        <ul class="mt-3 list-disc space-y-2 pl-5">
          {included.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <h3 class="font-semibold text-foreground">{t(k("coverage.excludedTitle"))}</h3>
        <ul class="mt-3 list-disc space-y-2 pl-5">
          {excluded.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section>
    <h2>{t(k("example.title"))}</h2>
    <p>{t(k("example.setup"), values)}</p>
    <p>{t(k("example.firstMonth"), values)}</p>
    <GuideFigures variant="grid" items={guide.firstPayment} />
    <p>{t(k("example.total"), values)}</p>
    <GuideFigures items={guide.totals} operators={["+", "="]} />
    <p>{t(k("example.halfway"), values)}</p>
    <p>{t(k("example.fees"), values)}</p>
  </section>

  <section>
    <h2>{t(k("method.title"))}</h2>
    <p>{t(k("method.intro"))}</p>
    <GuideFormula lines={guide.formulas} label={t(k("method.formulasLabel"))} />
    <p>{t(k("method.zeroRate"))}</p>
    <p>{t(k("method.schedule"))}</p>
    <h3 class="font-semibold text-foreground">{t(k("method.assumptionsTitle"))}</h3>
    <GuideTermList items={guide.notes} />
  </section>
</ToolGuide>
