---
// Prerendered explanation, worked example and method for the household budget
// calculator. The figures come from the same calculation the calculator runs.
import {
  HOUSEHOLD_BUDGET_WORKED_EXAMPLE,
  computeHouseholdBudget,
  type BudgetCategory,
} from "@/lib/calculators/householdBudget";
import { formatMoney, formatPercent } from "@/lib/numberFormat";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.householdBudget.guide.${key}`;

const example = HOUSEHOLD_BUDGET_WORKED_EXAMPLE;
const result = computeHouseholdBudget(example);
const money = (value: number) => formatMoney(locale, value);
const percent = (value: number | null) => (value === null ? "" : formatPercent(locale, value));
const incomeOf = (id: string) => example.incomes.find((row) => row.id === id)?.amount ?? 0;
const categoryOf = (category: BudgetCategory) =>
  result.categories.find((entry) => entry.category === category) ?? { total: 0, shareOfIncome: null };

const exampleValues = {
  salary: money(incomeOf("salary")),
  other: money(incomeOf("other")),
  income: money(result.totalIncome),
  expenses: money(result.totalExpenses),
  surplus: money(result.balance),
  savingsRate: percent(result.savingsRate),
  housing: money(categoryOf("housing").total),
  housingShare: percent(categoryOf("housing").shareOfIncome),
  food: money(categoryOf("food").total),
  foodShare: percent(categoryOf("food").shareOfIncome),
  utilities: money(categoryOf("utilities").total),
};

const methodItems = [
  "methodIncome",
  "methodExpenses",
  "methodIrregular",
  "methodShares",
  "methodRounding",
  "methodPrivacy",
];

const nextHref = toLocalizedPath("featureBudgeting", locale);
---

<div class="mx-auto mt-12 max-w-3xl space-y-10 text-base leading-7 text-ink-2">
  <section>
    <h2 class="text-2xl font-semibold tracking-tight text-foreground">{t(k("whatHeading"))}</h2>
    <p class="mt-3">{t(k("whatBody"))}</p>
  </section>

  <section>
    <h2 class="text-2xl font-semibold tracking-tight text-foreground">{t(k("readHeading"))}</h2>
    <ul class="mt-3 list-disc space-y-2 pl-5">
      <li>{t(k("readSurplus"))}</li>
      <li>{t(k("readDeficit"))}</li>
      <li>{t(k("readShares"))}</li>
      <li>{t(k("readDiagram"))}</li>
    </ul>
  </section>

  <section>
    <h2 class="text-2xl font-semibold tracking-tight text-foreground">{t(k("exampleHeading"))}</h2>
    <p class="mt-3">{t(k("exampleBody"), exampleValues)}</p>
    <p class="mt-3 rounded-lg border border-border bg-paper-2 px-4 py-3 font-mono text-sm text-foreground">
      {exampleValues.income} − {exampleValues.expenses} = {exampleValues.surplus}
      <br />
      {exampleValues.surplus} ÷ {exampleValues.income} × 100 = {exampleValues.savingsRate}
    </p>
    <p class="mt-3">{t(k("exampleShares"), exampleValues)}</p>
  </section>

  <section>
    <h2 class="text-2xl font-semibold tracking-tight text-foreground">{t(k("methodHeading"))}</h2>
    <p class="mt-3 rounded-lg border border-border bg-paper-2 px-4 py-3 text-sm text-foreground">
      {t(k("methodFormula"))}
    </p>
    <ul class="mt-4 list-disc space-y-2 pl-5">
      {methodItems.map((item) => <li>{t(k(item))}</li>)}
    </ul>
  </section>

  <section>
    <h2 class="text-2xl font-semibold tracking-tight text-foreground">{t(k("nextHeading"))}</h2>
    <p class="mt-3">
      {t(k("nextBody"))}{" "}
      <a
        href={nextHref}
        class="font-medium text-primary underline decoration-primary/40 underline-offset-4 hover:opacity-80"
      >
        {t(k("nextLink"))}
      </a>
    </p>
  </section>
</div>
