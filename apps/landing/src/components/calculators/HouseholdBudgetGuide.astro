---
// Prerendered explanation, worked example and method for the household budget
// calculator, on the guide building blocks (guideBlocks.ts). The figures come from the
// same calculation the calculator runs (householdBudgetGuide.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildHouseholdBudgetGuide } from "./householdBudgetGuide";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.householdBudget.guide.${key}`;

const guide = buildHouseholdBudgetGuide(locale);
const nextHref = toLocalizedPath("featureBudgeting", locale);
---

<ToolGuide>
  <section>
    <h2>{t(k("whatHeading"))}</h2>
    <p>{t(k("whatBody"))}</p>
  </section>

  <section>
    <h2>{t(k("readHeading"))}</h2>
    <GuideTermList items={guide.readTerms} />
  </section>

  <section>
    <h2>{t(k("exampleHeading"))}</h2>
    <p>{t(k("exampleBody"), guide.exampleValues)}</p>
    <GuideFigures items={guide.flow} operators={guide.flowOperators} caption={t(k("exampleFlowCaption"))} />
    <p>{t(k("exampleShares"), guide.exampleValues)}</p>
    <GuideFigures variant="grid" items={guide.shares} caption={t(k("exampleSharesCaption"))} />
  </section>

  <section>
    <h2>{t(k("methodHeading"))}</h2>
    <GuideFormula lines={guide.formulas} label={t(k("methodFormulasLabel"))} />
    <GuideTermList items={guide.notes} />
  </section>

  <section>
    <h2>{t(k("nextHeading"))}</h2>
    <p>
      {t(k("nextBody"))}{" "}
      <a href={nextHref}>{t(k("nextLink"))}</a>
    </p>
  </section>
</ToolGuide>
