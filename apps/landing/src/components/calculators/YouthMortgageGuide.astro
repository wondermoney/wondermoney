---
// Prerendered worked example, method and the State guarantee's conditions for the youth
// mortgage calculator, on the guide building blocks. The figures come from the same function
// the calculator runs (youthMortgageGuide.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildYouthMortgageGuide } from "./youthMortgageGuide";
import { YOUTH_GUARANTEE } from "@/lib/calculators/youthMortgage";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.youthMortgage.guide.${key}`;
const guide = buildYouthMortgageGuide(locale);
const { values } = guide;
---

<ToolGuide>
  <p role="note" class="rounded-card border border-warning-text/30 bg-warning/10 px-4 py-3 text-base text-foreground">
    {t("tools.youthMortgage.deadlineNotice")}
  </p>
  <section>
    <h2>{t(k("exampleTitle"))}</h2>
    <p>{t(k("example"), values)}</p>
    <GuideFigures variant="grid" items={guide.loan} />
    <GuideFigures variant="grid" items={guide.taxes} />
  </section>

  <section>
    <h2>{t(k("methodTitle"))}</h2>
    <GuideFormula lines={guide.formulas} label={t(k("formulasLabel"))} />
    <GuideTermList items={guide.notes} />
    <h3 class="font-semibold text-foreground">{t(k("conditionsTitle"))}</h3>
    <GuideTermList items={guide.conditions} />
    <p>
      <a href={YOUTH_GUARANTEE.sources.government}>{t(k("sourceGovernment"))}</a>
      {" · "}
      <a href={YOUTH_GUARANTEE.sources.literacia}>{t(k("sourceLiteracia"))}</a>
      {" · "}
      <a href={YOUTH_GUARANTEE.sources.portaria} rel="noopener">{t(k("sourcePortaria"))}</a>
    </p>
    <p class="text-sm">{t(k("review"), values)}</p>
    <h3 class="font-semibold text-foreground">{t(k("assumptionsTitle"))}</h3>
    <GuideTermList items={guide.assumptions} />
  </section>
</ToolGuide>
