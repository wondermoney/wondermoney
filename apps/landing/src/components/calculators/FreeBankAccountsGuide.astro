---
// Prerendered explanation for the free bank accounts list: how to read it, how it was put
// together, what it leaves out and the tools to go on with. The list itself is the island.
import ToolGuide from "./ToolGuide.astro";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.freeBankAccounts.guide.${key}`;
const list = (key: string) =>
  Object.values(t<Record<string, string>>(k(key), { returnObjects: true }));
const steps = list("method.steps");
const limits = list("limits.items");

const related = [
  { key: "remunerated", href: toLocalizedPath("toolRemuneratedAccounts", locale) },
  { key: "budget", href: toLocalizedPath("toolHouseholdBudget", locale) },
] as const;

const linkClass =
  "font-medium text-primary underline decoration-primary/40 underline-offset-4 hover:opacity-80";
---

<ToolGuide>
  <section aria-labelledby="free-read">
    <h2 id="free-read" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("read.title"))}
    </h2>
    <div class="mt-3 space-y-4 leading-7">
      <p>{t(k("read.what"))}</p>
      <p>{t(k("read.notRec"))}</p>
    </div>
  </section>

  <section aria-labelledby="free-method">
    <h2 id="free-method" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("method.title"))}
    </h2>
    <div class="mt-3 space-y-4 leading-7">
      <p>{t(k("method.intro"))}</p>
      <ol class="list-decimal space-y-2 pl-5">
        {steps.map((item) => <li>{item}</li>)}
      </ol>
    </div>
  </section>

  <section aria-labelledby="free-limits">
    <h2 id="free-limits" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("limits.title"))}
    </h2>
    <ul class="mt-3 list-disc space-y-2 pl-5 leading-7">
      {limits.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section aria-labelledby="free-related">
    <h2 id="free-related" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("related.title"))}
    </h2>
    <ul class="mt-3 space-y-3 leading-7">
      {
        related.map((item) => (
          <li>
            <a href={item.href} class={linkClass}>
              {t(k(`related.${item.key}Link`))}
            </a>
            <p>{t(k(`related.${item.key}Body`))}</p>
          </li>
        ))
      }
    </ul>
  </section>
</ToolGuide>
