---
// Prerendered worked example and method for the Christmas and holiday allowance calculators,
// on the guide building blocks (guideBlocks.ts). The figures come from the calculator's own
// function (salaryGuides.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildAllowanceGuide } from "./salaryGuides";
import type { AllowanceKind } from "@/lib/calculators/allowance";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
  kind: AllowanceKind;
}

const { locale, kind } = Astro.props;
const t = getTranslations(locale);
const page = (key: string) => `tools.${kind}Allowance.guide.${key}`;
const shared = (key: string) => `tools.allowance.guide.${key}`;
const net = (key: string) => `tools.netSalary.guide.${key}`;
const guide = buildAllowanceGuide(locale, kind);
const sources = [
  [net("sourceDespacho"), "https://info.portaldasfinancas.gov.pt/pt/informacao_fiscal/legislacao/Despachos_SEAF/Documents/Despacho-SEAF-2026-01-05-XXV.pdf"],
  [net("sourceRegional"), "https://info.portaldasfinancas.gov.pt/pt/apoio_contribuinte/tabela_ret_doclib/Pages/default.aspx"],
  [shared("sourceCode"), "https://diariodarepublica.pt/dr/legislacao-consolidada/lei/2009-34546475"],
  [net("sourceSocialSecurity"), "https://www.seg-social.pt/"],
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(net("exampleTitle"))}</h2>
    <p>{t(page("example"), guide.values)}</p>
    <GuideFigures items={guide.flow} operators={guide.flowOperators} />
  </section>
  <section>
    <h2>{t(net("methodTitle"))}</h2>
    <GuideTermList items={guide.notes} />
    <h3 class="font-semibold text-foreground">{t(net("finalTitle"))}</h3>
    <p>{t(net("final"))}</p>
    <h3 class="font-semibold text-foreground">{t(net("unsupportedTitle"))}</h3>
    <ul class="list-disc space-y-2 pl-6">
      <li>{t(net("unsupportedYouth"))}</li>
      <li>{t(net("unsupportedDisability"))}</li>
      <li>{t(shared("unsupportedNovember"))}</li>
      <li>{t(shared("unsupportedOther"))}</li>
    </ul>
    <h3 class="font-semibold text-foreground">{t(net("sourcesTitle"))}</h3>
    <ul class="list-disc space-y-2 pl-6">
      {sources.map(([label, href]) => (
        <li><a href={href} rel="noopener">{t(label)}</a></li>
      ))}
    </ul>
    <p class="text-sm">{t(shared("reviewed"))}</p>
  </section>
</ToolGuide>
