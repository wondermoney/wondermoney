---
import { CAR_LOAN_EXAMPLE, computeCarLoan } from "@/lib/calculators/carLoan";
import { formatMoney, formatNumber, formatPercent } from "@/lib/numberFormat";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.carLoan.guide.${key}`;
const example = computeCarLoan(CAR_LOAN_EXAMPLE);
if (!example.ok) throw new Error("Invalid car loan worked example");

const { price, deposit, termMonths, annualRate, upfrontFees, monthlyFees,
  monthlyFuel, annualInsurance, annualTax, annualMaintenance } = CAR_LOAN_EXAMPLE;
const { financedAmount, monthlyPayment, monthlyRunning, monthlyBudget } = example.result;
const money = (value: number, decimals = 0) => formatMoney(locale, value, { decimals });
const values = {
  price: money(price),
  deposit: money(deposit),
  financedAmount: money(financedAmount),
  months: formatNumber(locale, termMonths),
  rate: formatPercent(locale, annualRate, { decimals: 0 }),
  upfrontFees: money(upfrontFees),
  monthlyFees: money(monthlyFees),
  monthlyFuel: money(monthlyFuel),
  annualInsurance: money(annualInsurance),
  annualTax: money(annualTax),
  annualMaintenance: money(annualMaintenance),
  payment: money(monthlyPayment, 2),
  running: money(monthlyRunning, 2),
  budget: money(monthlyBudget, 2),
};
const creditSource = `https://europa.eu/youreurope/citizens/consumers/financial-products-and-services/consumer-credits-and-loans/index_${locale}.htm`;
---

<div class="mt-12 max-w-3xl space-y-10 text-base leading-7 text-ink-2">
  <section aria-labelledby="car-loan-example">
    <h2 id="car-loan-example" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("exampleTitle"))}
    </h2>
    <p class="mt-4">{t(k("exampleLoan"), values)}</p>
    <p class="mt-4">{t(k("exampleRunning"), values)}</p>
  </section>
  <section aria-labelledby="car-loan-method">
    <h2 id="car-loan-method" class="text-2xl font-semibold tracking-tight text-foreground">
      {t(k("methodTitle"))}
    </h2>
    <ul class="mt-4 list-disc space-y-2 pl-6">
      {["methodLoan", "methodBudget", "methodApr"].map((key) => <li>{t(k(key))}</li>)}
    </ul>
    <p class="mt-4">
      <a href={creditSource} class="font-medium text-primary underline decoration-primary/40 underline-offset-4 hover:opacity-80">
        {t(k("source"))}
      </a>
    </p>
    <h3 class="mt-8 font-semibold text-foreground">{t(k("assumptionsTitle"))}</h3>
    <ul class="mt-3 list-disc space-y-2 pl-6">
      {["assumptionLoan", "assumptionFees", "assumptionRunning"].map((key) => <li>{t(k(key))}</li>)}
    </ul>
  </section>
</div>
