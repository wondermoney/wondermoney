---
// Prerendered worked example and method for the car loan calculator, on the guide building
// blocks. The figures come from the same function the calculator runs (carLoanGuide.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildCarLoanGuide } from "./carLoanGuide";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.carLoan.guide.${key}`;
const guide = buildCarLoanGuide(locale);
const { values } = guide;
const creditSource = `https://europa.eu/youreurope/citizens/consumers/financial-products-and-services/consumer-credits-and-loans/index_${locale}.htm`;
---

<ToolGuide>
  <section>
    <h2>{t(k("exampleTitle"))}</h2>
    <p>{t(k("exampleLoan"), values)}</p>
    <GuideFigures items={guide.financing} operators={["−", "="]} />
    <p>{t(k("exampleRunning"), values)}</p>
    <GuideFigures items={guide.budget} operators={["+", "="]} />
  </section>

  <section>
    <h2>{t(k("methodTitle"))}</h2>
    <GuideFormula lines={guide.formulas} label={t(k("formulasLabel"))} />
    <GuideTermList items={guide.notes} />
    <p>
      <a href={creditSource}>{t(k("source"))}</a>
    </p>
    <h3 class="font-semibold text-foreground">{t(k("assumptionsTitle"))}</h3>
    <GuideTermList items={guide.assumptions} />
  </section>
</ToolGuide>
