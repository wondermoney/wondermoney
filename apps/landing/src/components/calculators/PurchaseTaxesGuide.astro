---
// Prerendered worked example, method and IMT table for the purchase taxes calculator, on the
// guide building blocks. The figures, rates and table come from the calculator's own module
// (purchaseTaxesGuide.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { PURCHASE_TAXES_GUIDE_IDS, buildPurchaseTaxesGuide } from "./purchaseTaxesGuide";
import { PURCHASE_TAXES_TABLE } from "@/lib/calculators/purchaseTaxes";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.purchaseTaxes.guide.${key}`;
const guide = buildPurchaseTaxesGuide(locale);
const { values } = guide;
const cell = "px-3 py-2.5 text-right font-mono whitespace-nowrap text-foreground";
---

<ToolGuide>
  <section>
    <h2>{t(k("exampleTitle"))}</h2>
    <p>{t(k("example"), values)}</p>
    <GuideFigures variant="grid" items={guide.taxes} />
  </section>

  <section>
    <h2>{t(k("methodTitle"))}</h2>
    <GuideFormula lines={guide.formulas} label={t(k("formulasLabel"))} />
    <GuideTermList items={guide.notes} />
    <h3 id={PURCHASE_TAXES_GUIDE_IDS.table} class="scroll-mt-24 font-semibold text-foreground">
      {t(k("tableTitle"), values)}
    </h3>
    <div class="overflow-x-auto rounded-card border border-border">
      <table class="w-full text-sm">
        <thead class="bg-paper-2 text-muted-foreground">
          <tr>
            <th scope="col" class="px-3 py-2.5 text-right font-medium">{t(k("tableLimit"))}</th>
            <th scope="col" class="px-3 py-2.5 text-right font-medium">{t(k("tableRate"))}</th>
            <th scope="col" class="px-3 py-2.5 text-right font-medium">{t(k("tableDeduct"))}</th>
          </tr>
        </thead>
        <tbody>
          {
            guide.rows.map((row) => (
              <tr class="border-t border-border">
                <td class={/\d/.test(row.limit) ? cell : "px-3 py-2.5 text-right text-foreground"}>{row.limit}</td>
                <td class={cell}>{row.rate}</td>
                <td class={cell}>{row.deduct}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p>{t(k("tableNote"), values)}</p>
    <p>
      <a href={PURCHASE_TAXES_TABLE.sources.cimt}>{t(k("sourceImt"))}</a>
      {" · "}
      <a href={PURCHASE_TAXES_TABLE.sources.circular}>{t(k("sourceCircular"))}</a>
      {" · "}
      <a href={PURCHASE_TAXES_TABLE.sources.stampDuty}>{t(k("sourceStamp"))}</a>
    </p>
    <p class="text-sm">{t(k("review"), values)}</p>
    <h3 class="font-semibold text-foreground">{t(k("assumptionsTitle"))}</h3>
    <GuideTermList items={guide.assumptions} />
  </section>
</ToolGuide>
