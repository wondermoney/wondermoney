---
// Prerendered worked example, method, limits and sources for the state pension calculator,
// on the guide building blocks (guideBlocks.ts). The figures come from the same calculation
// the calculator runs (statePensionGuide.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildStatePensionGuide } from "./statePensionGuide";
import { STATE_PENSION_SOURCES } from "@/lib/calculators/statePension";
import type { Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.statePension.guide.${key}`;

const guide = buildStatePensionGuide(locale);

const sources = [
  ["sourceGuide", STATE_PENSION_SOURCES.guide],
  ["sourceLaw", STATE_PENSION_SOURCES.law],
  ["sourceAges", STATE_PENSION_SOURCES.ages],
  ["sourceMinimum", STATE_PENSION_SOURCES.minimum],
  ["sourceWithholding", STATE_PENSION_SOURCES.withholding],
  ["sourceSimulator", STATE_PENSION_SOURCES.simulator],
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(k("exampleTitle"))}</h2>
    <p>{t(k("example"), guide.values)}</p>
    <GuideFigures items={guide.pensionFlow} operators={guide.pensionOperators} />
    <GuideFigures items={guide.gapFlow} operators={guide.gapOperators} />
  </section>

  <section>
    <h2>{t(k("methodTitle"))}</h2>
    <GuideFormula lines={guide.formulas} label={t(k("methodFormulasLabel"))} />
    <GuideTermList items={guide.notes} />
  </section>

  <section>
    <h2>{t(k("unsupportedTitle"))}</h2>
    <ul class="list-disc space-y-2 pl-6">
      {["unsupportedMixed", "unsupportedSpecial", "unsupportedCga", "unsupportedOther"].map((key) => <li>{t(k(key))}</li>)}
    </ul>
  </section>

  <section>
    <h2>{t(k("sourcesTitle"))}</h2>
    <ul class="list-disc space-y-2 pl-6">
      {sources.map(([key, href]) => (
        <li>
          <a href={href} rel="noopener">{t(k(key))}</a>
        </li>
      ))}
    </ul>
    <p class="text-base text-muted-foreground">{t(k("reviewed"))}</p>
  </section>
</ToolGuide>
