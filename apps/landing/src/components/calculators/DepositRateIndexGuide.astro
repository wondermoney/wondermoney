---
// Prerendered explanation for the deposit-rate index: what the figure is and is not, a worked
// example computed from the same function the calculator runs (depositRateIndexGuide.ts), the
// method, the data sources with their dates, what the figures leave out, and the tools to go on
// with, on the guide building blocks (guideBlocks.ts).
import ToolGuide from "./ToolGuide.astro";
import GuideFigures from "./GuideFigures.astro";
import GuideFormula from "./GuideFormula.astro";
import GuideTermList from "./GuideTermList.astro";
import { buildDepositRateIndexGuide } from "./depositRateIndexGuide";
import { DEPOSIT_RATES_SOURCE } from "@/lib/calculators/depositRates";
import { CPI_SOURCE } from "@/lib/calculators/portugalCpi";
import { toLocalizedPath, type Lang } from "@/lib/routes";
import { getTranslations } from "@/lib/translations";

interface Props {
  locale: Lang;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const k = (key: string) => `tools.depositRateIndex.guide.${key}`;

const guide = buildDepositRateIndexGuide(locale);
const { values } = guide;

const limits = Object.values(t<Record<string, string>>(k("limits.items"), { returnObjects: true }));

const related = [
  { key: "termDeposit", href: toLocalizedPath("toolTermDeposit", locale) },
  { key: "savingsCertificates", href: toLocalizedPath("toolSavingsCertificates", locale) },
  { key: "inflation", href: toLocalizedPath("toolInflation", locale) },
] as const;
---

<ToolGuide>
  <section>
    <h2>{t(k("read.title"))}</h2>
    <p>{t(k("read.what"))}</p>
    <p>{t(k("read.notBest"))}</p>
    <p>{t(k("read.noRecommendation"))}</p>
  </section>

  <section>
    <h2>{t(k("example.title"))}</h2>
    <p>{t(k("example.setup"), values)}</p>
    <GuideFigures items={guide.taxFlow} operators={guide.flowOperators} />
    <p>{t(k("example.real"), values)}</p>
    <GuideFigures items={guide.realFlow} operators={guide.flowOperators} />
    <p>{t(k("example.year"), values)}</p>
  </section>

  <section>
    <h2>{t(k("method.title"))}</h2>
    <p>{t(k("method.intro"))}</p>
    <GuideFormula lines={guide.formulas} label={t(k("method.formulasLabel"))} />
    <GuideTermList items={guide.steps} />
    <p>{t(k("method.realRate"))}</p>
  </section>

  <section>
    <h2>{t(k("data.title"))}</h2>
    <p>{t(k("data.source"), values)}</p>
    <p>
      <a href={DEPOSIT_RATES_SOURCE.url} rel="noopener" target="_blank">{t(k("data.ecbLink"))}</a>
      {" · "}
      <a href="https://bpstat.bportugal.pt/" rel="noopener" target="_blank">{t(k("data.bpstatLink"))}</a>
      {" · "}
      <a href={CPI_SOURCE.url} rel="noopener" target="_blank">{t(k("data.cpiLink"))}</a>
    </p>
    <p>{t(k("data.inflation"), values)}</p>
    <p>{t(k("data.reuse"))}</p>
  </section>

  <section>
    <h2>{t(k("limits.title"))}</h2>
    <ul class="list-disc space-y-2 pl-6">
      {limits.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section>
    <h2>{t(k("related.title"))}</h2>
    <ul class="space-y-3">
      {
        related.map((item) => (
          <li>
            <a href={item.href}>{t(k(`related.${item.key}Link`))}</a>
            <p>{t(k(`related.${item.key}Body`))}</p>
          </li>
        ))
      }
    </ul>
  </section>
</ToolGuide>
