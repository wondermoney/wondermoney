{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["@sanity/astro/module"],
    "exclude": [
      "node_modules",
      "dist"
    ]
  }
}