{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "pnpm": "12.6.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.wonder.money",
        "EXPO_PUBLIC_POSTHOG_KEY": "phc_KlDfjBgreGCfTKJnwwP5W9I2PEGJsboIKFoedyTHGg4"
      }
    },
    "screenshots": {
      "extends": "base",
      "distribution": "internal",
      "environment": "production",
      "channel": "production",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "production",
        "releaseStatus": "inProgress",
        "rollout": 0.2
      }
    },
    "internal": {
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
