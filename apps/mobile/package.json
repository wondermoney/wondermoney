  "expo": {
    "install": {
      "//": "@sentry/react-native stays ahead of SDK 58's ~8.28.0: 8.33.0 is its first release that supports Expo Router 58 (getsentry/sentry-react-native#6923). Older ones require expo-router/build/global-state/router-store, which Expo Router 58 removed, so Metro warns on every bundle. Drop this exclude once Expo expects 8.33 or later.",
      "exclude": [
        "@sentry/react-native"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-google-signin",
          "@wondermoney/shared"
        ]
      }
    }
  }
